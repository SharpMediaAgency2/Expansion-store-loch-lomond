}
.variant-picker__option-button.variant-picker__option-button--button {
  font-size: 14px;
  font-weight: 500;
}
.variant_picker:has(modal-opener) {
    display: flex;
}
.open-size-chart.no-js-hidden button span {
  display: flex;
  gap: 5px;
}
.open-size-chart.no-js-hidden button.btn--link{
    font-family: Rubik;
font-weight: 500;
font-size: 14px;
letter-spacing: -0.15px;
color: #4A5565;
}

.open-size-chart.no-js-hidden button.btn--link::after{
