@media screen and (max-width: 749px) {
  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color):has(> .f-product-single__block--custom_liquid) {
    display: flex;
    flex-direction: column;
  }

  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--custom_liquid {
    order: 1;
  }

  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--variant-picker-color {
    order: 2;
  }

  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--variant-picker-size,
  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--quantity_selector,
  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--buy_buttons,
  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--text,
  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--complementary,
  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--collapsible_tab {
    order: 3;
  }

  product-info .club-selects-row {
    margin-bottom: 10px;
  }

  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--variant-picker-color {
    margin-top: 0;
    margin-bottom: 1.1rem;
  }

  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--variant-picker-size {
    margin-top: 0.25rem;
    margin-bottom: 1.1rem;
  }

  .f-product-single__blocks:has(> .f-product-single__block--variant-picker-color) > .f-product-single__block--quantity_selector {
    margin-top: 0.35rem;
  }
}

