}
}
.select-trigger {
  font-weight: 300!important;
}

.form__label span, #custom-course-select label, #custom-embroidered-select label, .form-label.font-body-bolder.quantity__label {
  font-size: 14px;
  font-weight: 500 !important;
}
.form-label.font-body-bolder.quantity__label{
