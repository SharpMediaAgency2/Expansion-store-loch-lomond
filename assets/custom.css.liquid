}
.variant-picker__option[data-tippy-theme=color-] input+label {
    transition:all 0.3s;
}
.variant-picker__option[data-tippy-theme=color-] input:checked+label {
    border: 1.5px solid black !important;
    transform: scale(1.1);
    overflow: visible;
    transition:all 0.3s;
}
@media screen and (max-width:999px){
  .variant-picker__option, .variant-picker__option-button.variant-picker__option-button--button{
    border-radius:10px!important;
  }
  .variant-picker__option-button{
    padding:0.55rem 0.9erm!important
  }
grid-list#wishlist-products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}
.product-card__atc-text{display:none;}
.wishlist-page.color-accent > .container {
    padding-left: 0px !important;
    padding-right: 0px;
}

.product-card__actions {
    align-items: flex-end!important;
}
}
@media screen and (max-width:767px){
  .variant_picker:has(modal-opener){
    display:block!important;
  }
.variant-picker__field[data-option-name="Size"] .variant-picker__option {
  flex: 1;
}
}
html {
  scroll-behavior: smooth;
}
.pdp-atc-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pdp-atc-row .f-product-form__submit {
  flex: 1;
}

.pdp-wishlist-btn--atc {
  flex-shrink: 0;
  width: 52px;
  height: 58px;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  cursor: pointer;
  transition: border-color 0.2s;
}

.pdp-wishlist-btn--atc:hover {
  border-color: #c58a30;
}

.pdp-wishlist-btn--atc.active {
  border-color: #c58a30;
  background: #fdf8f0;
}
.product-card h3.product-card__title.text-product-title.font-heading {
    font-size: clamp(16px, 2vw, 18px);
    font-family: 'Rubik' !important;
    font-weight: 500;
    color: #0A0A0A !important;
}
.product-card .product-card__information, .product-card .product-card__vendor{
  margin-bottom:0.2rem!important;
}
.product-card span.product-card__vendor {
    font-family: Rubik;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.15px;
}
.product-card .f-price.f-price--left {
    font-family: Rubik;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.31px;
}
.product-card .color-swatch{
  margin-top:0px;
  padding-left:0.75rem;
}
product-recommendations .flickity-wrapper .flickity-button{
  width:46px;
  height:46px;
}
product-recommendations ol.flickity-page-dots{display:none!important;}

.product-card button.add-to-wishlist {
  z-index:99;
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 5px;
  background: #FFFC;
  border-radius: 50%;
}

.product-labels {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  position: absolute;
  z-index: 9;
  bottom: 10px;
  left: 10px;
}
.product-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background:#0a0a0a;
  border-radius: 4px;
  padding: 4px 8px;
  font-family: 'Rubik', sans-serif;
  font-weight: 500;
  font-size: 12px;
  line-height: 150%;
  letter-spacing: 0%;
  text-align: center;
  color: #ffffff;
  box-sizing: border-box;
}

{% assign label_1_text = settings.pcard_label_1_text %}
{% assign label_2_text = settings.pcard_label_2_text %}
{% assign label_3_text = settings.pcard_label_3_text %}

{% if label_1_text != blank %}
.product-label--{{ label_1_text | handleize }}{background-color:{{ settings.pcard_label_1_bg }}!important;color:{{ settings.pcard_label_1_color }}!important;}
{% endif %}

{% if label_2_text != blank %}
.product-label--{{ label_2_text | handleize }}{background-color:{{ settings.pcard_label_2_bg }}!important;color:{{ settings.pcard_label_2_color }}!important;}
{% endif %}

{% if label_3_text != blank %}
.product-label--{{ label_3_text | handleize }}{background-color:{{ settings.pcard_label_3_bg }}!important;color:{{ settings.pcard_label_3_color }}!important;}
{% endif %}

@media screen and (max-width: 999px) {
  #wl-qv-modal [id^="GalleryViewer-"]:has(.flickity-disabled), product-info  [id^="GalleryViewer-"]:has(.flickity-disabled) {
    max-width: 100% !important;
  }

  #wl-qv-modal [id^="GalleryViewer-"]:has(.flickity-disabled) .f-product__media, product-info [id^="GalleryViewer-"]:has(.flickity-disabled) .f-product__media {
    max-width: 100% !important;
  }

  #wl-qv-modal .flickity-disabled [data-media-viewer], product-info  .flickity-disabled [data-media-viewer] {
    margin: 0;
  }
  .template-product .site-main > .f-section:first-child {
    margin-top: 1rem!important;
  }
  .header.site-header.site-header--design-4 {
    height: unset !important;
    min-height: unset;
    padding-bottom: 0px;
  }
  .f-product__media-list.flickity-button-initialized.flickity-nav-inner.h-full.overflow-hidden.f-product__media-list--carousel.flickity-controls-group-mb.flickity-controls-group-mb__bottom.flickity-static.flickity-wrapper.flickity-adaptive-height.flickity-enabled.is-draggable.f-flickity-loaded {
  z-index: 6 !important;
}
#wl-qv-body .f-product-single__info-quantity {
  padding-top: 25px;
}
.desktop-only .shopify-block.shopify-app-block, .desktop-only .f-product__vendor, .desktop-only .title, .desktop-only .desktop-only div:has(.shopify-app-block), .desktop-only .price {
  display: none !important;
}
}

