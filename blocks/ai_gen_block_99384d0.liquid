{% doc %}
  @prompt
    I need a table to show columns and rows 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-table-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow-x: auto;
    display: block;
  }

  .ai-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-weight: {{ block.settings.header_font_weight }};
    text-align: {{ block.settings.header_alignment }};
    padding: {{ block.settings.cell_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-table-{{ ai_gen_id }} td {
    color: {{ block.settings.cell_text_color }};
    text-align: {{ block.settings.cell_alignment }};
    padding: {{ block.settings.cell_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-table-{{ ai_gen_id }} tbody tr:nth-child(even) {
    {% if block.settings.enable_striped_rows %}
      background-color: {{ block.settings.stripe_background }};
    {% endif %}
  }

  .ai-table-{{ ai_gen_id }} tbody tr:hover {
    {% if block.settings.enable_row_hover %}
      background-color: {{ block.settings.hover_background }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-table-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
    }

    .ai-table-{{ ai_gen_id }} th,
    .ai-table-{{ ai_gen_id }} td {
      padding: {{ block.settings.mobile_cell_padding }}px;
    }
  }
{% endstyle %}

<div class="ai-table-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <table class="ai-table-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <thead>
        <tr>
          {% if block.settings.header_col_1 != blank %}
            <th>{{ block.settings.header_col_1 }}</th>
          {% endif %}
          {% if block.settings.header_col_2 != blank %}
            <th>{{ block.settings.header_col_2 }}</th>
          {% endif %}
          {% if block.settings.header_col_3 != blank %}
            <th>{{ block.settings.header_col_3 }}</th>
          {% endif %}
          {% if block.settings.header_col_4 != blank %}
            <th>{{ block.settings.header_col_4 }}</th>
          {% endif %}
          {% if block.settings.header_col_5 != blank %}
            <th>{{ block.settings.header_col_5 }}</th>
          {% endif %}
        </tr>
      </thead>
    {% endif %}
    <tbody>
      {% for i in (1..10) %}
        {% assign row_enabled_key = 'row_' | append: i | append: '_enabled' %}
        {% assign row_enabled = block.settings[row_enabled_key] %}
        
        {% if row_enabled %}
          <tr>
            {% for j in (1..5) %}
              {% assign cell_key = 'row_' | append: i | append: '_col_' | append: j %}
              {% assign cell_value = block.settings[cell_key] %}
              {% if cell_value != blank %}
                <td>{{ cell_value }}</td>
              {% endif %}
            {% endfor %}
          </tr>
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>

