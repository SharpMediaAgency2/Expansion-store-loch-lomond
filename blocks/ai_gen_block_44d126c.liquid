{% doc %}
  @prompt
    A place to put terms and conditions
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-terms-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-terms-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-terms-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 600;
  }

  .ai-terms-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    opacity: 0.8;
  }

  .ai-terms-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-terms-content-{{ ai_gen_id }} h1,
  .ai-terms-content-{{ ai_gen_id }} h2,
  .ai-terms-content-{{ ai_gen_id }} h3,
  .ai-terms-content-{{ ai_gen_id }} h4,
  .ai-terms-content-{{ ai_gen_id }} h5,
  .ai-terms-content-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    margin-top: {{ block.settings.section_spacing }}px;
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
  }

  .ai-terms-content-{{ ai_gen_id }} p {
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
  }

  .ai-terms-content-{{ ai_gen_id }} ul,
  .ai-terms-content-{{ ai_gen_id }} ol {
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
    padding-left: 24px;
  }

  .ai-terms-content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-terms-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-terms-content-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  .ai-terms-content-{{ ai_gen_id }} strong,
  .ai-terms-content-{{ ai_gen_id }} b {
    font-weight: 600;
  }

  .ai-terms-divider-{{ ai_gen_id }} {
    border: none;
    border-top: 1px solid {{ block.settings.divider_color }};
    margin: {{ block.settings.section_spacing }}px 0;
  }

  @media screen and (max-width: 749px) {
    .ai-terms-container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-terms-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-terms-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-terms-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-terms-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_header %}
    <div class="ai-terms-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h1 class="ai-terms-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
      {% endif %}
      
      {% if block.settings.subtitle != blank %}
        <div class="ai-terms-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}
      
      {% if block.settings.last_updated != blank %}
        <div class="ai-terms-subtitle-{{ ai_gen_id }}" style="margin-top: 8px;">
          Last updated: {{ block.settings.last_updated }}
        </div>
      {% endif %}
    </div>
    
    {% if block.settings.show_divider %}
      <hr class="ai-terms-divider-{{ ai_gen_id }}">
    {% endif %}
  {% endif %}

  <div class="ai-terms-content-{{ ai_gen_id }}">
    {% if block.settings.content != blank %}
      {{ block.settings.content }}
    {% else %}
      <p style="text-align: center; opacity: 0.6; font-style: italic;">
        Add your terms and conditions content in the block settings
      </p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Terms and conditions",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Terms and Conditions"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated date"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Terms content"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Title spacing",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Section spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Paragraph spacing",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#222f1d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#262626"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#c58a30"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#e0e0e0"
    }
  ],
  "presets": [
    {
      "name": "Terms and conditions"
    }
  ]
}
{% endschema %}
