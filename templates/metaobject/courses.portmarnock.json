4,"custom_id":"","custom_class":"","animations":"inherit"}},"hero_text_Lckt4y":{"type":"hero-text","blocks":{"title_tXkTJN":{"type":"title","settings":{"title":"Portmarnock Golf Club","highlight_style":"none","enable_highlight_text_color":false,"heading_tag":"h4","heading_size":"h2","heading_color":"#ffffff"}},"text_3WJ4hY":{"type":"text","settings":{"text":"<p>Nestled on a scenic curve of coastline just 10 miles north of Dublin City and 15 minutes from the airport, Portmarnock Golf Club lies on a narrow stretch of classic duneland.<\/p><p>Recognized as one of the most respected venues in world golf, it has hosted some of the sport’s most iconic moments. Arnold Palmer and Sam Snead triumphed here in the 1960 Canada Cup, while Phil Mickelson and David Duval helped secure a memorable Walker Cup win in 1991. With 19 Irish Open Championships and a challenging 27-hole links, we look forward to welcoming you to our top-ranked Championship course.<\/p>"}}},"block_order":["title_tXkTJN","text_3WJ4hY"],"name":"t:sections.hero.presets.name","settings":{"image":"shopify:\/\/shop_images\/f7397fbe6403f4384c9369dbd2f9d410e7a544b1.jpg","image_overlay_opacity":40,"content_in_container":false,"content_position":"center","text_alignment":"center","text_color":"#ffffff","content_position_mobile":"center","short_hero":false,"show_text_below":true,"text_alignment_mobile":"center","custom_id":"","custom_class":"","animations":"inherit","enable_bg_zoom_effect":true}}},"order":["hero_logo_QbbqkH","breadcrumb_trFTCE","featured_collection_3xmrBm","collection_list_M6gYRA","product_tabs_x64WDp","collection_tabs_hftzXg","logo_list_8me8ip","hero_text_Lckt4y"]}