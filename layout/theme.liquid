<script type="text/javascript">
  // Global wishlist state functions
function getWishlist() {
  return JSON.parse(localStorage.getItem('wishlist')) || [];
}

function saveWishlist(wishlist) {
  try {
    localStorage.setItem('wishlist', JSON.stringify(wishlist));
  } catch (e) {
    console.error('Could not save wishlist to localStorage:', e);
  }
}

function updateButtonStyles() {
  const wishlist = getWishlist();
  const wishlistButtons = document.querySelectorAll('.add-to-wishlist');
  const wishlistCounter = document.querySelectorAll('.wishlist-counter');

  wishlistButtons.forEach(button => {
    const productId = button.getAttribute('data-product-id');
    if (wishlist.includes(productId)) {
      button.classList.add('active');
      button.setAttribute('aria-label', 'Remove from wishlist');
    } else {
      button.classList.remove('active');
      button.setAttribute('aria-label', 'Add to wishlist');
    }
  });

  const count = wishlist.length > 0 ? wishlist.length : '0';
  wishlistCounter.forEach(counter => {
    counter.innerHTML = count;
  });
}

function showTooltip(button, message) {
  let tooltip = button.closest('.product-card__information').querySelector('.tooltip-advice');

  if (!tooltip) {
    tooltip = document.createElement('div');
    tooltip.classList.add('tooltip-advice');
    button.closest('.product-card__information').appendChild(tooltip);
  }

  tooltip.innerHTML = `<p>${message}</p>`;
  tooltip.classList.add('active');
  tooltip.setAttribute('aria-live', 'assertive');
  tooltip.setAttribute('role', 'alert');

  setTimeout(() => {
    tooltip.classList.remove('active');
    tooltip.removeAttribute('aria-live');
    tooltip.removeAttribute('role');
  }, 2000);
}

function removeFromWishlist(productId) {
  let wishlist = getWishlist();
  if (wishlist.includes(productId)) {
    wishlist = wishlist.filter(id => id !== productId);
    saveWishlist(wishlist);
    updateButtonStyles();
  }
}

function updateWishlistPage(handle) {
  const wishlistContainer = document.getElementById('wishlist-products');
  if (!wishlistContainer) return;

  fetch(`/products/${handle}.json`)
    .then(response => {
      if (!response.ok) throw new Error('Network response was not ok');
      return response.json();
    })
    .then(data => {
      // ... your existing product HTML building logic
    })
    .catch(error => console.error('Fetch error:', error));
}

// Main function called from button onclick
function addToWishlistByHandle(button) {
  const handle = button.getAttribute('data-product-handle');
  const productId = button.getAttribute('data-product-id');
  const wishlist = getWishlist();

  if (!wishlist.includes(productId)) {
    wishlist.push(productId);
    saveWishlist(wishlist);
    updateButtonStyles();
    showTooltip(button, 'Product has been added to your Wishlist!');
    updateWishlistPage(handle);
  } else {
    removeFromWishlist(productId);
  }
}
</script>

<script>
(function () {
  var VARIANTS = {
    {% for v in product.variants %}
      "{{ v.id }}": { p: {{ v.price | divided_by: 100.0 }}, t: {{ v.title | json }} }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };
  var PRODUCT = {
    id: "{{ product.id }}",
    title: {{ product.title | json }},
    type: {{ product.type | json }},
    vendor: {{ product.vendor | json }}
  };
  var CURRENCY = "{{ cart.currency.iso_code | default: shop.currency }}";

  window.dataLayer = window.dataLayer || [];
  var last = 0, lastKey = '';

  function handle(form) {
    if (!form || !/\/cart\/add/.test(form.getAttribute('action') || '')) return;

    var club = null, fields = {};
    try {
      new FormData(form).forEach(function (v, k) {
        fields[k] = v;
        if (/properties\]?\[Club\]$/.test(k) || k === 'properties[Club]') club = v;
      });
    } catch (e) { return; }
    if (!club) return;

    var vid = fields.id, qty = Number(fields.quantity || 1);
    var key = club + '|' + vid + '|' + qty, now = Date.now();
    if (key === lastKey && now - last < 1500) return;
    lastKey = key; last = now;

    var v = VARIANTS[vid] || {};

    dataLayer.push({ ecommerce: null });
    dataLayer.push({
      event: 'atc_club',
      club: club,
      ecommerce: {
        currency: CURRENCY,
        value: v.p != null ? +(v.p * qty).toFixed(2) : undefined,
        items: [{
          item_id: PRODUCT.id,
          item_variant: String(vid),
          item_name: PRODUCT.title,
          item_category: PRODUCT.type,
          item_brand: PRODUCT.vendor,
          variant_title: v.t,
          price: v.p,
          quantity: qty,
          club: club
        }]
      }
    });
  }

  document.addEventListener('submit', function (e) { handle(e.target); }, true);
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('[type="submit"],[name="add"],.product-form__submit');
    if (b) handle(b.form || b.closest('form'));
  }, true);
})();
</script>
