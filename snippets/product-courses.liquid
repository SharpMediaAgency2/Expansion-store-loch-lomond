<script>
  document.addEventListener('DOMContentLoaded', function () {
    const referrer = document.referrer;
    const select = document.getElementById('course-select');

    if (!referrer || !select) return;

    console.log('Referrer:', referrer);

    const match = referrer.match(/\/pages\/clubs\/([^\/?#]+)/i);
    if (!match || !match[1]) return;

    const slug = match[1];
    const normalize = (str) =>
      str
        .toString()
        .normalize('NFKD') // normalize unicode (e.g., ' → ')
        .replace(/\u00A0/g, ' ') // NBSP → space
        .toLowerCase()
        .replace(/['']s\b/gi, 's') // George's / George's → georges
        .replace(/[''"""'´`]/g, '') // remove remaining quotes/apostrophes
        .replace(/[^a-z0-9]+/g, '-') // non-alphanumerics → dash
        .replace(/^-+|-+$/g, ''); // trim leading/trailing dashes

    const target = normalize(decodeURIComponent(slug));

    for (let option of select.options) {
      const valueNormalized = normalize(option.value);
      const textNormalized = normalize(option.textContent || '');

      console.log('Comparing:', target, 'with', valueNormalized, 'and', textNormalized);

      if (valueNormalized.includes(target) || textNormalized.includes(target)) {
        option.selected = true;
        select.dispatchEvent(new Event('change'));
        console.log('Auto-selected:', option.value);
        break;
      }
    }
  });

  // Dynamic logo position dropdown updater
  (function () {
    'use strict';

    function toHandle(str) {
      return (str ?? '')
        .toString()
        .normalize('NFKD')
        .replace(/\u00A0/g, ' ')
        .toLowerCase()
        .replace(/['']s\b/gi, 's')
        .replace(/[''"""'´`]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    function decodeHtmlEntities(str) {
      const textarea = document.createElement('textarea');
      textarea.innerHTML = str;
      return textarea.value;
    }

    function updateLogoPositions() {
      const courseSelect = document.getElementById('course-select');
      const embroideredSelect = document.getElementById('select-embroidered');

      if (!courseSelect || !embroideredSelect || !window.logoPositionMapping) {
        console.warn('Required elements not found for logo position update');
        return;
      }

      // Get selected club handle
      const selectedOption = courseSelect.options[courseSelect.selectedIndex];
      if (!selectedOption || !selectedOption.value) {
        console.log('No club selected yet');
        return;
      }

      const selectedHandle = toHandle(selectedOption.value);
      console.log('Selected club handle:', selectedHandle);

      // Get positions for this club and decode HTML entities
      const positions = (window.logoPositionMapping[selectedHandle] || []).map((pos) => decodeHtmlEntities(pos));
      console.log('Available positions for', selectedHandle, ':', positions);

      // Store current selection to try to maintain it
      const currentValue = embroideredSelect.value;

      // Clear and rebuild options
      embroideredSelect.innerHTML = '';

      if (positions.length === 0) {
        // Fallback: add default options if none defined
        const defaultOptions = ['Left Chest', 'Right Chest'];
        defaultOptions.forEach((position) => {
          const option = document.createElement('option');
          option.value = position;
          option.textContent = position;
          embroideredSelect.appendChild(option);
        });
        console.log('No positions defined, using defaults');
      } else {
        // Add positions from mapping (already decoded)
        positions.forEach((position) => {
          const option = document.createElement('option');
          option.value = position;
          option.textContent = position;
          embroideredSelect.appendChild(option);
        });
      }

      // Try to restore previous selection, otherwise select first
      if (currentValue && Array.from(embroideredSelect.options).some((opt) => opt.value === currentValue)) {
        embroideredSelect.value = currentValue;
      } else if (embroideredSelect.options.length > 0) {
        embroideredSelect.selectedIndex = 0;
      }

      // Trigger change event to update any dependent elements (like disclaimer)
      embroideredSelect.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function init() {
      const courseSelect = document.getElementById('course-select');
      if (!courseSelect) {
        console.warn('Course select not found, retrying...');
        return;
      }

      // Update on club selection change
      courseSelect.addEventListener('change', updateLogoPositions);

      // Trigger immediately on init
      updateLogoPositions();
    }

    // Multiple initialization attempts to ensure it runs
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      // If DOM already loaded, init immediately
      init();
    }

    // Also try after a delay as fallback
    setTimeout(init, 150);

    // Listen for custom select initialization
    window.addEventListener('customSelectInitialized', function () {
      console.log('Custom select initialized, updating logo positions');
      setTimeout(updateLogoPositions, 100);
    });
  })();

  // Filter logos by embroidered selection (FIXED - Correct visibility logic)
  (function () {
    'use strict';

    function filterLogosByEmbroideredSelection() {
      const embroideredSelect = document.getElementById('select-embroidered');
      if (!embroideredSelect) {
        console.log('Embroidered select not found');
        return;
      }

      const selectedPosition = embroideredSelect.value;
      console.log('Selected position:', selectedPosition);

      const isSleeveChestSelected =
        selectedPosition.toLowerCase().includes('sleeve') && selectedPosition.toLowerCase().includes('chest');
      console.log('Is sleeve+chest selected?', isSleeveChestSelected);

      // Find visible container using aria-hidden
      const visibleLogoContainer = document.querySelector('.course-logos[aria-hidden="false"]');

      if (!visibleLogoContainer) {
        console.log('No visible logo container found (aria-hidden="false")');
        return;
      }

      console.log('Visible logo container:', visibleLogoContainer.dataset.course);

      const logoOptions = visibleLogoContainer.querySelectorAll('.variant-picker__option');
      console.log('Total logo options found:', logoOptions.length);

      logoOptions.forEach((option, index) => {
        const button = option.querySelector('.variant-picker__option-button--course');
        const input = option.querySelector('input[type="radio"]');

        if (!button && !input) {
          console.log(`Option ${index}: No button or input found`);
          return;
        }

        let altText = button?.getAttribute('data-alt') || input?.getAttribute('data-logo-alt') || '';
        altText = altText.toLowerCase().trim();

        console.log(`Option ${index} alt text:`, altText);

        const hasSleeveAndChest = altText.includes('sleeve') && altText.includes('chest');
        console.log(`Option ${index} has sleeve+chest?`, hasSleeveAndChest);

        if (isSleeveChestSelected) {
          // When "Left Chest & Sleeve" is selected:
          // ONLY show logos that have "sleeve" AND "chest" in alt text
          // HIDE all other logos
          if (hasSleeveAndChest) {
            option.style.display = '';
            console.log(`Option ${index}: SHOWING (matches sleeve+chest selection)`);
          } else {
            option.style.display = 'none';
            console.log(`Option ${index}: HIDING (doesn't match sleeve+chest selection)`);
          }
        } else {
          // When other options selected (Left Chest, Right Chest, etc):
          // SHOW all logos (including sleeve+chest logos)
          option.style.display = '';
          console.log(`Option ${index}: SHOWING (non-sleeve+chest selection, show all)`);
        }
      });
    }

    function init() {
      const embroideredSelect = document.getElementById('select-embroidered');
      const courseSelect = document.getElementById('course-select');

      if (!embroideredSelect) {
        console.warn('Embroidered select not found in init');
        return;
      }

      console.log('Initializing logo filter');

      embroideredSelect.addEventListener('change', function () {
        console.log('Embroidered select changed');
        setTimeout(filterLogosByEmbroideredSelection, 50);
      });

      if (courseSelect) {
        courseSelect.addEventListener('change', () => {
          console.log('Course select changed');
          setTimeout(filterLogosByEmbroideredSelection, 100);
        });
      }

      // Initial filter
      setTimeout(filterLogosByEmbroideredSelection, 300);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      setTimeout(init, 200);
    }
  })();

  // Update disclaimer based on embroidered selection
  (function () {
    'use strict';

    function updateDisclaimer() {
      const select = document.getElementById('select-embroidered');
      const disclaimer = document.querySelector('.logo-disclaimer');

      if (disclaimer && select) {
        const selectedValue = select.value.toLowerCase();
        const isSleeveChest = selectedValue.includes('sleeve') && selectedValue.includes('chest');

        disclaimer.textContent = isSleeveChest
          ? 'Preview shows left chest only - club name will display on left sleeve'
          : 'Preview shows left chest only';
      }
    }

    function init() {
      const embroideredSelect = document.getElementById('select-embroidered');

      if (embroideredSelect) {
        embroideredSelect.addEventListener('change', updateDisclaimer);
        updateDisclaimer();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      setTimeout(init, 100);
    }
  })();
</script>
<script>
  // Custom styled dropdown for Logo Placement (no favorites, style only)
  (function () {
    'use strict';

    class CustomEmbroideredSelect {
      constructor(element, originalSelect) {
        this.element = element;
        this.originalSelect = originalSelect;
        this.isOpen = false;
        this.observer = null;

        this.init();
      }

      init() {
        this.createCustomUI();
        this.bindEvents();
        this.updateTriggerText();
        this.observeOptionChanges();
      }

      createCustomUI() {
        // Check if custom UI already exists
        if (document.getElementById('custom-embroidered-select')) {
          console.log('Custom embroidered select already exists');
          return;
        }

        // Create wrapper
        const wrapper = document.createElement('div');
        wrapper.className = 'custom-select custom-embroidered-select';
        wrapper.id = 'custom-embroidered-select';

        // Hide original label (we render our own clean one)
        const originalLabel = this.originalSelect.previousElementSibling;
        if (originalLabel && originalLabel.tagName === 'LABEL') {
          originalLabel.style.display = 'none';
        }

        wrapper.innerHTML = `
          <label>Logo Placement</label>
          <div class="select-trigger">
            <span class="placeholder">Please select</span>
            <span class="arrow">
              <svg viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
          <div class="select-dropdown">
            <!-- Options will be populated here -->
          </div>
          <p class="logo-disclaimer" style="margin-top: 6px; font-size: 0.85rem; color: #6b7280;">Preview shows left chest only</p>
        `;

        // ── KEY CHANGE: inject into #placement-select-col instead of next to original select ──
        const targetCol = document.getElementById('placement-select-col');
        if (targetCol) {
          targetCol.appendChild(wrapper);
        } else {
          // Fallback: insert before original select (original behaviour)
          this.originalSelect.parentNode.insertBefore(wrapper, this.originalSelect);
        }

        // Hide original select completely
        this.originalSelect.style.display = 'none';
        this.originalSelect.style.visibility = 'hidden';
        this.originalSelect.style.position = 'absolute';
        this.originalSelect.style.opacity = '0';
        this.originalSelect.style.pointerEvents = 'none';

        // Store references
        this.element = wrapper;
        this.trigger = wrapper.querySelector('.select-trigger');
        this.dropdown = wrapper.querySelector('.select-dropdown');

        this.renderOptions();
      }

      observeOptionChanges() {
        // Use MutationObserver to watch for option changes in original select
        this.observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.type === 'childList' || mutation.type === 'attributes') {
              console.log('Options changed, re-rendering');
              this.renderOptions();
              this.updateTriggerText();
            }
          });
        });

        // Start observing
        this.observer.observe(this.originalSelect, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['selected'],
        });
      }

      renderOptions() {
        const options = Array.from(this.originalSelect.options);
        let html = '';

        console.log('Rendering options, total:', options.length);

        options.forEach((option) => {
          if (option.value) {
            // Skip empty options
            const isSelected = option.selected ? 'selected' : '';
            html += `
              <div class="select-option ${isSelected}" data-value="${this.escapeHtml(option.value)}">
                <span class="option-text">${this.escapeHtml(option.textContent.trim())}</span>
              </div>
            `;
          }
        });

        if (this.dropdown) {
          this.dropdown.innerHTML = html;
        }
      }

      escapeHtml(text) {
        const map = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;',
        };
        return text.replace(/[&<>"']/g, (m) => map[m]);
      }

      updateTriggerText() {
        if (!this.trigger) return;

        const selectedOption = this.originalSelect.options[this.originalSelect.selectedIndex];
        const triggerText = this.trigger.querySelector('span:first-child');

        if (selectedOption && selectedOption.value) {
          triggerText.textContent = selectedOption.textContent.trim();
          triggerText.classList.remove('placeholder');
        } else {
          triggerText.textContent = 'Please select';
          triggerText.classList.add('placeholder');
        }
      }

      bindEvents() {
        // Toggle dropdown
        this.trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          this.toggleDropdown();
        });

        // Handle option selection
        this.dropdown.addEventListener('click', (e) => {
          const option = e.target.closest('.select-option');
          if (option) {
            this.selectOption(option.dataset.value);
          }
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
          if (this.element && !this.element.contains(e.target)) {
            this.closeDropdown();
          }
        });

        // Keyboard navigation
        if (this.element) {
          this.element.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.isOpen) {
              this.closeDropdown();
            }
          });
        }

        // Listen for programmatic changes to original select
        this.originalSelect.addEventListener('change', () => {
          console.log('Original select changed');
          this.updateTriggerText();
          this.updateSelectedState();
        });
      }

      updateSelectedState() {
        if (!this.dropdown) return;

        const selectedValue = this.originalSelect.value;
        const options = this.dropdown.querySelectorAll('.select-option');

        options.forEach((option) => {
          if (option.dataset.value === selectedValue) {
            option.classList.add('selected');
          } else {
            option.classList.remove('selected');
          }
        });
      }

      toggleDropdown() {
        this.isOpen ? this.closeDropdown() : this.openDropdown();
      }

      openDropdown() {
        this.isOpen = true;
        this.trigger.classList.add('open');
        this.dropdown.classList.add('open');
      }

      closeDropdown() {
        this.isOpen = false;
        this.trigger.classList.remove('open');
        this.dropdown.classList.remove('open');
      }

      selectOption(value) {
        // Update original select
        this.originalSelect.value = value;

        // Trigger change event
        const changeEvent = new Event('change', { bubbles: true });
        this.originalSelect.dispatchEvent(changeEvent);

        // Update UI
        this.updateTriggerText();
        this.updateSelectedState();
        this.closeDropdown();
      }

      destroy() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    let customSelectInstance = null;

    // Initialize when DOM is ready
    function initCustomEmbroideredSelect() {
      const originalSelect = document.getElementById('select-embroidered');

      if (!originalSelect) {
        console.log('Original select-embroidered not found');
        return;
      }

      // Check if already initialized
      if (customSelectInstance) {
        console.log('Custom select already initialized');
        return;
      }

      if (document.getElementById('custom-embroidered-select')) {
        console.log('Custom embroidered select UI already exists');
        return;
      }

      console.log('Initializing custom embroidered select');
      customSelectInstance = new CustomEmbroideredSelect(null, originalSelect);
    }

    // Check if DOM is already loaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(initCustomEmbroideredSelect, 300);
      });
    } else {
      setTimeout(initCustomEmbroideredSelect, 300);
    }

    // Also listen for when options are dynamically updated
    window.addEventListener('customSelectInitialized', function () {
      console.log('Custom select initialized event received');
      setTimeout(initCustomEmbroideredSelect, 400);
    });
  })();
</script>

