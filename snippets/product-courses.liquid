{%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
{%- assign pageUrl = content_for_header
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: '.myshopify.com'
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}

{%- assign clubParam = pageUrl | split: 'club=' | last | split: '&' | first -%}

{%- if clubParam contains '.com' or clubParam contains '/' -%}
  {%- assign clubParam = '' -%}
{%- endif -%}

{% assign courses = shop.metaobjects.courses.values %}
{% assign courses = courses | sort: 'title' %}

{% if courses %}
  <div class="variant-clubs">
    <div class="course-box">
      <label class="form__label" for="course-select" style="margin-bottom: 16px; display: block;"> </label>

      <!-- Custom Select Styles -->
      <style>
          .custom-select {
            position: relative;
            width: 100%;
          }
        .select-trigger:hover {
         outline:1px solid  #5e5e5e;
         border-color:#5e5e5e;
        }
          .custom-select label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 14px;
            color: #333;
          }

          .custom-select label .required {
            color: #dc3545;
            margin-left: 2px;
          }

          .select-trigger {
            width: 100%;
            padding: 12px 40px 12px 16px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            background-color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s ease;
            font-size: 15px;
            color: #333;
          }

          .select-trigger:hover {
            border-color: #9ca3af;
          }

          .select-trigger.open {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
          }

          .select-trigger .placeholder {
            color: #6b7280;
          }

          .select-trigger .arrow {
            position: absolute;
            right: 16px;
            pointer-events: none;
            transition: transform 0.2s ease;
          }

          .select-trigger.open .arrow {
            transform: rotate(180deg);
          }

          .select-trigger .arrow svg {
            width: 16px;
            height: 16px;
            fill: #6b7280;
          }

          .select-dropdown {
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.2s ease;
          }

          .select-dropdown.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
          }

          .select-option {
            padding: 12px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: background-color 0.15s ease;
            font-size: 15px;
            color: #333;
          }

          .select-option:hover {
            background-color: #f3f4f6;
          }

          .select-option.selected {
            background-color: #eff2ef;
          }

          .favorite-icon {
            width: 20px;
            height: 20px;
            cursor: pointer;
            flex-shrink: 0;
            transition: transform 0.2s ease;
          }

          .favorite-icon:hover {
            transform: scale(1.1);
          }

          .favorite-icon svg {
            width: 100%;
            height: 100%;
          }

          .favorite-icon.favorited svg {

          }

          .favorite-icon:not(.favorited) svg {
            fill: none;
            stroke: #9ca3af;
            stroke-width: 2;
          }

          .option-text {
            flex: 1;
          }

          .favorites-separator {
            border-bottom: 1px solid #e5e7eb;
            margin: 4px 0;
          }

          /* Scrollbar styling */
          .select-dropdown::-webkit-scrollbar {
            width: 8px;
          }

          .select-dropdown::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 0 6px 6px 0;
          }

          .select-dropdown::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
          }

          .select-dropdown::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
          }
          .favorite-icon {
          display: none;
        }
        .favorite-icon.favorited {
          display: block;
        }
        .select-option.selected .option-text {
          font-weight: 500;
        }
      </style>

      <!-- Original Select (Hidden) -->
      <select
        id="course-select"
        class="form-control"
        name="properties[Club]"
        {% if field_required %}
          required
        {% endif %}
        form="{{ product_form_id }}"
        aria-label="Select a club from the list"
        style="display:none"
      >
        {% assign courses_array = courses | parse_json %}
        {% assign sorted_courses = courses_array | sort: 'title' %}

        {% for course in sorted_courses %}
          {% assign label = course.title | strip %}
          {% unless label == 'Fescue & Dunes' %}
            <option
              {% if label == current_variant.option1
                or label == current_variant.option2
                or label == current_variant.option3
              %}
                selected
              {% endif %}
              value="{{ label }}"
              data-slug="{{ label | handleize }}"
            >
              {{ label }}
            </option>
          {% endunless %}
        {% endfor %}

        {%- comment -%} Always append "Fescue & Dunes" last {%- endcomment -%}
        {% assign special_label = 'Fescue & Dunes' %}
        {% for course in courses_array %}
          {% if course.title == special_label %}
            <option
              {% if special_label == current_variant.option1
                or special_label == current_variant.option2
                or special_label == current_variant.option3
              %}
                selected
              {% endif %}
              value="{{ special_label }}"
              data-slug="{{ special_label | handleize }}"
            >
              {{ special_label }}
            </option>
            {% break %}
          {% endif %}
        {% endfor %}
      </select>

      <!-- Custom Select Styles -->
      <style>
        .field-error {
          color: #d02e2e;
          font-size: 0.9rem;
          margin-top: 4px;
        }
        .error-border {
          border: 2px solid #d02e2e !important;
        }
        .btn-add-to-cart.disabled {
          pointer-events: none;
          opacity: 0.6;
        }
        .custom-select {
          position: relative;
          width: 100%;
        }

        .custom-select label {
          display: block;
          margin-bottom: 8px;
          font-weight: 600;
          font-size: 14px;
          color: #333;
        }

