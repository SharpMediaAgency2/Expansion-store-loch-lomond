          border-radius: 0 6px 6px 0;
        }

        .select-dropdown::-webkit-scrollbar-thumb {
          background: #d1d5db;
          border-radius: 4px;
        }

        .select-dropdown::-webkit-scrollbar-thumb:hover {
          background: #9ca3af;
        }

        /* ============================================================
           Logo Swatches: horizontal scroll on mobile, 6-per-row grid on desktop
           ============================================================ */

        /* Wrappers: never clip scroll, stay within parent content area */
        .course-logos {
          position: relative;
          width: 100%;
          box-sizing: border-box;
        }

        .logo-box,
        .variant-picker__input.variant-picker__color.logo-box {
          
          padding-bottom: 8px;
        }

        .variant-picker__option-values.select-logos {
          overflow: visible;
        }

        /* Shared base: swatch button styles (both breakpoints) */
        .select-logos .variant-picker__option {
          position: relative;
          overflow: visible;
        }

        .variant-picker__option-button--course {
          display: block !important;
          width: clamp(72px, 8vw, 80px) !important;
          height:  clamp(72px, 8vw, 80px) !important;
          min-width: 72px !important;
          background-image: var(--swatch-background) !important;
          background-repeat: no-repeat !important;
          background-position: center !important;
          background-size: 85% !important;
          background-color: #F3F4F6 !important;
          border: 2px solid #D1D5DC !important;
          border-radius: 10px !important;
          cursor: pointer;
          text-indent: -9999px;
          overflow: hidden;
          box-sizing: border-box;
        }

        .variant-picker__option-button--course:hover {
          border-color: #5e5e5e !important;
        }

        input[type="radio"]:checked + .variant-picker__option-button--course {
          border-color: #1a1a1a !important;
          border-width: 2px !important;
        }

        /* Logo zoom trigger */
        .logo-zoom-btn {
          position: absolute;
          right: -8px;
          bottom: -8px;
          z-index: 3;
          width: 36px;
          height: 36px;
          padding: 0;
          margin: 0;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          border-radius: 50%;
          border: none;
          background: #fff;
          color: #1a1a1a;
          cursor: pointer;
          line-height: 0;
        }

        .logo-zoom-btn:hover {
          background: #f3f4f6;
        }

        .logo-zoom-btn:focus-visible {
          outline: 2px solid #1a1a1a;
          outline-offset: 2px;
        }

        .logo-zoom-btn svg {
          width: 22px;
          height: 22px;
          display: block;
          pointer-events: none;
        }

        #logo-zoom-overlay {
          position: fixed;
          inset: 0;
          background: rgba(0, 0, 0, 0.6);
          backdrop-filter: blur(2px);
          -webkit-backdrop-filter: blur(2px);
          z-index: 998;
          display: none;
        }

        #logo-zoom-modal {
          position: fixed;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          z-index: 999;
          background: #fff;
          border-radius: 12px;
          box-shadow: 0 24px 64px rgba(0, 0, 0, 0.22);
          width: min(92vw, 520px);
          max-height: 90vh;
          overflow: auto;
          -webkit-overflow-scrolling: touch;
          display: none;
          outline: none;
        }

        #logo-zoom-modal[open],
        #logo-zoom-overlay[open] {
          display: block;
        }

        #logo-zoom-modal .logo-zoom-modal__close {
          position: sticky;
          top: 12px;
          float: right;
          margin: 12px 12px 0 0;
          padding: 0;
          width: 36px;
          height: 36px;
          border: none;
          background: #f3f4f6;
          border-radius: 50%;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
          flex-shrink: 0;
          color: #1a1a1a;
        }

        #logo-zoom-modal .logo-zoom-modal__close svg {
          width: 18px;
          height: 18px;
          display: block;
        }

        #logo-zoom-modal .logo-zoom-modal__body {
          clear: both;
          padding: 8px 24px 32px;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        #logo-zoom-modal .logo-zoom-modal__img {
          display: block;
          max-width: 100%;
          width: auto;
          height: auto;
          max-height: min(70vh, 420px);
          object-fit: contain;
        }

        @media screen and (max-width: 749px) {
          #logo-zoom-modal {
            width: min(94vw, 420px);
          }

          #logo-zoom-modal .logo-zoom-modal__body {
            padding: 4px 16px 24px;
          }
        }

        /* ── Mobile only (< 750px): horizontal row; scroll only for 4+ logos ── */
        @media screen and (max-width: 749px) {
          .variant-picker__field.course-logos {
            width: 100% !important;
            max-width: 100vw !important;
            overflow: visible !important;
            box-sizing: border-box !important;
          }

          .variant-picker__input.variant-picker__color.logo-box {
            width: 100% !important;
            max-width: 100% !important;
            overflow: visible !important;
            box-sizing: border-box !important;
            min-width:unset!important;
          }

          /* Default: no scroll (2–3 logos). Width hugs content. */
          .select-logos {
            display: flex !important;
            flex-wrap: nowrap !important;
            align-items: flex-start !important;
            justify-content: flex-start !important;
            gap: 10px;
            width: max-content !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
            overflow-x: hidden !important;
            overflow-y: visible !important;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            padding: 4px 8px 14px 2px;
          }

          .select-logos::-webkit-scrollbar {
            display: none;
          }

          .select-logos .variant-picker__option {
            flex: 0 0 clamp(72px, 18vw, 80px) !important;
            width: clamp(72px, 18vw, 80px) !important;
            height: clamp(72px, 18vw, 80px) !important;
            min-width: clamp(72px, 18vw, 80px) !important;
            min-height: clamp(72px, 18vw, 80px) !important;
          }

          /* 4+ logos: allow horizontal scroll */
          .select-logos.select-logos--scrollable {
            width: 100% !important;
            max-width: min(100%, 280px) !important;
            overflow-x: auto !important;
          }

          /* Overlay host on product media (bottom-right) */
          .f-product__media-wrapper,
          .f-product__media-viewer,
          .f-product__media-viewer [data-media-viewer] {
            position: relative;
          }

          /* Keep media zoom top-left so it doesn't collide with logo overlay */
          .f-product__media-zoom {
            top: 1rem !important;
            left: 1rem !important;
            right: auto !important;
            bottom: auto !important;
          }

          .logo-swatch-overlay {
            --logo-card-size: clamp(64px, 17vw, 96px);
            --logo-gap: 12px;
            position: absolute;
            right: 0;
            bottom: 20px;
            transform: translateY(50%);
            z-index: 8;
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
            max-width: calc(100vw - 96px);
            padding: 10px 8px 4px 10px;
            background: var(--color-background, #fff);
            border-radius: 25px 0 0 0; /* large top-left only; other corners square */
            pointer-events: auto;
            overflow: visible;
          }

          .logo-swatch-overlay input[type="radio"] {
            clip: rect(0, 0, 0, 0);
            overflow: hidden;
            position: absolute;
            height: 1px;
            width: 1px;
          }

          .logo-swatch-overlay .select-logos {
            margin: 0;
            gap: var(--logo-gap);
            padding: 0 24px 14px 0;
            overflow: visible !important;
          }

          .logo-swatch-overlay .select-logos.select-logos--scrollable {
            width: calc(3.25 * var(--logo-card-size) + 3 * var(--logo-gap) + 32px) !important;
            max-width: calc(3.25 * var(--logo-card-size) + 3 * var(--logo-gap) + 32px) !important;
            overflow-x: auto !important;
            overflow-y: visible !important;
            padding-right: 0;
          }

          .logo-swatch-overlay .select-logos .variant-picker__option {
            flex: 0 0 var(--logo-card-size) !important;
            width: var(--logo-card-size) !important;
            height: var(--logo-card-size) !important;
            min-width: var(--logo-card-size) !important;
            min-height: var(--logo-card-size) !important;
          }

          .logo-swatch-overlay .variant-picker__option-button--course {
            width: 100% !important;
            height: 100% !important;
            min-width: 0 !important;
            background-color: #fff !important;
            background-size: 96% !important;
            border: 1px solid #D1D5DC !important;
          }

          .logo-swatch-overlay input[type="radio"]:checked + .variant-picker__option-button--course {
            border: 2.5px solid #1a1a1a !important;
          }

          /* Unselected logos appear faded */
          .logo-swatch-overlay input[type="radio"]:not(:checked) + .variant-picker__option-button--course {
            opacity: 0.55;
          }

          /* Larger zoom hit target on mobile */
          .logo-swatch-overlay .logo-zoom-btn {
            width: 40px;
            height: 40px;
            right: -10px;
            bottom: -10px;
          }

          .logo-swatch-overlay .logo-zoom-btn svg {
            width: 24px;
            height: 24px;
          }

          .logo-box--swatches-moved {
            display: flex !important;
            align-items: flex-end;
            min-height: calc(clamp(64px, 17vw, 96px) / 2 - 14px);
            margin: 0 !important;
            padding-bottom: 0;
          }

          .logo-box--swatches-moved .form__label {
            margin: 0 !important;
            transform: translateY(-30px);
          }

          .variant-clubs .club-selects-row {
            margin-top: -18px !important;
          }
        }

        @media screen and (min-width: 750px) {
          .logo-swatch-overlay {
            display: none !important;
          }
        }

        /* ── Desktop (≥ 750px): wrapping grid, max 6 per row ── */
        @media screen and (min-width: 750px) {
          .select-logos {
            display: grid !important;
            grid-template-columns: repeat(6, 80px);
            grid-auto-rows: 80px;
            justify-content: start;
            align-items: start;
            gap: 10px;
            overflow-x: visible !important;
            overflow-y: visible !important;
            padding: 4px 8px 10px 2px;
            width: 100%;
          }

          .select-logos .variant-picker__option {
            width: clamp(72px,8vw,80px) !important;
            height: clamp(72px,8vw,80px) !important;
            flex: unset !important;
          }
        }
      </style>

      <!-- Original Select (Hidden) -->
      <select
        id="course-select"
        class="form-control"
        name="properties[Club]"
        {% if field_required %}
          required
        {% endif %}
        form="{{ product_form_id }}"
        aria-label="Select a club from the list"
        style="display:none"
      >
        {% assign course_titles = courses | map: 'title' | map: 'value' | sort %}

        {% for title in course_titles %}
          {% assign label = title | strip %}
          {% unless label == 'Fescue & Dunes' %}
            <option
              {% if label == current_variant.option1
                or label == current_variant.option2
                or label == current_variant.option3
              %}
                selected
              {% endif %}
              value="{{ label }}"
              data-slug="{{ label | handleize }}"
            >
              {{ label }}
            </option>
          {% endunless %}
        {% endfor %}

        {%- comment -%} Always append "Fescue & Dunes" last {%- endcomment -%}
        {% assign special_label = 'Fescue & Dunes' %}
        <option
          {% if special_label == current_variant.option1
            or special_label == current_variant.option2
            or special_label == current_variant.option3
          %}
            selected
          {% endif %}
          value="{{ special_label }}"
          data-slug="{{ special_label | handleize }}"
        >
          {{ special_label }}
        </option>
      </select>

      <!-- Logo Swatches (full width, above the 2-col row) -->
      {% for course in courses %}
        {% assign course_title = course.title.value | strip %}
        {% assign course_handle = course_title | handle %}
        {% if course.course_logos %}
          <div
            class="variant-picker__field course-logos"
            style="display:none"
            data-picker-field="radio"
            data-option-name="Selected Logo"
            data-course="{{ course_handle }}"
            aria-hidden="true"
          >
            <div class="variant-picker__input variant-picker__color logo-box" style="margin-top: 1.5rem;">
              <label class="form__label">
                <span class="font-semibold">Select a Logo:</span>
              </label>
              <div
                class="variant-picker__option-values select-logos{% if course.course_logos.value.size >= 4 %} select-logos--scrollable{% endif %}"
                data-logo-count="{{ course.course_logos.value.size }}"
              >
                {% for logo in course.course_logos.value %}
                  {% assign logo_url = logo | image_url: width: 100 %}
                  {% assign logo_zoom_url = logo | image_url: width: 1000 %}
                  {% assign file_name = logo_url | split: '/' | last | split: '?' | first %}
                  {% assign name_text = file_name | split: '.' | first | replace: '-', ' ' | replace: '_', ' ' %}
                  {% assign alt_text = logo.alt | split: '.' | first | replace: '-', ' ' | replace: '_', ' ' %}
                  {% assign input_id = 'logo-' | append: forloop.index | append: '-' | append: course_handle %}
                  <div class="variant-picker__option">
                    {% if clubParam.size > 2 %}
                      <input
                        type="radio"
                        id="{{ input_id }}"
                        name="properties[Logo]"
                        value="{{ name_text | escape }}"
                        form="{{ product_form_id }}"
                        autocomplete="off"
                        data-course-logo="{{ logo_url }}"
                        data-logo-zoom="{{ logo_zoom_url }}"
                        data-logo-alt="{{ alt_text | escape }}"
                        {% if course_handle contains clubParam %}
