  // Define the function to be triggered on radio button change or click
  function handleLogoChange(event) {
    const selectedValue = event.target.value;
    // Get the value of the 'data-course-logo' attribute from the radio button
    const courseLogoData = event.target.dataset.courseLogo;

    // Get all SVG <image> elements with the ID 'course-logo'.
    const svgImageElements = document.querySelectorAll('image[id="course-logo"]');

    if (svgImageElements.length > 0) {
      svgImageElements.forEach((svgImageElement) => {
        try {
          // For modern SVG (SVG2), set the href attribute directly.
          // For backward compatibility (older SVG versions/browsers), also set xlink:href using setAttributeNS.
          svgImageElement.setAttribute('href', courseLogoData);
          svgImageElement.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', courseLogoData);

          console.log('Updated href of SVG <image> (ID: course-logo) to:', courseLogoData);
        } catch (error) {
          console.error('Error updating SVG <image> href for one element:', error);
        }
      });
    } else {
      console.warn("No SVG <image> elements with id='course-logo' found in the DOM.");
