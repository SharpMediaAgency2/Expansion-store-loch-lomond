          display: flex;
          align-items: center;
          gap: 12px;
          transition: background-color 0.15s ease;
          font-size: 15px;
          color: #333;
        }

        .select-option:hover {
          background-color: #eff2ef !important;
        }
        .select-option:hover .option-text {
          transition: all 0.3s;
          font-weight:500;
        }
        .select-option.selected {
