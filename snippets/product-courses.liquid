        .club-selects-row__col .custom-embroidered-select {
          margin-top: 0 !important;
        }
        #club-select-col{display:none;}
      </style>

      <script>
        (function () {
          'use strict';

          class CustomSelect {
            constructor(element, originalSelect) {
              this.element = element;
              this.originalSelect = originalSelect;
              this.options = [];
              this.selectedValue = null;
              this.favorites = [];
              this.isOpen = false;

              this.trigger = element.querySelector('.select-trigger');
              this.dropdown = element.querySelector('.select-dropdown');

              this.init();
            }

            init() {
              this.loadOptionsFromSelect();
              this.loadFavorites();
              this.renderOptions();
              this.setInitialValue();
              this.renderOptions(); // Re-render after setting initial value to show selected state
              this.bindEvents();

              // Dispatch custom event when initialized
              window.dispatchEvent(new Event('customSelectInitialized'));
            }

            loadOptionsFromSelect() {
              const selectOptions = this.originalSelect.querySelectorAll('option');
              selectOptions.forEach((option) => {
                if (option.value) {
                  // Skip empty placeholder option
                  this.options.push({
                    value: option.value,
                    label: option.textContent.trim(),
                    slug: option.dataset.slug || this.slugify(option.value),
                    selected: option.selected,
                  });
                }
              });
            }

            slugify(text) {
              return text
                .toLowerCase()
                .trim()
                .replace(/[^\w\s-]/g, '')
                .replace(/[\s_-]+/g, '-')
                .replace(/^-+|-+$/g, '');
            }

            loadFavorites() {
              // Use CookieManager if available, otherwise fallback to empty array
              if (typeof CookieManager !== 'undefined' && typeof CookieManager.getFavoriteClubs === 'function') {
                try {
                  this.favorites = CookieManager.getFavoriteClubs() || [];
                  // Sort favorites alphabetically A-Z
                  this.favorites.sort((a, b) => a.localeCompare(b));
                } catch (e) {
                  console.warn('Error loading favorite clubs:', e);
                  this.favorites = [];
                }
              } else {
                this.favorites = [];
              }
            }

            saveFavorites() {
              // Use CookieManager if available
              if (typeof CookieManager !== 'undefined' && typeof CookieManager.setFavoriteClubs === 'function') {
                try {
                  CookieManager.setFavoriteClubs(this.favorites);
                } catch (e) {
                  console.warn('Error saving favorite clubs:', e);
                }
              }
            }

            getUrlParameter(name) {
              const urlParams = new URLSearchParams(window.location.search);
              return urlParams.get(name);
            }

            setInitialValue() {
              // Priority 1: Check if there's a 'club' parameter in the URL
              //const clubParam = this.getUrlParameter('club');
              // accept the internal `club` param OR the campaign `utm_campaign_club`
              const clubParam = this.getUrlParameter('club') || this.getUrlParameter('utm_campaign_club');
              if (clubParam) {
                // If club parameter exists, try to find and select that option
                const paramOption = this.options.find(
                  (opt) =>
                    opt.slug === clubParam ||
                    opt.value.toLowerCase() === clubParam.toLowerCase() ||
                    this.slugify(opt.value) === clubParam
                );

                if (paramOption) {
                  this.selectOptionInternal(paramOption.value);
                  return;
                }
              }

              // Priority 2: Check for club_handle in cookie
              let clubHandleCookie = '';
              if (typeof getCookie === 'function') {
                clubHandleCookie = getCookie('club_handle');
              } else {
                // Direct cookie reading as fallback
                const name = 'club_handle=';
                const decodedCookie = decodeURIComponent(document.cookie);
                const ca = decodedCookie.split(';');
                for (let i = 0; i < ca.length; i++) {
                  let c = ca[i];
                  while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                  }
                  if (c.indexOf(name) == 0) {
                    clubHandleCookie = c.substring(name.length, c.length);
                    break;
                  }
                }
              }

              if (clubHandleCookie && clubHandleCookie !== '') {
                // Try to find option matching the cookie handle
                const cookieOption = this.options.find(
                  (opt) => opt.slug === clubHandleCookie || this.slugify(opt.value) === clubHandleCookie
                );

                if (cookieOption) {
                  this.selectOptionInternal(cookieOption.value);
                  return;
                }
                // If invalid cookie, just ignore and fall through to default
              }

              // Priority 3: Default - select the first item (favorite if available, otherwise first in list)
              let firstOption;

              if (this.favorites.length > 0) {
                const firstFavoriteSlug = this.favorites[0];
                firstOption = this.options.find((opt) => opt.slug === firstFavoriteSlug);
              }

              // If no favorite found or no favorites, use first option from the list
              if (!firstOption && this.options.length > 0) {
                firstOption = this.options[0];
              }

              if (firstOption) {
                this.selectOptionInternal(firstOption.value);
              }
            }

            selectOptionInternal(value) {
              // Clear all selected flags in options array
              this.options.forEach((opt) => (opt.selected = false));

              // Clear selected attribute from all original select options
              const originalOptions = this.originalSelect.querySelectorAll('option');
              originalOptions.forEach((opt) => opt.removeAttribute('selected'));

              // Find and mark the new selected option
              const option = this.options.find((opt) => opt.value === value);

              if (option) {
                option.selected = true;
                this.selectedValue = value;
                this.originalSelect.value = value;

                // Add selected attribute to the corresponding option in original select
                const originalOption = Array.from(originalOptions).find((opt) => opt.value === value);
                if (originalOption) {
                  originalOption.setAttribute('selected', 'selected');
                }

                const triggerText = this.trigger.querySelector('span:first-child');
                triggerText.textContent = option.label;
                triggerText.classList.remove('placeholder');

                // Trigger change event on original select with a slight delay to ensure DOM is updated
                setTimeout(() => {
                  const changeEvent = new Event('change', { bubbles: true });
                  this.originalSelect.dispatchEvent(changeEvent);
                }, 0);
              }
            }

            toggleFavorite(slug, event) {
              event.stopPropagation();

              const index = this.favorites.indexOf(slug);
              if (index > -1) {
                this.favorites.splice(index, 1);
              } else {
                this.favorites.push(slug);
              }

              this.saveFavorites();
              this.renderOptions();
            }

            renderOptions() {
              // Separate favorite and regular options
              const favoriteOptions = this.options.filter((opt) => this.favorites.includes(opt.slug));

              const regularOptions = this.options.filter((opt) => !this.favorites.includes(opt.slug));

              // Sort favorite options alphabetically by label (A-Z)
              favoriteOptions.sort((a, b) => {
                return a.label.localeCompare(b.label, undefined, { sensitivity: 'base' });
              });

              // Sort regular options alphabetically by label (A-Z)
              regularOptions.sort((a, b) => {
                return a.label.localeCompare(b.label, undefined, { sensitivity: 'base' });
              });

              let html = '';

              // Render favorite options
              if (favoriteOptions.length > 0) {
                favoriteOptions.forEach((option) => {
                  html += this.createOptionHTML(option, true);
                });

                if (regularOptions.length > 0) {
                  html += '<div class="favorites-separator"></div>';
                }
              }

              // Render regular options (sorted A-Z)
              regularOptions.forEach((option) => {
                html += this.createOptionHTML(option, false);
              });

              this.dropdown.innerHTML = html;
            }

            createOptionHTML(option, isFavorite) {
              const isSelected = this.selectedValue === option.value ? 'selected' : '';
              return `
          <div class="select-option ${isSelected}" data-value="${this.escapeHtml(option.value)}">
            <div class="favorite-icon ${isFavorite ? 'favorited' : ''}" data-slug="${option.slug}">
              <svg viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg" class="f-icon-svg f-icon-svg--medium ">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M21.0002 8.97903C21.0002 15.2234 12.0006 20.479 12.0006 20.479C12.0006 20.479 3.00024 15.1457 3.00024 8.99169C3.00024 6.47903 5.00024 4.47903 7.50024 4.47903C10.0002 4.47903 12.0002 7.47903 12.0002 7.47903C12.0002 7.47903 14.0002 4.47903 16.5002 4.47903C19.0002 4.47903 21.0002 6.47903 21.0002 8.97903Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
            <span class="option-text">${this.escapeHtml(option.label)}</span>
          </div>
        `;
            }

            escapeHtml(text) {
              const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;',
              };
              return text.replace(/[&<>"']/g, (m) => map[m]);
            }

            bindEvents() {
              // Toggle dropdown
              this.trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                this.toggleDropdown();
              });

              // Handle option selection and favoriting
              this.dropdown.addEventListener('click', (e) => {
                const option = e.target.closest('.select-option');
                const favoriteIcon = e.target.closest('.favorite-icon');

                if (favoriteIcon) {
                  this.toggleFavorite(favoriteIcon.dataset.slug, e);
                } else if (option) {
                  this.selectOption(option.dataset.value);
                }
              });

              // Close dropdown when clicking outside
              document.addEventListener('click', (e) => {
                if (!this.element.contains(e.target)) {
                  this.closeDropdown();
                }
              });

              // Keyboard navigation
              this.element.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && this.isOpen) {
                  this.closeDropdown();
                }
              });
            }

            toggleDropdown() {
              this.isOpen ? this.closeDropdown() : this.openDropdown();
            }

            openDropdown() {
              this.isOpen = true;
              this.trigger.classList.add('open');
              this.dropdown.classList.add('open');
            }

            closeDropdown() {
              this.isOpen = false;
              this.trigger.classList.remove('open');
              this.dropdown.classList.remove('open');
            }

            selectOption(value) {
              this.selectOptionInternal(value);
              this.renderOptions();
              this.closeDropdown();
            }
          }

          // Initialize when DOM is ready
          function initCustomSelect() {
            const originalSelect = document.getElementById('course-select');
            const customSelect = document.getElementById('custom-course-select');

            if (originalSelect && customSelect) {
              // Small delay to ensure other DOMContentLoaded listeners have run first
              setTimeout(() => {
                new CustomSelect(customSelect, originalSelect);
              }, 10);
            }
          }

          // Check if DOM is already loaded
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCustomSelect);
          } else {
            initCustomSelect();
          }
        })();
      </script>
    </div>

