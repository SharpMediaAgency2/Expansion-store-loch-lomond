    <script>
      (function () {
        'use strict';

        var overlay = document.getElementById('logo-zoom-overlay');
        var modal = document.getElementById('logo-zoom-modal');
        if (!overlay || !modal) return;

        // Keep modal at document root so fixed positioning is never clipped
        if (overlay.parentElement !== document.body) document.body.appendChild(overlay);
        if (modal.parentElement !== document.body) document.body.appendChild(modal);

        var img = modal.querySelector('.logo-zoom-modal__img');
        var closeBtn = modal.querySelector('.logo-zoom-modal__close');
        var lastFocus = null;

        function openLogoZoom(src, alt) {
          if (!src) return;
          lastFocus = document.activeElement;
          img.src = src;
          img.alt = alt || 'Club logo';
          overlay.hidden = false;
          modal.hidden = false;
          overlay.setAttribute('open', '');
          modal.setAttribute('open', '');
          document.body.style.overflow = 'hidden';
          modal.focus();
        }

        function closeLogoZoom() {
          overlay.removeAttribute('open');
          modal.removeAttribute('open');
          overlay.hidden = true;
          modal.hidden = true;
          img.removeAttribute('src');
          img.alt = '';
          document.body.style.overflow = '';
          if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
        }

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('.logo-zoom-btn');
          if (!btn) return;
          e.preventDefault();
          e.stopPropagation();
          openLogoZoom(btn.getAttribute('data-logo-zoom-src'), btn.getAttribute('data-logo-zoom-alt'));
        });

        closeBtn?.addEventListener('click', closeLogoZoom);
        overlay.addEventListener('click', closeLogoZoom);

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && modal.hasAttribute('open')) closeLogoZoom();
        });
      })();
    </script>

    <script>
      (function () {
        'use strict';

        var MQ = window.matchMedia('(max-width: 749px)');
        var overlayHost = null;
        var movedEl = null;
        var homeParent = null;
        var homeNext = null;

        function ensureHost() {
          if (overlayHost && document.body.contains(overlayHost)) return overlayHost;
          var media =
            document.querySelector('product-info .f-product__media-viewer [data-media-viewer]') ||
            document.querySelector('product-info .f-product__media-viewer') ||
            document.querySelector('.f-product__media-viewer [data-media-viewer]') ||
            document.querySelector('.f-product__media-wrapper');
          if (!media) return null;
          var cs = window.getComputedStyle(media);
          if (cs.position === 'static') media.style.position = 'relative';
          overlayHost = document.createElement('div');
          overlayHost.id = 'logo-swatch-overlay';
          overlayHost.className = 'logo-swatch-overlay';
          overlayHost.setAttribute('aria-label', 'Select a logo');
          media.appendChild(overlayHost);
          return overlayHost;
        }

        function destroyHost() {
          if (overlayHost && overlayHost.parentNode) overlayHost.parentNode.removeChild(overlayHost);
          overlayHost = null;
        }

        function getVisibleSelectLogos() {
          var visibleField = document.querySelector('.course-logos[aria-hidden="false"]');
          if (visibleField) {
            var logos = visibleField.querySelector('.select-logos');
            if (logos) return logos;
          }

          var fields = document.querySelectorAll('.course-logos');
          for (var i = 0; i < fields.length; i++) {
            var field = fields[i];
            if (field.style.display === 'none') continue;
            if (window.getComputedStyle(field).display === 'none') continue;
            var el = field.querySelector('.select-logos');
            if (el) return el;
          }
          return null;
        }

        function updateScrollClass(el) {
          if (!el) return;
          var count = el.querySelectorAll(':scope > .variant-picker__option').length;
          if (!count) count = el.querySelectorAll('.variant-picker__option').length;
          el.setAttribute('data-logo-count', String(count));
          el.classList.toggle('select-logos--scrollable', count >= 4);
        }

        function restoreHome() {
          if (!movedEl || !homeParent) return;
          if (homeNext && homeNext.parentNode === homeParent) {
            homeParent.insertBefore(movedEl, homeNext);
          } else {
            homeParent.appendChild(movedEl);
          }
          homeParent.classList.remove('logo-box--swatches-moved');
          movedEl = null;
          homeParent = null;
          homeNext = null;
        }

        function moveToOverlay() {
          var host = ensureHost();
          var logos = getVisibleSelectLogos();
          if (!host || !logos) return;

          // Already correctly placed
          if (movedEl === logos && logos.parentElement === host) {
            updateScrollClass(logos);
            return;
          }

          restoreHome();

          homeParent = logos.parentElement;
          homeNext = logos.nextSibling;
          movedEl = logos;
          host.appendChild(logos);
          if (homeParent) homeParent.classList.add('logo-box--swatches-moved');
          updateScrollClass(logos);
        }

        function sync() {
          if (MQ.matches) {
            moveToOverlay();
          } else {
            restoreHome();
            destroyHost();
          }
        }

        // Re-sync after club/logo visibility changes
        document.addEventListener('change', function (e) {
          if (!e.target) return;
          if (e.target.id === 'course-select' || e.target.name === 'properties[Logo]') {
            setTimeout(sync, 30);
          }
        });

        var observer = new MutationObserver(function () {
          if (!MQ.matches) return;
          setTimeout(sync, 30);
        });

        function observeLogos() {
          document.querySelectorAll('.course-logos').forEach(function (el) {
            observer.observe(el, { attributes: true, attributeFilter: ['style', 'aria-hidden', 'class'] });
          });
        }

        if (MQ.addEventListener) MQ.addEventListener('change', sync);
        else if (MQ.addListener) MQ.addListener(sync);

        function init() {
          observeLogos();
          sync();
          // Club select / logo visibility often settles after other PDP scripts
          setTimeout(sync, 200);
          setTimeout(sync, 800);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
    </div>
{% endif %}


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const addToCartBtn = document.querySelector('.btn-add-to-cart');
    const altAddToCartBtn = document.querySelector('.f-product-form__submit');
    const clubSelect = document.getElementById('course-select');
    const productForm = document.querySelector('form[action^="/cart"]');

    // Error container
    let globalError = document.createElement('div');
    globalError.classList.add('field-error');
    globalError.style.marginTop = '8px';
    globalError.style.display = 'none';
    addToCartBtn?.insertAdjacentElement('afterend', globalError);

    function toHandle(str) {
      console.log('Converting to handle:', str);
      return (str ?? '')
        .toString()
        .normalize('NFKD') // normalize unicode (e.g., ' → ')
        .replace(/\u00A0/g, ' ') // NBSP → space
        .toLowerCase()
        .replace(/['']s\b/gi, 's') // George's / George's → georges
        .replace(/[''"""'´`]/g, '') // remove remaining quotes/apostrophes
        .replace(/[^a-z0-9]+/g, '-') // non-alphanumerics → dash
        .replace(/^-+|-+$/g, ''); // trim leading/trailing dashes
    }

    function clearErrors() {
      globalError.style.display = 'none';
      globalError.textContent = '';
      clubSelect.classList.remove('error-border');
      document.querySelectorAll('.course-logos').forEach((el) => {
        el.classList.remove('error-border');
      });
    }

    function isValidSelection() {
      let clubValid = clubSelect.value && clubSelect.value.trim() !== '';
      return clubValid;
    }

    function toggleButtonState() {
      if (isValidSelection()) {
        addToCartBtn.classList.remove('disabled');
        addToCartBtn.removeAttribute('disabled'); // ensure clickable
      } else {
        addToCartBtn.classList.add('disabled');
        addToCartBtn.setAttribute('disabled', 'disabled');
      }
    }

    function validateSelection(e) {
      clearErrors();
      if (!isValidSelection()) {
        e.preventDefault();
        let errors = [];
        if (!clubSelect.value || clubSelect.value.trim() === '') {
          errors.push('Please select a club');
          clubSelect.classList.add('error-border');
        }
        globalError.textContent = errors.join(' and ');
        globalError.style.display = 'block';
        toggleButtonState();
        return false;
      }
      toggleButtonState(); // make sure enabled before submit
      return true;
    }

    // Listen to changes
    clubSelect?.addEventListener('change', toggleButtonState);

    // Initial state
    toggleButtonState();

    // Validate on submit
    productForm?.addEventListener('submit', validateSelection);
    addToCartBtn?.addEventListener('click', validateSelection);
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const courseSelect = document.getElementById('course-select');
    const courseInput = document.getElementById('selected-course-input');
    const logoInput = document.getElementById('selected-logo-input');
    const logoUrlInput = document.getElementById('logo-url-input');
