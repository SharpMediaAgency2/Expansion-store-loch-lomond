                    <input type="hidden" name="properties[Logo]" id="selected-logo-input">
                    <input type="hidden" name="properties[_logo-url]" id="logo-url-input">
                    <input type="hidden" name="properties[Logo Position]" id="select-embroidered-input">
                    <input type="hidden" name="properties[Decoration Type]" id="select-decoration-type-input">
                  {% endif %}
                  {%- if gift_card_recipient_feature_active -%}
                    {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
                  {%- endif -%}
                  <div class="name-field">
                    {% if show_name_field %}
                      <div class="product-customization-wrapper">
                        <div class="customization-dropdown">
                          <label for="customization-type">Customization:</label>

                          <!-- Original Select (Hidden) -->
                          <select id="customization-type" name="customization-type" style="display:none">
                            <option value="" selected disabled>Select</option>
                            <option value="none">No Personalization</option>
                            <option value="add-name">Complimentary Personalization</option>
                          </select>

                          <!-- Custom Select UI -->
                          <div class="custom-select-customization" id="custom-customization-select">
                            <div class="select-trigger">
                              <span class="placeholder">Select</span>
                              <span class="arrow">
                                <svg viewBox="0 0 20 20" fill="currentColor">
                                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                </svg>
                              </span>
                            </div>
                            <div class="select-dropdown">
                              <div class="select-option" data-value="none">
                                <span class="option-text">No Personalization</span>
                              </div>
                              <div class="select-option" data-value="add-name">
                                <span class="option-text">Complimentary Personalization</span>
                              </div>
                            </div>
                          </div>
                        </div>

                        <div class="product-custom-text" style="display: none;">
                          <label for="custom-text">Add a name or message:</label>
                          <input
                            type="text"
                            id="custom-text"
                            name="properties[Custom Text]"
                            maxlength="50"
                            placeholder="Enter text here (max 50 characters)"
                            disabled
                          >
                          <span class="character-count">0/50</span>
                        </div>
                      </div>

                      <script>
                        (function () {
                          'use strict';

                          class CustomSelectCustomization {
                            constructor(element, originalSelect) {
                              this.element = element;
                              this.originalSelect = originalSelect;
                              this.options = [];
                              this.selectedValue = null;
                              this.isOpen = false;

                              this.trigger = element.querySelector('.select-trigger');
                              this.dropdown = element.querySelector('.select-dropdown');

                              this.init();
                            }

                            init() {
                              this.loadOptionsFromSelect();
                              this.setInitialValue();
                              this.bindEvents();
                            }

                            loadOptionsFromSelect() {
                              const selectOptions = this.originalSelect.querySelectorAll('option');
                              selectOptions.forEach((option) => {
                                // Skip the disabled placeholder option
                                if (option.value && !option.disabled) {
                                  this.options.push({
                                    value: option.value,
                                    label: option.textContent.trim(),
                                    selected: option.selected && !option.disabled,
                                  });
                                }
                              });
                            }

                            setInitialValue() {
                              // Don't auto-select anything, leave as placeholder
                              const triggerText = this.trigger.querySelector('span:first-child');
                              triggerText.textContent = 'Select';
                              triggerText.classList.add('placeholder');
                              this.renderOptions();
                            }

                            selectOptionInternal(value) {
                              this.options.forEach((opt) => (opt.selected = false));

                              const originalOptions = this.originalSelect.querySelectorAll('option');
                              originalOptions.forEach((opt) => opt.removeAttribute('selected'));

                              const option = this.options.find((opt) => opt.value === value);

                              if (option) {
                                option.selected = true;
                                this.selectedValue = value;
                                this.originalSelect.value = value;

                                const originalOption = Array.from(originalOptions).find((opt) => opt.value === value);
                                if (originalOption) {
                                  originalOption.setAttribute('selected', 'selected');
                                }

                                const triggerText = this.trigger.querySelector('span:first-child');
                                triggerText.textContent = option.label;
                                triggerText.classList.remove('placeholder');

                                setTimeout(() => {
                                  const changeEvent = new Event('change', { bubbles: true });
                                  this.originalSelect.dispatchEvent(changeEvent);
                                }, 0);
                              }

                              this.renderOptions();
                            }

                            renderOptions() {
                              let html = '';

                              this.options.forEach((option) => {
                                html += this.createOptionHTML(option);
                              });

                              this.dropdown.innerHTML = html;
                            }

                            createOptionHTML(option) {
                              const isSelected = this.selectedValue === option.value ? 'selected' : '';
                              return `
                              <div class="select-option ${isSelected}" data-value="${this.escapeHtml(option.value)}">
                                <span class="option-text">${this.escapeHtml(option.label)}</span>
                              </div>
                            `;
                            }

                            escapeHtml(text) {
                              const map = {
                                '&': '&amp;',
                                '<': '&lt;',
                                '>': '&gt;',
                                '"': '&quot;',
                                "'": '&#039;',
                              };
                              return text.replace(/[&<>"']/g, (m) => map[m]);
                            }

                            bindEvents() {
                              this.trigger.addEventListener('click', (e) => {
                                e.stopPropagation();
                                this.toggleDropdown();
                              });

                              this.dropdown.addEventListener('click', (e) => {
                                const option = e.target.closest('.select-option');
                                if (option) {
                                  this.selectOption(option.dataset.value);
                                }
                              });

                              document.addEventListener('click', (e) => {
                                if (!this.element.contains(e.target)) {
                                  this.closeDropdown();
                                }
                              });

                              this.element.addEventListener('keydown', (e) => {
                                if (e.key === 'Escape' && this.isOpen) {
                                  this.closeDropdown();
                                }
                              });
                            }

                            toggleDropdown() {
                              this.isOpen ? this.closeDropdown() : this.openDropdown();
                            }

                            openDropdown() {
                              this.isOpen = true;
                              this.trigger.classList.add('open');
                              this.dropdown.classList.add('open');
                            }

                            closeDropdown() {
                              this.isOpen = false;
                              this.trigger.classList.remove('open');
                              this.dropdown.classList.remove('open');
                            }

                            selectOption(value) {
                              this.selectOptionInternal(value);
                              this.closeDropdown();
                            }
                          }

                          function initCustomSelectCustomization() {
                            const originalSelect = document.getElementById('customization-type');
                            const customSelect = document.getElementById('custom-customization-select');

                            if (originalSelect && customSelect) {
                              setTimeout(() => {
                                new CustomSelectCustomization(customSelect, originalSelect);
                              }, 10);
                            }
                          }

                          if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', initCustomSelectCustomization);
                          } else {
                            initCustomSelectCustomization();
                          }

                          // Original functionality for text field
                          const dropdown = document.getElementById('customization-type');
                          const textField = document.querySelector('.product-custom-text');
                          const textInput = document.getElementById('custom-text');
                          const charCount = document.querySelector('.character-count');

                          dropdown.addEventListener('change', function () {
                            if (this.value === 'add-name') {
                              textField.style.display = 'block';
                              textInput.disabled = false;
                              textInput.setAttribute('name', 'properties[Custom Name]');
                            } else {
                              textField.style.display = 'none';
                              textInput.disabled = true;
                              textInput.value = '';
                              textInput.removeAttribute('name');
                              if (charCount) {
                                charCount.textContent = '0/50';
                              }
                            }
                          });

                          // Character counter
                          if (textInput && charCount) {
                            textInput.addEventListener('input', function () {
                              const length = this.value.length;
                              charCount.textContent = `${length}/50`;
                            });
                          }
                        })();
                      </script>

                      <style>
                        .product-customization-wrapper {
                          margin: 1rem 0;
                        }

                        .customization-dropdown {
                          margin-bottom: 1rem;
                        }

                        .customization-dropdown label,
                        .product-custom-text label {
                          display: block;
                          margin-bottom: 8px;
                          font-weight: 600;
                          font-size: 14px;
                          color: #333;
                        }

                        .product-custom-text {
                          margin-top: 1rem;
                          position: relative;
                        }

                        .product-custom-text input {
                          width: 100%;
                          padding: 12px 16px;
                          border: 1px solid #d1d5db;
                          border-radius: 6px;
                          font-size: 15px;
                          color: #333;
                          transition: all 0.2s ease;
                        }

                        .product-custom-text input:hover {
                          border-color: #9ca3af;
                        }

                        .product-custom-text input:focus {
                          outline: none;
                          border-color: #5e5e5e;
                          box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
                        }

                        .product-custom-text input::placeholder {
                          color: #6b7280;
                        }

                        .character-count {
                          display: block;
                          text-align: right;
                          font-size: 12px;
                          color: #6b7280;
                          margin-top: 4px;
                        }

                        /* Custom Select Styles */
                        .custom-select-customization {
                          position: relative;
                          width: 100%;
                        }

                        .custom-select-customization .select-trigger {
                          width: 100%;
                          padding: 12px 40px 12px 16px;
                          border: 1px solid #d1d5db;
                          border-radius: 6px;
                          background-color: white;
                          cursor: pointer;
                          display: flex;
                          align-items: center;
                          justify-content: space-between;
                          transition: all 0.2s ease;
                          font-size: 15px;
                          color: #333;
                        }

                        .custom-select-customization .select-trigger:hover {
                          outline: 1px solid #5e5e5e;
                          border-color: #5e5e5e;
                        }

                        .custom-select-customization .select-trigger.open {
                          border-color: #5e5e5e;
                          box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
                        }

                        .custom-select-customization .select-trigger .placeholder {
                          color: #6b7280;
                        }

                        .custom-select-customization .select-trigger .arrow {
                          position: absolute;
                          right: 16px;
                          pointer-events: none;
                          transition: transform 0.2s ease;
                        }

                        .custom-select-customization .select-trigger.open .arrow {
                          transform: rotate(180deg);
                        }

                        .custom-select-customization .select-trigger .arrow svg {
                          width: 16px;
                          height: 16px;
                          fill: #6b7280;
                        }

                        .custom-select-customization .select-dropdown {
                          position: absolute;
                          top: calc(100% + 4px);
                          left: 0;
                          right: 0;
                          background: white;
                          border: 1px solid #d1d5db;
                          border-radius: 6px;
                          box-shadow: 0 10px 25px rgba(0,0,0,0.1);
                          max-height: 300px;
                          overflow-y: auto;
                          z-index: 1000;
                          opacity: 0;
                          visibility: hidden;
                          transform: translateY(-10px);
                          transition: all 0.2s ease;
                        }

                        .custom-select-customization .select-dropdown.open {
                          opacity: 1;
                          visibility: visible;
                          transform: translateY(0);
                        }

                        .custom-select-customization .select-option {
                          padding: 12px 16px;
                          cursor: pointer;
                          display: flex;
                          align-items: center;
                          gap: 12px;
                          transition: background-color 0.15s ease;
                          font-size: 15px;
                          color: #333;
                        }

                        .custom-select-customization .select-option:hover {
                          background-color: #eff2ef !important;
                        }

                        .custom-select-customization .select-option:hover .option-text {
                          transition: all 0.3s;
                          font-weight: 500;
                        }

                        .custom-select-customization .select-option.selected {
                          background-color: #eff2ef !important;
                        }

                        .custom-select-customization .select-option.selected .option-text {
                          font-weight: 500;
                        }

                        .custom-select-customization .option-text {
                          flex: 1;
                        }

                        /* Scrollbar styling */
                        .custom-select-customization .select-dropdown::-webkit-scrollbar {
                          width: 8px;
                        }

                        .custom-select-customization .select-dropdown::-webkit-scrollbar-track {
                          background: #f1f1f1;
                          border-radius: 0 6px 6px 0;
                        }

                        .custom-select-customization .select-dropdown::-webkit-scrollbar-thumb {
                          background: #d1d5db;
                          border-radius: 4px;
                        }

                        .custom-select-customization .select-dropdown::-webkit-scrollbar-thumb:hover {
                          background: #9ca3af;
                        }
                      </style>
                    {% endif %}
                  </div>
