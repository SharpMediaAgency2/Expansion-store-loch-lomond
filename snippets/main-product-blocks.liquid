                          {% if descriptions[index] != blank %}
                            <p class="icon-description">{{ descriptions[index] }}</p>
                          {% endif %}
                        </div>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </collapsible-tab>
            <noscript>
              <details
                class="collapsible__item"
                {% if block.settings.default_open %}
                  open
                {% endif %}
              >
                <summary class="collapsible__button">
                  <span>Fabric and Care</span>
                  <span class="" data-collapsible-icon>
                    <svg width="2" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1.333v21.334" stroke="#C58A30" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <svg width="2" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1.333v21.334" stroke="#C58A30" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </summary>
                <div class="collapsible__content" data-content hidden>
                  <div class="collapsible__content-inner rte">
                    {{ product.metafields.custom.fabric_and_care | metafield_tag }}

                    {% assign icons = product.metafields.custom.fabric_and_care_icons_list.value %}
                    {% assign descriptions = product.metafields.custom.fabric_and_care_icons_description_list.value %}

                    {% if icons and descriptions %}
                      <div class="product-icons">
                        {% for icon in icons %}
                          {% assign index = forloop.index0 %}
                          <div class="product-icons-item">
                            <div
                              class="icon-image"
                              style="background: url({{ icon | image_url }});"
                              aria-label="{{ descriptions[index] | default: icon.filename }}"
                              role="img"
                              tabindex="0"
                            ></div>
                            {% if descriptions[index] != blank %}
                              <p class="icon-description">{{ descriptions[index] }}</p>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </details>
            </noscript>
          {% endif %}

          {% if product.metafields.custom.sizing %}
            <collapsible-tab
              class="collapsible__item no-js-hidden"
              data-block-id="collapsible-tab-{{ block.id }}"
              open="false"
            >
              <button class="collapsible__button" data-trigger>
                <span>Sizing</span>
                <span data-collapsible-icon>
                  <svg width="2" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.333v21.334" stroke="#C58A30" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <svg width="2" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.333v21.334" stroke="#C58A30" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
              <div class="collapsible__content" data-content hidden>
                <div class="collapsible__content-inner rte">
                  {{ product.metafields.custom.sizing | metafield_tag }}
                </div>
              </div>
            </collapsible-tab>
            <noscript>
              <details
                class="collapsible__item"
                {% if block.settings.default_open %}
                  open
                {% endif %}
              >
                <summary class="collapsible__button">
                  <span>Sizing</span>
                  <span class="" data-collapsible-icon>
                    <svg width="2" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1.333v21.334" stroke="#C58A30" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <svg width="2" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1.333v21.334" stroke="#C58A30" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </summary>
                <div class="collapsible__content" data-content hidden>
                  <div class="collapsible__content-inner rte">
                    {{ product.metafields.custom.sizing | metafield_tag }}
                  </div>
                </div>
              </details>
            </noscript>
          {% endif %}
        {%- when 'complementary' -%}
          <product-recommendations
            class="f-complementary-products block{% if block.settings.make_collapsible_row %} is-accordion{% else %} relative{% endif %}"
            data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.product_list_limit }}&intent=complementary"
          >
            {%- if recommendations.performed and recommendations.products_count > 0 -%}
              {%- liquid
                assign number_of_slides = recommendations.products_count | plus: 0.0 | divided_by: block.settings.products_per_page | ceil
                assign enable_slider = false
                if number_of_slides > 1 and block.settings.enable_slider
                  assign enable_slider = true
                endif
              -%}
              {% capture block_content %}
                <flickity-component
                    class="f-grid f-grid-1-cols{% if enable_slider %} flickity-enable{% endif %} {{ slide_class }}"
                    data-slider-options='{"pageDots": true, "prevNextButtons": false, "groupCells": 1, "cellSelector": ".f-complementary-products__slide", "wrapAround": true, "adaptiveHeight": true}'
                    data-slider-columns="1"
                    data-enable-slider="{{ enable_slider }}"
                    style="--pagination-width: 2.5rem;--button-size: 3.6rem;--button-size-mobile: 3.6rem;"
                >
                    {%- for i in (1..number_of_slides) -%}
                        <div class="f-complementary-products__slide w-full">
                            {%- for product in recommendations.products limit: block.settings.products_per_page offset: continue -%}
                                <div class="f-column">
                                    {% render 'product-card', 
                                        product: product, 
                                        custom_class: 'bg-secondary', 
                                        is_complementary: true, 
                                        list_layout: true,
                                        index: forloop.index,
                                        section_index: section.index,
                                        image_ratio: block.settings.image_ratio, 
                                        enable_quick_add: block.settings.enable_quick_add, 
                                        enable_quick_view: block.settings.enable_quick_view,
                                        color_schema: 'background-1',
                                        show_product_option: block.settings.pcard_show_color_swatch
                                    %}
                                </div>
                            {%- endfor -%}
                        </div>
                    {%- endfor -%}
                </flickity-component>
              {% endcapture %}
              {% if block.settings.make_collapsible_row %}
                <collapsible-tab
                  class="collapsible__item no-js-hidden"
                  data-block-id="collapsible-tab-{{ block.id }}"
                  open="true"
                >
                  <button class="collapsible__button" data-trigger>
                    {% if block.settings.icon != blank and block.settings.icon != 'none' %}
                      {% render 'icon', name: block.settings.icon %}
                    {% endif %}
                    <span>{{ block.settings.block_heading }}</span>
                    <span data-collapsible-icon>
                      <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </button>
                  <div class="collapsible__content" data-content hidden>
                    <div class="collapsible__content-inner">
                      {{ block_content }}
                    </div>
                  </div>
                </collapsible-tab>
              {% else %}
                {% unless block.settings.block_heading == blank %}
                  <h3 class="f-complementary-products__block-heading font-body-bolder h6">
                    {{ block.settings.block_heading }}
                  </h3>
                {% endunless %}
                {{ block_content }}
              {% endif %}
            {% endif %}
          </product-recommendations>
          {% if settings.pcard_show_quickview_button == false and block.settings.enable_quick_view %}
            <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
          {% endif %}
        {%- when 'inventory_status' -%}
          {%- render 'product-inventory',
            product: product,
            current_variant: current_variant,
            block: block,
            disable_default_variant: disable_default_variant
          -%}
        {%- when 'badge' -%}
          {%- liquid
            assign has_tags = false
            for tag in product.tags
              if tag contains 'tag__'
                assign has_tags = true
              endif
            endfor
          -%}
          {%- if has_tags -%}
            <div class="f-product__tags">
              {% for tag in product.tags %}
                {% if tag contains 'tag__' %}
                  {%- liquid
                    assign tag_content = tag | split: '__' | last
                    assign type = tag_content | split: '_' | first
                    assign tag_name = tag_content | split: '_' | last
                  -%}
                  <span class="f-badge f-badge--{{ type }}">
                    {{ tag_name }}
                  </span>
                {% endif %}
              {% endfor %}
            </div>
          {%- endif -%}

        {%- when 'price_title' -%}
          {%- liquid
            assign pt_rating = product.metafields['app--2519111--reviews'].review_average_rating.value
            assign pt_count = product.metafields['app--2519111--reviews'].review_count.value
          -%}
          <div
            class="f-product-single__block f-product-single__block--price-title pt-block"
            {{ block.shopify_attributes }}
          >
            <div class="pt-block__left">
              <h1 class="pt-block__title {{ block.settings.heading_size }}">{{ product.title }}</h1>
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <p class="pt-block__vendor">{{ product.vendor | link_to_vendor }}</p>
              {%- endif -%}
            </div>
            <div class="pt-block__right">
              <p class="pt-block__price">{{ product.selected_or_first_available_variant.price | money }}</p>
              {%- if block.settings.show_reviews and pt_rating != blank -%}
                <a href="#yotpo-headline-reviews">
                  <div class="pt-block__stars">
                    <span class="pt-block__star-icon">
                      <svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.5 11.2842V3.45263L9.9535 6.84632L13.6765 7.15789L10.8545 9.59158L11.696 13.1958L8.5 11.2842ZM17 6.09684L10.8885 5.58316L8.5 0L6.1115 5.58316L0 6.09684L4.6325 10.08L3.247 16L8.5 12.8589L13.753 16L12.359 10.08L17 6.09684Z" fill="#FCD34D"/>
                      </svg>
                    </span>
                    <span class="pt-block__rating-value">{{ pt_rating | round: 1 }}</span>
                    {%- if pt_count != blank -%}
                      <span class="pt-block__rating-count">({{ pt_count }})</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- endif -%}
            </div>
          </div>
          
        {%- when 'variant_picker' -%}
          {%- liquid
            assign mvp_option_name = block.settings.option_name | strip | downcase
            assign mvp_style = block.settings.picker_style
            assign mvp_show_val = block.settings.show_selected_value
            assign size_chart = product.metafields.foxtheme.size_chart
            if size_chart == blank and block.settings.size_chart_from_page != blank
              assign size_chart = pages[block.settings.size_chart_from_page].content
            endif
            assign show_size_chart = false
            if size_chart != blank
              assign show_size_chart = true
            endif
            assign size_title = block.settings.size_title
          -%}

            {%- capture size_chart_button -%}
              <modal-opener class="open-size-chart no-js-hidden" data-modal="#PopupModal-SizeChart-{{ section.id }}">
                <button class="btn--link text-sm" aria-label="{{ 'products.product.open_size_chart' | t }}">
                  <span>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <g clip-path="url(#clip0_293_933)">
                        <path d="M14.2 10.2C14.3492 10.3486 14.4675 10.5253 14.5483 10.7197C14.629 10.9142 14.6706 11.1227 14.6706 11.3333C14.6706 11.5439 14.629 11.7524 14.5483 11.9469C14.4675 12.1414 14.3492 12.318 14.2 12.4667L12.4667 14.2C12.318 14.3492 12.1414 14.4675 11.9469 14.5483C11.7524 14.629 11.5439 14.6706 11.3333 14.6706C11.1227 14.6706 10.9142 14.629 10.7197 14.5483C10.5253 14.4675 10.3486 14.3492 10.2 14.2L1.79999 5.79999C1.50036 5.49891 1.33215 5.09142 1.33215 4.66666C1.33215 4.24189 1.50036 3.83441 1.79999 3.53332L3.53332 1.79999C3.83441 1.50036 4.24189 1.33215 4.66666 1.33215C5.09142 1.33215 5.49891 1.50036 5.79999 1.79999L14.2 10.2Z" stroke="#4A5565" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9.66669 8.33333L11 7" stroke="#4A5565" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M7.66669 6.33333L9.00002 5" stroke="#4A5565" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M5.66669 4.33333L7.00002 3" stroke="#4A5565" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M11.6667 10.3333L13 9" stroke="#4A5565" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                      </g>
                      <defs>
                        <clipPath id="clip0_293_933">
                          <rect width="16" height="16" fill="white"/>
                        </clipPath>
                      </defs>
                    </svg>
                    Size Guide
                  </span>
                </button>
              </modal-opener>
            {%- endcapture -%}

          <div
            class="variant-picker"
            data-variant-picker
            data-product-id="{{ product.id }}"
            data-section="{{ section.id }}"
            data-product-handle="{{ product.handle }}"
            data-product-url="{{ product.url }}"
            data-max-options="{{ product.options_with_values.size }}"
          >
            {%- unless product.has_only_default_variant -%}
              <variant-picker
                class="no-js-hidden"
                id="variant-picker-{{ section.id }}"
                data-update-url="{{ update_browser_history }}"
              >
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_name_downcase = option.name | downcase
                    assign option_label = option.name

                    assign skip_option = false
                    if mvp_option_name != blank and option_name_downcase != mvp_option_name
                      assign skip_option = true
                    endif

                    assign size_title_downcase = size_title | downcase
                    assign is_size = false
                    if size_title_downcase contains option_name_downcase
                      assign is_size = true
                    endif

                    assign swatch_count = option.values | map: 'swatch' | compact | size
                    assign type_picker = mvp_style
                    if type_picker == blank
                      assign type_picker = block.settings.default_picker_type
                    endif

                    assign is_club_option = false
                    if option_name_downcase contains 'club'
                      assign is_club_option = true
                      assign type_picker = 'dropdown'
                    endif

                    if settings.color_swatches_enable and is_club_option == false and is_size == false
                      if settings.color_swatches_trigger != blank and type_picker == 'button'
                        assign color_swatches_trigger = settings.color_swatches_trigger | downcase | split: ','
                        assign has_color = color_swatches_trigger | where: option_name_downcase | first
                        if has_color != blank
                          assign type_picker = 'color'
                        else
                          assign type_picker = 'button'
                        endif
                      endif
                      if swatch_count > 0
                        if mvp_style == 'dropdown'
                          assign type_picker = 'swatch_dropdown'
                        elsif settings.vp_swatch_type == 'shopify'
                          assign type_picker = 'swatch'
                        elsif settings.vp_swatch_type == 'variant_image' or settings.vp_swatch_type == 'custom'
                          assign type_picker = 'color'
                        endif
                      endif
                    endif
                  -%}

                  {%- unless skip_option -%}
                    {%- comment -%}
                      ====================================================
                      SNIPPET INJECTION POINT — BEFORE OPTION
                      To inject content before a specific option, use:
                        {%- if option_name_downcase == 'color' -%}
                          {% render 'your-snippet' %}
                        {%- endif -%}
                      ====================================================
                    {%- endcomment -%}

                    {%- if option_name_downcase == 'size' -%}
                      <div id="contain-club-data"></div>
                    {%- endif -%}
                    <div class="variant-picker__field-wrapper variant-picker__field-wrapper--{{ option.name | handleize }}">
                      {%- case type_picker -%}
                        {%- when 'dropdown', 'swatch_dropdown' -%}
                          <div
                            class="variant-picker__field"
                            data-picker-field="select"
                            data-option-name="{{ option.name }}"
                          >
                            <div class="variant-picker__input variant-picker__input--dropdown">
                              <label class="form-label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                                <span class="font-semibold">{{ option_label }}:</span>
                                {%- if mvp_show_val -%}
                                  <span class="selected-value">{{ option.selected_value }}</span>
                                {%- endif -%}
                              </label>
                              <select
                                class="form-control variant-select-original"
                                id="Option-{{ section.id }}-{{ forloop.index0 }}"
                                name="options[{{ option.name | escape }}]"
                                form="{{ product_form_id }}"
                                data-option-name="{{ option.name }}"
                                data-option-index="{{ forloop.index0 }}"
                              >
                                {%- render 'product-variant-options',
                                  product: product,
                                  option: option,
                                  block: block,
                                  picker_type: type_picker
                                -%}
                              </select>
                            </div>
                          </div>

                        {%- when 'color', 'swatch' -%}
                          <div
                            class="variant-picker__field"
                            data-picker-field="radio"
                            data-option-name="{{ option.name }}"
                          >
                            <div class="js variant-picker__input variant-picker__color">
                              <label class="form__label">
                                <span class="font-semibold">{{ option_label }}:</span>
                                {%- if mvp_show_val -%}
                                  <span class="selected-value">{{ option.selected_value }}</span>
                                {%- endif -%}
                              </label>
                              <div class="variant-picker__option-values">
                                {%- render 'product-variant-options',
                                  product: product,
                                  option: option,
                                  block: block,
                                  picker_type: type_picker,
                                  color_schema: color_schema
                                -%}
                              </div>
                            </div>
                          </div>

                        {%- else -%}
                          <div
                            class="variant-picker__field"
                            data-picker-field="radio"
                            data-option-name="{{ option.name }}"
                          >
                            <div class="js variant-picker__input variant-picker__button">
                              <label class="form__label">
                                <span class="font-semibold">{{ option_label }}:</span>
                                {%- if mvp_show_val -%}
                                  <span class="selected-value">{{ option.selected_value }}</span>
                                {%- endif -%}
                              </label>
                              <div class="variant-picker__option-values">
                                {%- render 'product-variant-options',
                                  product: product,
                                  option: option,
                                  block: block,
                                  picker_type: type_picker
                                -%}
                              </div>
                            </div>
                          </div>
                      {%- endcase -%}

                      {%- if is_size and show_size_chart -%}
                        {{- size_chart_button -}}
                      {%- endif -%}
                      {%- if is_size -%}
                        <button
                          class="open-size-chart open-foxkit-sizechart btn btn--with-icon btn--plain foxkit-hidden"
                          aria-label="{{ 'products.product.open_size_chart' | t }}"
                        >
                          <span
                            ><u>{{ 'products.product.open_size_chart' | t }}</u></span
                          >
                        </button>
                      {%- endif -%}
                    </div>

                    {%- comment -%}
                      ====================================================
                      SNIPPET INJECTION POINT — AFTER OPTION
                      To inject content after a specific option, use:
                        {%- if option_name_downcase == 'size' -%}
                          {% render 'your-snippet' %}
                        {%- endif -%}
                      ====================================================
                    {%- endcomment -%}
                  {%- endunless -%}
                {%- endfor -%}

                <script type="application/json" data-selected-variant>
                  {{ product.selected_or_first_available_variant | json }}
                </script>
              </variant-picker>
            {%- endunless -%}

            <noscript class="variant-picker__noscript-wrapper-{{ section.id }}">
              <div class="form-field variant-picker__input{% if product.has_only_default_variant %} hidden{% endif %}">
                <label class="form-label" for="Variants-{{ section.id }}">
                  {{- 'products.product.product_variants' | t -}}
                </label>
                <select name="id" id="Variants-{{ section.id }}" class="form-control" form="{{ product_form_id }}">
                  {%- for variant in product.variants -%}
                    <option
                      {% if variant == product.selected_or_first_available_variant %}
                        selected="selected"
                      {% endif %}
                      {% if variant.available == false %}
                        disabled
                      {% endif %}
                      value="{{ variant.id }}"
                    >
                      {{ variant.title }}
                      {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                      - {{ variant.price | money | strip_html }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            </noscript>

            {%- if show_size_chart -%}
              {%- assign modal_id = 'SizeChart-' | append: section.id -%}
              <modal-dialog id="PopupModal-{{ modal_id }}" class="f-modal hidden" style="--modal-width:800px">
                <div class="f-modal__content" role="dialog" aria-modal="true" tabindex="-1">
                  <div class="scroll-container">
                    <button
                      id="ModalClose-{{ modal_id }}"
                      type="button"
                      class="f-modal__close"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{ 'icon-close.svg' | inline_asset_content }}
                    </button>
                    <div class="f-modal__inner">
                      <div class="rte py-md px-sm">{{ size_chart }}</div>
                    </div>
                  </div>
                </div>
              </modal-dialog>
            {%- endif -%}
          </div>

        {% else %}
      {%- endcase -%}
    </div>
  {%- endfor -%}
</div>

<script type="text/javascript">
  function mvpHandleChange(el, optionIndex, val) {
    val = val || el.value;
    // Update active state
    const block = el.closest('.mvp-block');
    block.querySelectorAll('.mvp-btn, .variant-picker__option-item').forEach((b) => b.classList.remove('is-active'));
    el.closest('.mvp-btn, .variant-picker__option-item')?.classList.add('is-active');
    // Update label value
    const valEl = block.querySelector('[data-mvp-val]');
    if (valEl) valEl.textContent = ': ' + val;
    // Sync with the hidden variant picker select (Dawn/Foxecom pattern)
    const picker = document.querySelector('variant-picker');
    if (picker) {
      const selects = picker.querySelectorAll('select, input[type="radio"]');
      selects.forEach((input) => {
        const name = input.name || '';
        if (name.includes('option' + (optionIndex + 1)) || input.dataset.optionIndex == optionIndex) {
          input.value = val;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    }
  }
  function mvpHandleDropdown(select, optionIndex) {
    mvpHandleChange(select, optionIndex, select.value);
  }
</script>
