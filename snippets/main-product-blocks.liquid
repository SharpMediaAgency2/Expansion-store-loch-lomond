                      id="pdp-wishlist-{{ product.id }}"
                      data-product-id="{{ product.handle }}"
                      aria-label="Add to wishlist"
                    ></button>
                    <script>
                      (function () {
                        var btn = document.getElementById('pdp-wishlist-{{ product.id }}');
                        if (!btn) return;
                        var handle = btn.getAttribute('data-product-id');

                        var svgDefault =
                          '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M19 14C20.49 12.54 22 10.79 22 8.5C22 7.04131 21.4205 5.64236 20.3891 4.61091C19.3576 3.57946 17.9587 3 16.5 3C14.74 3 13.5 3.5 12 5C10.5 3.5 9.26 3 7.5 3C6.04131 3 4.64236 3.57946 3.61091 4.61091C2.57946 5.64236 2 7.04131 2 8.5C2 10.8 3.5 12.55 5 14L12 21L19 14Z" stroke="#364153" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
                        var svgActive =
                          '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M19 14C20.49 12.54 22 10.79 22 8.5C22 7.04131 21.4205 5.64236 20.3891 4.61091C19.3576 3.57946 17.9587 3 16.5 3C14.74 3 13.5 3.5 12 5C10.5 3.5 9.26 3 7.5 3C6.04131 3 4.64236 3.57946 3.61091 4.61091C2.57946 5.64236 2 7.04131 2 8.5C2 10.8 3.5 12.55 5 14L12 21L19 14Z" stroke="#c58a30" fill="#f1e2cb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

                        function getWishlist() {
                          return JSON.parse(localStorage.getItem('wishlist')) || [];
                        }
                        function saveWishlist(list) {
                          localStorage.setItem('wishlist', JSON.stringify(list));
                        }

                        function updateBtn() {
                          var inList = getWishlist().includes(handle);
                          btn.classList.toggle('active', inList);
                          btn.setAttribute('aria-label', inList ? 'Remove from wishlist' : 'Add to wishlist');
                          while (btn.firstChild) btn.removeChild(btn.firstChild);
                          btn.insertAdjacentHTML('afterbegin', inList ? svgActive : svgDefault);
                        }

                        btn.addEventListener('click', function (e) {
                          e.preventDefault();
                          var list = getWishlist();
                          if (list.includes(handle)) {
                            saveWishlist(
                              list.filter(function (h) {
                                return h !== handle;
                              })
                            );
                          } else {
                            list.push(handle);
                            saveWishlist(list);
                          }
                          updateBtn();
                          document.querySelectorAll('.wishlist-counter').forEach(function (el) {
                            el.textContent = getWishlist().length;
                          });
                        });

                        updateBtn();
                      })();
                    </script>
                    <style type="text/css">
                      .pdp-wishlist-btn {
                        height: 58px;
                        border: 1px solid #D1D5DC !important;
                      }
                    </style>
