{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class
  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign columns = section.settings.columns
  assign columns_mobile = section.settings.columns_mobile

  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif
-%}

<style>
  #{{ section_id }} {
    background-color: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} .sbc-header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: 40px;
  }

  #{{ section_id }} .sbc-heading {
    margin: 0 0 12px;
  }

  #{{ section_id }} .sbc-description {
    margin: 0 auto;
    max-width: 680px;
    color: #6B7280;
    font-size: 15px;
    line-height: 1.65;
  }

  #{{ section_id }} .sbc-grid {
    display: grid;
    grid-template-columns: repeat({{ columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  /* ── Card ── */
  #{{ section_id }} .sbc-card {
    position: relative;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: {{ section.settings.card_ratio }};
    background: #111;
  }

  /* Base image */
  #{{ section_id }} .sbc-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter 0.55s ease;
    will-change: transform, filter;
  }

  /* Permanent subtle dark overlay so title is always readable */
  #{{ section_id }} .sbc-card__base-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.65) 0%,
      rgba(0,0,0,0.15) 50%,
      rgba(0,0,0,0.05) 100%
    );
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  /* Title visible by default */
  #{{ section_id }} .sbc-card__title {
    position: absolute;
    top: 50%;
    left: 24px;
    right: 24px;
    transform: translateY(-50%);
    z-index: 2;
    color: #fff;
    font-weight: 500;
    line-height: 1.3;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.3;
    margin: 0 0 10px;
    font-family:'Noto Serif';
    font-weight: 400;
    font-size: 36px;
    line-height: 40px;
    letter-spacing: 0px;
    text-align: center;
    margin: 0;
    text-align: center;
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* ── Hover reveal panel ── */
  #{{ section_id }} .sbc-card__reveal {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 28px 28px;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0) 100%);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
  }

  #{{ section_id }} .sbc-card__reveal-title {
    color: #fff;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.3;
    margin: 0 0 10px;
    font-family:'Noto Serif';
    font-weight: 400;
    font-style: Regular;
    font-size: 36px;
    leading-trim: NONE;
    line-height: 40px;
    letter-spacing: 0px;
    text-align: center;

  }

  #{{ section_id }} .sbc-card__reveal-desc {
    color: #E5E7EB;
    font-size: clamp(14px,2vw, 16px);
    line-height: 1.6;
    margin: 0 0 20px;
  }

  #{{ section_id }} .sbc-card__reveal-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.5);
    padding-bottom: 2px;
    width: fit-content;
    margin: 0 auto;
    transition: border-color 0.2s ease, gap 0.2s ease;
  }

  #{{ section_id }} .sbc-card__reveal-btn:hover {
    border-color: #fff;
    gap: 10px;
  }

  /* ── Hover state ── */
  #{{ section_id }} .sbc-card:hover .sbc-card__img {
    transform: scale(1.06);
    filter: brightness(0.75);
  }

  #{{ section_id }} .sbc-card:hover .sbc-card__base-overlay {
    opacity: 0;
  }

  #{{ section_id }} .sbc-card:hover .sbc-card__title {
    opacity: 0;
    transform: translateY(calc(-50% + 6px));
  }

  #{{ section_id }} .sbc-card:hover .sbc-card__reveal {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    #{{ section_id }} .sbc-grid {
      grid-template-columns: repeat({{ columns_mobile }}, 1fr);
      gap: {{ section.settings.gap | divided_by: 2 | at_least: 10 }}px;
    }

    #{{ section_id }} .sbc-card {
      aspect-ratio: 4 / 3;
    }

    /* On mobile, always show reveal panel (no hover) */
    #{{ section_id }} .sbc-card .sbc-card__title {
      display: none;
    }

    #{{ section_id }} .sbc-card .sbc-card__reveal {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    #{{ section_id }} .sbc-card .sbc-card__img {
      filter: brightness(0.7);
    }

    #{{ section_id }} .sbc-card .sbc-card__base-overlay {
      opacity: 0;
    }
  }
</style>

<section
  id="{{ section_id }}"
  class="shop-by-collection{{ custom_class }}"
  data-section-id="{{ section.id }}"
  data-section-type="shop-by-collection"
>
  <div class="container">

    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="sbc-header">
        {%- if section.settings.heading != blank -%}
          <motion-element data-motion="{{ animation_effect }}" data-motion-delay="0" class="block">
            <{{ section.settings.heading_tag }} class="sbc-heading {{ section.settings.heading_size }}">
              {%- render 'highlight-text',
                hl_text: section.settings.heading,
                hl_style: section.settings.highlight_style,
                enable_hl_text_color: section.settings.enable_highlight_text_color
              -%}
            </{{ section.settings.heading_tag }}>
          </motion-element>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <motion-element data-motion="{{ animation_effect }}" data-motion-delay="50" class="block">
            <div class="sbc-description">{{ section.settings.description }}</div>
          </motion-element>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sbc-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_card' -%}
          {%- assign card_link = block.settings.link -%}
          <motion-element
            data-motion="{{ animation_effect }}"
            data-motion-delay="{{ forloop.index | times: 60 }}"
            class="block"
            {{ block.shopify_attributes }}
          >
            <div class="sbc-card">

              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'sbc-card__img',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000',
                    sizes: '(max-width: 767px) 100vw, 33vw',
                    alt: block.settings.image.alt | default: block.settings.title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'sbc-card__img' }}
              {%- endif -%}

              <div class="sbc-card__base-overlay"></div>

              {%- if block.settings.title != blank -%}
                <p class="sbc-card__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}

              <div class="sbc-card__reveal">
                {%- if block.settings.title != blank -%}
                  <p class="sbc-card__reveal-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="sbc-card__reveal-desc">{{ block.settings.description | escape }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a
                    class="sbc-card__reveal-btn"
                    {% if card_link != blank %}href="{{ card_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  >
                    {{ block.settings.button_label | escape }}
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {%- endif -%}
              </div>

            </div>
          </motion-element>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shop by Collection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "t:sections.common.highlight_text.settings.highlight_style.label",
      "options": [
        { "value": "none", "label": "t:sections.common.highlight_text.settings.highlight_style.option__1" },
        { "value": "drawer_line", "label": "t:sections.common.highlight_text.settings.highlight_style.option__2" },
        { "value": "underline", "label": "t:sections.common.highlight_text.settings.highlight_style.option__3" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "enable_highlight_text_color",
      "label": "t:sections.common.highlight_text.settings.enable_highlight_text_color.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.title_tag.heading.label",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.common.text_size.heading.label",
      "default": "h2",
      "options": [
        { "value": "h3", "label": "t:sections.common.text_size.options__h3.label" },
        { "value": "h2", "label": "t:sections.common.text_size.options__h2.label" },
        { "value": "h1", "label": "t:sections.common.text_size.options__h1.label" },
        { "value": "h0", "label": "t:sections.common.text_size.options__h0.label" }
      ]
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description / Subheading"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Card Aspect Ratio",
      "default": "3 / 4",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "2 / 3", "label": "Tall (2:3)" }
      ]
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:sections.common.section_padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.section_padding.top_padding.label",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.section_padding.bottom_padding.label",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:sections.common.custom_attr.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.common.custom_attr.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.custom_attr.custom_class"
    },
    {
      "type": "header",
      "content": "t:settings_schema.animations.header.content"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "t:settings_schema.animations.header__2.content",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "t:settings_schema.animations.settings.animation.options.option_6" },
        { "value": "fade-in", "label": "t:settings_schema.animations.settings.animation.options.option_2" },
        { "value": "fade-in-up", "label": "t:settings_schema.animations.settings.animation.options.option_3" },
        { "value": "fade-in-left", "label": "t:settings_schema.animations.settings.animation.options.option_4" },
        { "value": "fade-in-right", "label": "t:settings_schema.animations.settings.animation.options.option_5" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection Name"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Hover Description",
          "info": "Shown when the card is hovered. Keep it 1–2 sentences."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Explore Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Collection",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "The Royal ST. George´s Online Exclusives",
            "description": "Premium pieces designed exclusively for our partner clubs. Available only to members and their guests.",
            "button_label": "Explore Collection"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Championship Layers",
            "description": "Performance outerwear engineered for links conditions. Wind, rain, and cold — handled.",
            "button_label": "Explore Collection"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Signature Polos",
            "description": "Classic fit polos bearing the Royal St. George's crest. The mark of membership.",
            "button_label": "Explore Collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
