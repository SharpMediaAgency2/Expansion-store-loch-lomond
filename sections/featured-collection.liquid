<link
  id="ModalComponent"
  rel="stylesheet"
  href="{{ 'modal-component.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign enable_slider = section.settings.enable_slider
  assign collection = collections[section.settings.collection]
  assign product_to_show = section.settings.limit | default: 8
  assign button_label = section.settings.button_label

  assign image_ratio = section.settings.pcard_image_ratio
  assign show_vendor = section.settings.show_vendor
  assign columns = section.settings.columns

  assign enable_swipe_mobile = section.settings.enable_swipe_mobile

  assign show_nav = section.settings.show_nav
  assign show_dots = section.settings.show_dots
  assign button_style = section.settings.button_style
  assign button_label = section.settings.button_label

  assign show_all_button_on_top = section.settings.show_all_button_on_top

  assign columns_tablet = columns
  if columns > 3 and request.design_mode == false
    assign columns_tablet = columns | divided_by: 2.0 | ceil | at_least: 3
  endif

  assign motion_delay = 0
  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif
  if section.settings.heading != blank
    assign motion_delay = motion_delay | plus: 50
  endif
  if section.settings.subheading != blank
    assign motion_delay = motion_delay | plus: 50
  endif
  if section.settings.description != blank
    assign motion_delay = motion_delay | plus: 50
  endif
  if button_label != blank and show_all_button_on_top
    assign motion_delay = motion_delay | plus: 50
  endif
-%}
{% if section.settings.disable_logo_overlay == true %}
  <style type="text/css">
  #{{ section_id }} .logo-overlay{
    display:none!important; 
  }
  </style>
{% endif %}{% assign course_handle =  metaobject.title | handle %}

{% if course_handle.size < 2 %}
  {% assign course_handle =  page.metafields.custom.selected_course.value.title | handle %}  
{% endif %}

<section
  id="{{ section_id }}"
  data-section-type="featured-collection"
  data-section-id="{{ section.id }}"
  class="featured-collection{{ custom_class }} f-section-padding color-{{ section.settings.color_schema }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {% render 'index-section-header-splitted',
      section_settings: section.settings,
      button_visible: show_all_button_on_top,
      button_link: collection.url,
      button_style: button_style,
      button_label: button_label,
      animation_effect: animation_effect
    %}
    <grid-list
      data-motion="{{ animation_effect }}"
      class="block"
    >
      <flickity-component
        class="f-grid f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }} f-grid-{{ section.settings.column_mobile }}-cols md:f-grid-{{ columns_tablet }}-cols lg:f-grid-{{ columns }}-cols flickity-disable{% if enable_slider %} md:flickity-enable{% endif %}{% if enable_swipe_mobile %} f-swiper f-swiper--no-scrollbar f-swiper--{{ section.settings.column_mobile }}-cols{% endif %}"
        data-slider-options='{"pageDots": {{ show_dots }}, "prevNextButtons": {{ show_nav }}, "groupCells": true, "watchCSS": true, "cellSelector": ".f-column", "wrapAround": true, "percentPosition": false, "freeScroll": false}'
        data-slider-columns="{{ columns }}"
        data-slider-columns-tablet="{{ columns_tablet }}"
        data-enable-slider="{{ enable_slider }}"
        data-calc-button-position="true"
        data-products-container
      >
        {% if collection != blank %}
          {% for product in collection.products limit: product_to_show %}
            <div class="f-column">
              {% render 'product-card',
                color_schema: section.settings.color_schema,
                product: product,
                course_handle: course_handle,
                image_ratio: image_ratio,
                show_vendor: show_vendor,
                section_index: section.index,
                enable_swatches: section.settings.enable_swatch_colors,
                index: forloop.index
              %}
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..product_to_show) %}
            <div class="f-column">
              {% render 'product-card-placeholder', index: forloop.index %}
            </div>
          {% endfor %}
        {% endif %}
      </flickity-component>
    </grid-list>
    {%- if button_label != blank and show_all_button_on_top == false -%}
      <motion-element
        data-motion="{{ animation_effect }}"
        data-motion-delay="{{ motion_delay }}"
        class="section__footer flex justify-center"
      >
        <a class="btn {{ button_style }}" href="{{ collection.url }}">
          {{- button_label -}}
        </a>
      </motion-element>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
