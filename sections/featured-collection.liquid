    },
    {
      "type": "checkbox",
      "id": "enable_highlight_text_color",
      "label": "t:sections.common.highlight_text.settings.enable_highlight_text_color.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:sections.common.title_tag.heading.label",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.common.title_tag.options__h1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.common.title_tag.options__h2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.common.title_tag.options__h3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.common.title_tag.options__h4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.common.title_tag.options__h5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.common.title_tag.options__h6.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:sections.common.text_size.heading.label",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.common.text_size.options__h3.label"
        },
        {
          "value": "h2",
          "label": "t:sections.common.text_size.options__h2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.common.text_size.options__h1.label"
        },
        {
          "value": "h0",
          "label": "t:sections.common.text_size.options__h0.label"
        },
        {
          "value": "h-xl",
          "label": "t:sections.common.text_size.options__hd1.label"
