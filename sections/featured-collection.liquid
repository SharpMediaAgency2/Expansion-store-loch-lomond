    {
      "type": "checkbox",
      "id": "disable_logo_overlay",
      "label": "Disable Logo Overlay",
      "default": false,
      "info": "Enable it, if you do not want logo overlay on this section."
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header.content"
    },
    {
      "type": "select",
      "id": "pcard_image_ratio",
      "label": "t:settings_schema.global.settings.image_aspect_ratio_options.label",
      "default": "",
