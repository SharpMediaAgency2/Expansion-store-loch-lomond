{%- if predictive_search.performed and predictive_search.resources.pages.size > 0 -%}
  {%- capture club_cards -%}
    {%- for page in predictive_search.resources.pages -%}
      {%- if page.metafields.custom.club_page.value == true -%}
        {%- assign club = page.metafields.custom.selected_course.value -%}
        <div class="f-column">
          <a href="{{ page.url }}" class="f-card">
            <div class="f-card__inner">
              <div class="f-card__content">
                <div class="f-club-logo">
                  {%- if club.display_logo != blank -%}
                    {{ club.display_logo | image_url: width: 200 | image_tag }}
                  {%- endif -%}
                </div>
                <h3 class="text-product-title h5">{{ page.title | escape }}</h3>
              </div>
            </div>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if club_cards contains 'f-card' -%}
    <div class="search-pages-strip">
      <h2 class="h2 clubs-title-heading">Clubs</h2>
      <div class="template-search__pages product-grid" data-pages-grid>
        {{ club_cards }}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{ "name": "Predictive Pages" }
{% endschema %}