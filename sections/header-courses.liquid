{%- liquid
  assign view_all_text = section.settings.view_all_text
  assign view_all_url = section.settings.view_all_url
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign location_metafield_key = section.settings.location_metafield_key
  assign badge_metafield_key = section.settings.badge_metafield_key
-%}

<div class="fc-section" data-section-id="{{ section.id }}">

  <!-- Section Header -->
  <div class="fc-header">
    <div class="fc-header__left">
      <h2 class="fc-header__title">{{ heading }}</h2>
      {%- if subheading != blank -%}
        <p class="fc-header__sub">{{ subheading }}</p>
      {%- endif -%}
    </div>
    {%- if view_all_text != blank and view_all_url != blank -%}
      <a href="{{ view_all_url }}" class="fc-header__viewall">
        {{ view_all_text }}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {%- endif -%}
  </div>

  <!-- Cards Grid -->
  <div class="fc-grid" id="fc-grid-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'course' -%}
        {%- assign course = block.settings.course -%}
        {%- if course != blank -%}
          {%- assign course_handle = course.title.value | handleize -%}
          {%- assign course_title = course.display_title.value -%}
          {%- assign course_url = block.settings.course_url | default: course.link_header.value | default: course.system.url -%}
          {%- assign course_logo = course.display_logo.value -%}
          {%- assign block_image = block.settings.card_image -%}

          {%- comment -%} Location & badge from configurable metafield keys {%- endcomment -%}
          {%- assign course_location = '' -%}
          {%- assign course_badge = '' -%}
          {%- if location_metafield_key != blank -%}
            {%- assign course_location = course[location_metafield_key].value -%}
          {%- endif -%}
          {%- if badge_metafield_key != blank -%}
            {%- assign course_badge = course[badge_metafield_key].value -%}
          {%- endif -%}

          <div class="fc-card" data-handle="{{ course_handle }}" {{ block.shopify_attributes }}>

            <!-- Heart button sits OUTSIDE the <a> to avoid click conflict -->
            <button class="fc-card__heart" data-handle="{{ course_handle }}" aria-label="Add to favorites" type="button">
              <svg class="fc-heart-outline" viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M21.0002 8.97903C21.0002 15.2234 12.0006 20.479 12.0006 20.479C12.0006 20.479 3.00024 15.1457 3.00024 8.99169C3.00024 6.47903 5.00024 4.47903 7.50024 4.47903C10.0002 4.47903 12.0002 7.47903 12.0002 7.47903C12.0002 7.47903 14.0002 4.47903 16.5002 4.47903C19.0002 4.47903 21.0002 6.47903 21.0002 8.97903Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <svg class="fc-heart-filled" viewBox="0 0 24 25" fill="#f1e2cb" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M21.0002 8.97903C21.0002 15.2234 12.0006 20.479 12.0006 20.479C12.0006 20.479 3.00024 15.1457 3.00024 8.99169C3.00024 6.47903 5.00024 4.47903 7.50024 4.47903C10.0002 4.47903 12.0002 7.47903 12.0002 7.47903C12.0002 7.47903 14.0002 4.47903 16.5002 4.47903C19.0002 4.47903 21.0002 6.47903 21.0002 8.97903Z" stroke="#c58a30" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <a href="{{ course_url | default: '#' }}" class="fc-card__inner">

              <!-- Background image -->
              <div class="fc-card__bg">
                {%- if block_image -%}
                  <img src="{{ block_image | image_url: width: 600 }}"
                       alt="{{ course_title }}"
                       loading="lazy"
                       width="600"
                       height="400"
                       class="fc-card__bg-img">
                {%- elsif course_logo -%}
                  <div class="fc-card__logo-bg">
                    <img src="{{ course_logo | image_url: width: 200 }}"
                         alt="{{ course_title }}"
                         loading="lazy"
                         width="200"
                         height="200"
                         class="fc-card__logo-img">
                  </div>
                {%- endif -%}
              </div>

              <!-- Overlay -->
              <div class="fc-card__overlay"></div>

              <!-- Card content -->
              <div class="fc-card__content">
                <h3 class="fc-card__title">{{ course_title }}</h3>
                {%- if course_location != blank -%}
                  <p class="fc-card__location">{{ course_location }}</p>
                {%- endif -%}
                {%- if course_badge != blank -%}
                  <span class="fc-card__badge">{{ course_badge }}</span>
                {%- endif -%}
              </div>

            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  <!-- Mobile carousel dots -->
  <div class="fc-dots" id="fc-dots-{{ section.id }}"></div>

  <!-- Favorites strip -->
  <div class="fc-favorites" id="fc-favorites-{{ section.id }}">

    <!-- Empty state -->
    <div class="fc-favorites__empty" id="fc-empty-{{ section.id }}">
      <div class="fc-favorites__empty-heart">
        <svg viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M21.0002 8.97903C21.0002 15.2234 12.0006 20.479 12.0006 20.479C12.0006 20.479 3.00024 15.1457 3.00024 8.99169C3.00024 6.47903 5.00024 4.47903 7.50024 4.47903C10.0002 4.47903 12.0002 7.47903 12.0002 7.47903C12.0002 7.47903 14.0002 4.47903 16.5002 4.47903C19.0002 4.47903 21.0002 6.47903 21.0002 8.97903Z" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="fc-favorites__empty-title">Keep Your Favorites in One Place</p>
      <p class="fc-favorites__empty-sub">Save your favorite clubs for quick viewing of what’s new!</p>
      <p class="fc-favorites__empty-hint">Click the <svg viewBox="0 0 24 25" fill="none" width="14" height="14" style="vertical-align:middle;margin:0 2px"><path fill-rule="evenodd" clip-rule="evenodd" d="M21.0002 8.97903C21.0002 15.2234 12.0006 20.479 12.0006 20.479C12.0006 20.479 3.00024 15.1457 3.00024 8.99169C3.00024 6.47903 5.00024 4.47903 7.50024 4.47903C10.0002 4.47903 12.0002 7.47903 12.0002 7.47903C12.0002 7.47903 14.0002 4.47903 16.5002 4.47903C19.0002 4.47903 21.0002 6.47903 21.0002 8.97903Z" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> icon to add the club to your Favorites list</p>
    </div>

    <!-- Filled state -->
    <div class="fc-favorites__filled" id="fc-filled-{{ section.id }}" style="display:none">
      <p class="fc-favorites__label">Your favorite clubs</p>
      <div class="fc-favorites__scroll" id="fc-fav-scroll-{{ section.id }}">
        <!-- Populated by JS -->
      </div>
    </div>

  </div>
</div>

<!-- Pass block data to JS -->
<script>
(function() {
  var sectionId = {{ section.id | json }};

  // ── Build section-scoped array (used by this section's JS) ──
  // Using push() avoids trailing/missing comma issues from skipped blocks
  window['fcCourses_' + sectionId] = [];

  // ── Also populate/extend window.coursesData ──────────────────
  // This is the global used by getLogoByHandle() in theme.liquid
  // and by the logo animation priority system (Priority 1 cookie logic).
  // We merge rather than overwrite so multiple sections can coexist.
  window.coursesData = window.coursesData || [];

  {%- for block in section.blocks -%}
    {%- if block.type == 'course' -%}
      {%- assign course = block.settings.course -%}
      {%- if course != blank -%}
        {%- assign course_handle = course.title.value | handleize -%}
        {%- assign course_logo = course.display_logo.value -%}
        {%- assign location_val = '' -%}
        {%- assign badge_val = '' -%}
        {%- if location_metafield_key != blank -%}{%- assign location_val = course[location_metafield_key].value -%}{%- endif -%}
        {%- if badge_metafield_key != blank -%}{%- assign badge_val = course[badge_metafield_key].value -%}{%- endif -%}
        (function() {
          var entry = {
            handle: {{ course_handle | json }},
            title: {{ course.display_title.value | json }},
            logo: {%- if course_logo != blank -%}{{ course_logo | image_url: width: 360 | json }}{%- else -%}null{%- endif -%},
            location: {{ location_val | json }},
            badge: {{ badge_val | json }}
          };
          // Push to section array
          window['fcCourses_' + sectionId].push(entry);
          // Merge into global coursesData — avoid duplicates by handle
          var exists = window.coursesData.some(function(c) { return c.handle === entry.handle; });
          if (!exists) window.coursesData.push(entry);
        })();
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
})();
</script>

<style>
/* =====================
   FEATURED CLUBS SECTION
   ===================== */
.fc-section {
  max-width: 1400px;
  margin: 0 auto;
  padding: {{ section.settings.padding_top }}px clamp(20px, 5vw, 60px) {{ section.settings.padding_bottom }}px;
}

/* Header */
.fc-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 1rem;
}

.fc-header__left {}

.fc-header__title {
  font-size: 1.75rem;
  font-weight: 400;
  margin: 0 0 0.25rem;
  line-height: 1.2;
}

.fc-header__sub {
  font-size: 0.875rem;
  color: #666;
  margin: 0;
}

.fc-header__viewall {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.875rem;
  font-weight: 500;
  color: inherit;
  text-decoration: none;
  white-space: nowrap;
  margin-top: 4px;
  transition: opacity 0.2s;
}

.fc-header__viewall:hover {
  opacity: 0.6;
}

/* Grid */
.fc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

/* Card */
.fc-card {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 143 / 169;
}

.fc-card__inner {
  display: block;
  width: 100%;
  height: 100%;
  position: relative;
  text-decoration: none;
  color: #fff;
}

/* Background */
.fc-card__bg {
  position: absolute;
  inset: 0;
  background: #1a1a1a;
}

.fc-card__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.fc-card:hover .fc-card__bg-img {
  transform: scale(1.03);
}

/* Logo fallback bg */
.fc-card__logo-bg {
  width: 100%;
  height: 100%;
  background: #f5f5f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fc-card__logo-img {
  width: 60%;
  height: 60%;
  object-fit: contain;
}

/* Overlay — shown by default, hidden on hover */
.fc-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.05) 0%,
    rgba(0,0,0,0.25) 40%,
    rgba(0,0,0,0.72) 100%
  );
  transition: opacity 0.35s ease;
  pointer-events: none;
}

.fc-card:hover .fc-card__overlay {
  opacity: 0;
}

/* Heart button — sits outside <a>, positioned to .fc-card */
.fc-card__heart {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 32px;
  height: 32px;
  background: rgba(255,255,255,0.92);
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  padding: 0;
  transition: background 0.2s, transform 0.15s;
  backdrop-filter: blur(4px);
}

.fc-card__heart:hover {
  transform: scale(1.1);
  background: #fff;
}

.fc-card__heart svg {
  width: 16px;
  height: 16px;
}

/* Default: show outline, hide filled */
.fc-card__heart .fc-heart-outline { display: block; }
.fc-card__heart .fc-heart-filled  { display: none; }

/* Favorited: swap */
.fc-card__heart.is-favorited .fc-heart-outline { display: none; }
.fc-card__heart.is-favorited .fc-heart-filled  { display: block; }

/* Card content */
.fc-card__content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1rem;
  z-index: 5;
}

.fc-card__title {
  font-size: 0.95rem;
  font-weight: 500;
  margin: 0 0 0.2rem;
  line-height: 1.3;
  color: #fff;
}

.fc-card__location {
  font-size: 0.8rem;
  margin: 0 0 0.5rem;
  color: rgba(255,255,255,0.85);
}

.fc-card__badge {
  display: inline-block;
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,0.25);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 500;
  padding: 3px 10px;
  border-radius: 20px;
  letter-spacing: 0.02em;
}

/* Mobile carousel dots */
.fc-dots {
  display: none;
  justify-content: center;
  gap: 6px;
  margin-top: 14px;
}

.fc-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ccc;
  border: none;
  padding: 0;
  cursor: pointer;
  transition: background 0.2s;
}

.fc-dot.active {
  background: #333;
}

/* =====================
   FAVORITES STRIP
   ===================== */
.fc-favorites {
  margin-top: 2rem;
  background: #f7f7f5;
  border-radius: 12px;
  padding: 2.5rem 1.5rem 2rem;
  text-align: center;
  overflow: visible;
}

/* Empty state */
.fc-favorites__empty-heart {
  display: flex;
  justify-content: center;
  margin-bottom: 0.75rem;
}

.fc-favorites__empty-heart svg {
  width: 32px;
  height: 32px;
}

.fc-favorites__empty-title {
  font-size: 1rem;
  font-weight: 500;
  margin: 0 0 0.35rem;
}

.fc-favorites__empty-sub {
  font-size: 0.82rem;
  color: #888;
  margin: 0 0 0.25rem;
}

.fc-favorites__empty-hint {
  font-size: 0.8rem;
  color: #aaa;
  margin: 0;
}

/* Filled state */
.fc-favorites__filled {
  text-align: left;
  overflow: visible;
}

.fc-favorites__label {
  font-size: 1rem;
  font-weight: 500;
  margin: 0 0 1.25rem;
}

/* Scroll row — free horizontal scroll */
.fc-favorites__scroll {
  display: flex;
  flex-direction: row;
  gap: 1rem;
  overflow-x: auto;
  overflow-y: visible;
  padding: 14px 0 0.75rem;
  align-items: flex-start;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.fc-favorites__scroll::-webkit-scrollbar {
  display: none;
}

/* Fav club item — square ~180px, ~6 per row */
.fc-fav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  flex-shrink: 0;
  text-decoration: none;
  color: inherit;
  position: relative;
  width: 180px;
  transition: opacity 0.2s;
}

.fc-fav-item:hover {
  opacity: 0.75;
}

/* Square white box */
.fc-fav-item__box {
  width: 180px;
  height: 180px;
  background: #fff;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 6px rgba(0,0,0,0.07);
  position: relative;
}

.fc-fav-item__box img {
  width: 70%;
  height: 70%;
  object-fit: contain;
}

/* Gold heart — floats top-right outside the box, clickable to unfavorite */
.fc-fav-item__heart {
  position: absolute;
  top: -10px;
  right: -6px;
  width: 26px;
  height: 26px;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s, opacity 0.2s;
  z-index: 2;
}

.fc-fav-item__heart:hover {
  transform: scale(1.2);
  opacity: 0.75;
}

.fc-fav-item__heart svg {
  width: 22px;
  height: 22px;
  fill: #f1e2cb;
}

.fc-fav-item__heart svg path {
  stroke: #c58a30;
  stroke-width: 1.5;
}

/* Name below box */
.fc-fav-item__name {
  font-size: 0.875rem;
  text-align: center;
  line-height: 1.3;
  color: #222;
}

/* =====================
   RESPONSIVE
   ===================== */
@media (max-width: 1024px) and (min-width: 769px) {
  .fc-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .fc-section {
    padding: {{ section.settings.padding_top }}px 1rem {{ section.settings.padding_bottom }}px;
  }

  .fc-header__title {
    font-size: 1.4rem;
  }

  /* Mobile: 2-col carousel */
  .fc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    /* Carousel: show 1 page (4 cards = 2x2) at a time */
    overflow: hidden;
  }

  .fc-card {
    aspect-ratio: 1 / 1.15;
  }

  .fc-dots {
    display: flex;
  }

  .fc-favorites {
    padding: 1.5rem 1rem;
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    FeaturedClubs.init({{ section.id | json }});
  });
</script>

{% schema %}
{
  "name": "Featured Clubs",
  "tag": "section",
  "class": "section-featured-clubs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Clubs"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop exclusive collections from iconic courses"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "info": "Leave blank to hide"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All Link URL"
    },
    {
      "type": "text",
      "id": "location_metafield_key",
      "label": "Location Metafield Key",
      "info": "e.g. location — the metafield key on the course metaobject that holds the location string. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "badge_metafield_key",
      "label": "Badge Metafield Key",
      "info": "e.g. order or badge — the metafield key used for the badge label (e.g. 'Top 1'). Leave blank to hide."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "course",
      "name": "Course Card",
      "settings": [
        {
          "type": "metaobject",
          "id": "course",
          "label": "Course",
          "metaobject_type": "courses"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Background Image",
          "info": "If not set, the course display logo will be used as fallback."
        },
        {
          "type": "url",
          "id": "course_url",
          "label": "Override Link URL",
          "info": "Optional. Overrides the course metaobject URL."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Clubs"
    }
  ]
}
{% endschema %}
