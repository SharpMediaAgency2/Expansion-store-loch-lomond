{% comment %}theme-check-disable TemplateLength{% endcomment %}
{{ 'product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign enable_image_zoom = section.settings.enable_image_zoom | default: false

  assign first_3d_model = product.media | where: 'media_type', 'model' | first

  assign enable_variant_group_image = false
  if product.metafields['foxecom-bs-kit']['variant-images'].value.enable and product.has_only_default_variant == false
    assign enable_variant_group_image = true
  endif

  assign variant_picker_block = section.blocks | where: 'type', 'variant_picker' | first
  assign disable_default_variant = variant_picker_block.settings.variant_picker_dont_select_the_default_variant
  
-%}
{%- if first_3d_model -%}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}
<link
  id="ModalComponent"
  rel="stylesheet"
  href="{{ 'modal-component.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
{%- if product.quantity_price_breaks_configured? -%}
  {{ 'volume-pricing.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'volume-pricing.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if enable_image_zoom -%}
  <link
    rel="stylesheet"
    href="{{ 'photoswipe-component.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}
{%- liquid
  assign media_size = section.settings.media_size
  assign enable_sticky_info = section.settings.enable_sticky_info

  assign animation_effect = settings.animations
-%}
{%- if section.settings.show_breadcrumb -%}
  {%- render 'breadcrumb',
    justify: 'center'
  -%}
{%- endif -%}

<style>
  /* ── Price+Title block ── */
  .pt-block {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
  }
  .pt-block__left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }
  .pt-block__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
  }
  .variant-picker__input input[type="radio"]:checked + label, .variant-picker__input input[type="radio"] + label:hover{
  color:black;}
  .pt-block__title {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: 3rem;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground);
  }
  .pt-block__vendor {
    font-size: 1.4rem;
    color: var(--color-foreground-secondary, #6b7280);
    letter-spacing: 0.05em;
    margin: 0;
  }
  .pt-block__vendor a {
    color: inherit;
    text-decoration: none;
  }
  .pt-block__vendor a {
    font-size: 18px !important;
    color: #4A5565 !important;
    letter-spacing: 0px;
  }
  .variant-picker__field[data-option-name="Color"] span.selected-value {
  display: inline;
  padding-left: 3px;
  font-weight: 500 !important;
  color: #4A5565;
}
  .btn-add-to-cart {
  height: 58px;
  font-weight: 500;
}
  .pt-block__price {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1.1;
    color: var(--color-foreground);
    margin: 0;
  }
  .pt-block__stars {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 1.3rem;
    color: var(--color-foreground-secondary, #6b7280);
  }
  .pt-block__stars .pt-block__star-icon {
    color: #f5a623;
    font-size: 1.4rem;
    line-height: 1;
  }
  .pt-block__stars .pt-block__rating-value, .pt-block__rating-count {
    font-family: Rubik;
  font-weight: 400;
  font-size: 16px;
  line-height: 100%;
  letter-spacing: -0.44px;
  color:#4A5565;
}

  /* ── Price+Title block - mobile ── */
    .pt-block__vendor a {
      font-size: 15px !important;
    }


  /* ── Multi Variant Picker block ── */
  .mvp-block {
    width: 100%;
  }
  .mvp-block .mvp-option {
    margin-bottom: 1.2rem;
  }
  .mvp-block .mvp-option:last-child {
    margin-bottom: 0;
  }
  .mvp-block .mvp-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.4rem;
    font-weight: 500;
    margin-bottom: 8px;
    color: var(--color-foreground);
  }
  .mvp-block .mvp-label span.mvp-selected-val {
    font-weight: 400;
    color: var(--color-foreground-secondary, #6b7280);
  }
  /* Buttons style */
  .mvp-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .mvp-buttons .mvp-btn {
    padding: 8px 16px;
    border: 1px solid var(--color-border, #d1d5db);
    border-radius: 4px;
    background: transparent;
    font-size: 1.3rem;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    color: var(--color-foreground);
  }
  .mvp-buttons .mvp-btn.is-active,
  .mvp-buttons .mvp-btn:hover {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .mvp-buttons .mvp-btn.is-unavailable {
    opacity: 0.4;
    text-decoration: line-through;
    cursor: not-allowed;
  }
  /* Swatches style — hooks into theme classes */
  .mvp-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* Dropdown style */
  .mvp-dropdown {
    width: 100%;
  }
  .mvp-dropdown select {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--color-border, #d1d5db);
    border-radius: 4px;
    font-size: 1.4rem;
    background: var(--color-background);
    color: var(--color-foreground);
    appearance: auto;
    cursor: pointer;
  }
</style>

<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-product-url="{{ product.url }}"
  class="f-product-single block"
  data-section-type="main-product"
  data-media-layout="carousel"
  data-enable-variant-group-images="{{ enable_variant_group_image }}"
  data-disable-default-select-variant="{{ disable_default_variant }}"
  data-variant-option-none-text="{{ 'products.product.variant_option_none_text' | t }}"
  data-variant-selection-needed-text="{{ 'products.product.variant_selection_needed_text' | t }}"
>
  <div class="container">
    <div
      class="f-flex flex-wrap f-single-product--information f-single-product--media-{{ media_size }}{% unless product.media.size > 0 %} f-single-product--no-media{% endunless %}"
      style="--column-gap: 4rem;--row-gap-mobile: 2.4rem;"
    >
      {% if section.settings.move_title_price_mobile %}
        {%- liquid
          assign pt_rating = product.metafields.app--2519111--reviews.review_average_rating.value
          assign pt_count  = product.metafields.app--2519111--reviews.review_count.value
        -%}
          <div class="f-product-single__block f-product-single__block--price-title pt-block mobile_only" {{ block.shopify_attributes }}>
            <div class="pt-block__left">
              <h1 class="pt-block__title {{ block.settings.heading_size }}">{{ product.title }}</h1>
              
                <p class="pt-block__vendor">{{ product.vendor | link_to_vendor }}</p>
              
            </div>
            <div class="pt-block__right">
              <p class="pt-block__price">{{ product.selected_or_first_available_variant.price | money }}</p>
              {%- if pt_rating != blank -%}
                 <a href="#yotpo-headline-reviews">
                <div class="pt-block__stars">
                  <span class="pt-block__star-icon"><svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8.5 11.2842V3.45263L9.9535 6.84632L13.6765 7.15789L10.8545 9.59158L11.696 13.1958L8.5 11.2842ZM17 6.09684L10.8885 5.58316L8.5 0L6.1115 5.58316L0 6.09684L4.6325 10.08L3.247 16L8.5 12.8589L13.753 16L12.359 10.08L17 6.09684Z" fill="#FCD34D"/>
                  </svg></span>
                  <span class="pt-block__rating-value">{{ pt_rating | round: 1 }}</span>
                  {%- if pt_count != blank -%}
                    <span class="pt-block__rating-count">({{ pt_count }})</span>
                  {%- endif -%}
                </div>
              </a>
              {%- endif -%}
            </div>
          </div>
        {% comment %} Removing Title & Price from Below{% endcomment %}
        <style type='text/css'>
          .mobile_only{
              display:none!Important
          }
          @media screen and (max-width:768px){
              .mobile_only{
                  display:flex!Important;
                  align-items: center;
              }
              .product-header.mobile_only {
                  display: flex !important;
                  flex-direction: row;
                  justify-content: space-between !important;
                  width: 100% ! Important;
                  align-items: center;
              }
              .f-product-single__block--price_title{
                  display:none!important;
              }
              .left-side p {
                  margin-bottom: 4px;
              }
              .product-title-mobile {
                  font-family: var(--font-heading-family);
                  font-weight: 400;
                  font-size: 1.8rem;
              }
              nav.breadcrumbs.flex.flex-wrap.justify-center {
                  display: none;
              }
              p.f-product__vendor.text-upper.text-subtext {
                  font-size: 12px;
              }
              .f-single-product--information {
                  gap: 10px !important;
              }
              .f-product__media-viewer:not(.f-product__media-only--image,.f-product__media-viewer--thumbs-show) .f-product__media{
                  width:95%!important;
              }
              button.flickity-button {
                  display: none !important;
              }
              .flickity-page-counter.no-js-hidden.md\:hidden.inline-flex {
                  display: block;
                  position: absolute;
                  top: 0px;
                  left: calc(2.5% + 33px);
                  background: transparent;
                  border: none;
              }
              .f-product__media-icon{
                  width:2.5rem;
                  height:2.5rem;
                  filter: invert(1);
              }
              .f-product__media-zoom {
                  top: unset;
                  right: 1rem;
                  bottom: 1rem;
              }
              .course-box, .logo-box{
                  display:flex;
                  align-items: center;
                  flex-direction:column;
              }
              #course-select, #select-embroidered, #select-decoration-type{
                  padding: 0.55rem 0.7rem;
              }
              .course-box label, .logo-box label.form__label{
                  min-width: 100%;
                  display:block;
                  font-size: 14px;
                  vertical-align: -webkit-baseline-middle;
                  height: 100%;
                  margin-bottom: 0px !important;
              }
              .logo-box .variant-picker__option-values{
                  gap:5px!important;
              }
              .variant-picker__option-button--color:after{
                  display:none;
              }
              .logo-box input[type=radio]:checked+label {
                  border: 2px solid #000000 !important;
              }
              #select-embroidered-radio-group{
                  display:flex!important;
              }
          }
          @media (max-width: 767px) {
              #select-embroidered-radio-group {
                  display: flex;
                  flex-wrap: wrap;
                  gap: 12px;
                  width: 100%;
              }
              #select-embroidered-radio-group .radio-item {
                  flex: 1 1 calc(50% - 6px);
                  min-width: calc(50% - 6px);
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  padding: 5px 10px;
                  border: 2px solid #c58a30;
                  border-radius: 6px;
                  background-color: #fff;
                  cursor: pointer;
                  transition: all 0.3s ease;
                  position: relative;
              }
              #select-embroidered-radio-group .radio-item:hover {
                  border-color: #c58a30;
                  background-color: #fafafa;
              }
              #select-embroidered-radio-group .radio-item input[type="radio"] {
                  position: absolute;
                  opacity: 0;
                  cursor: pointer;
                  width: 100%;
                  height: 100%;
                  top: 0;
                  left: 0;
                  margin: 0;
              }
              #select-embroidered-radio-group .radio-item label {
                  cursor: pointer;
                  margin: 0;
                  font-size: 16px;
                  font-weight: 400;
                  text-align: center;
                  width: 100%;
                  pointer-events: none;
                  color: #c58a30;
                  text-transform: uppercase;
              }
              #select-embroidered-radio-group .radio-item:has(input[type="radio"]:checked) {
                  background-color: #222f1d;
                  border-color: #222f1d;
              }
              #select-embroidered-radio-group .radio-item:has(input[type="radio"]:checked) label {
                  color: #fff;
                  font-weight: 400;
              }
              #select-embroidered-radio-group .radio-item input[type="radio"]:checked ~ label {
                  color: #fff;
              }
              .logo-placement-text{
                  font-size:14px;
              }
              .form__label[for="course-select"] {
