                  justify-content: space-between;
              }
              .select-logos .variant-picker__option{
                  flex:1!important;
              }
              .logo-box input[type="radio"] + label {
                  max-width: 100%;
              }
              .f-product-form__buttons {
                  margin-top: 1.3rem;
                  margin-bottom: 1rem;
              }
              .f-product-single__block{
                  margin:0px;
              }
              .variant-picker__field-wrapper + .variant-picker__field-wrapper, .logo-box, .variant-clubs {
                  margin-top: 0.75rem!important;
              }
              variant-picker {
                  display: flex;
                  flex-direction: column-reverse;
                  gap: 0.75rem;
              }
              .course-box label, .variant-clubs label {
                  margin-bottom: 2px !important;
              }
          }          
        </style>
        <script>
          function convertSelectToRadio(selectId) {
            const selectElement = document.getElementById(selectId);
            if (!selectElement) return;
            let radioContainer = document.getElementById(selectId + '-radio-group');
            function createRadioButtons() {
              if (radioContainer) { radioContainer.style.display = 'block'; selectElement.style.display = 'none'; return; }
              selectElement.style.display = 'none';
              radioContainer = document.createElement('div');
              radioContainer.id = selectId + '-radio-group';
              radioContainer.className = 'radio-group';
              const radioName = selectId + '-radio';
              const selectedValue = selectElement.value;
              Array.from(selectElement.options).forEach((option, index) => {
                const radio = document.createElement('input');
                radio.type = 'radio'; radio.id = `${selectId}-radio-${index}`; radio.name = radioName; radio.value = option.value;
                if (option.value === selectedValue || option.selected) radio.checked = true;
                radio.addEventListener('change', function() { if (this.checked) { selectElement.value = this.value; selectElement.dispatchEvent(new Event('change', { bubbles: true })); } });
                const label = document.createElement('label'); label.htmlFor = radio.id; label.textContent = option.text;
                const wrapper = document.createElement('div'); wrapper.className = 'radio-item'; wrapper.appendChild(radio); wrapper.appendChild(label);
                radioContainer.appendChild(wrapper);
              });
              selectElement.parentNode.insertBefore(radioContainer, selectElement.nextSibling);
            }
            function removeRadioButtons() { if (radioContainer) radioContainer.style.display = 'none'; selectElement.style.display = 'block'; }
            function handleResize() { if (window.innerWidth < 768) { createRadioButtons(); } else { removeRadioButtons(); } }
            handleResize();
            window.addEventListener('resize', handleResize);
          }
          document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() { convertSelectToRadio('select-embroidered'); }, 1500);
          });
        </script>
      {% endif %}
      <motion-element
        data-motion="{{ animation_effect }}"
        class="block f-column f-product__media-wrapper"
      >
        {% render 'product-media',
          section: section,
          first_3d_model: first_3d_model,
          enable_image_zoom: enable_image_zoom,
          enable_sticky_info: enable_sticky_info,
          show_featured_media: section.settings.show_featured_media
        %}
      </motion-element>
      <motion-element
        data-motion="{{ animation_effect }}"
        class="block f-column f-product-single__info desktop-only"
      >
        {% render 'main-product-blocks',
          update_browser_history: true,
          enable_sticky_info: enable_sticky_info,
          disable_default_variant: disable_default_variant
        %}
      </motion-element>
    </div>
  </div>
  {%- if enable_variant_group_image -%}
    <script id="VariantGroupImages" type="application/json">
      {{ product.metafields.foxecom-bs-kit.variant-images.value | json }}
    </script>
  {%- endif -%}
  <script id="ProductData" type="application/json">
    {{ product | json }}
  </script>
</product-info>
<product-recently-viewed
  data-product-id="{{ product.id }}"
  class="f:hidden"
></product-recently-viewed>
<script src="{{ 'product-info.js' | asset_url }}" defer></script>
{%- if product.media.size > 0 -%}
  <script src="{{ 'product-media.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if first_3d_model -%}
  <script type="application/json" id="ModelJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
  <script src="{{ 'product-model.js' | asset_url }}" defer></script>
{%- endif -%}
{%- if product.options_with_values.size > 0 -%}
  <script src="{{ 'variants-picker.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.enable_image_zoom -%}
  {%- liquid
    assign media_list = product.media | where: 'media_type', 'image'
    assign wrap_around = false
    assign cell_align = 'left'
    if media_list.size > 2
      assign wrap_around = true
    endif
    if media_list.size == 1
      assign cell_align = 'center'
    endif
  -%}
  <product-modal
    id="ProductModal-{{ section.id }}"
    class="f-modal hidden media-modal"
    style="--modal-width: 100%"
  >
    <div
      class="f-modal__content"
      role="dialog"
      aria-label="{{ 'products.modal.label' | t }}"
      aria-modal="true"
      tabindex="-1"
    >
      <div class="f-modal__inner">
        <button
          id="ModalClose-{{ section.id }}"
          type="button"
          class="f-modal__close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% comment %} theme-check-disable {% endcomment %}
          {{ 'icon-close.svg' | inline_asset_content }}
          {% comment %} theme-check-enable {% endcomment %}
        </button>
        <div class="f-modal__inner">
          <div
            class="media-modal__content flex flex-col h-full"
            role="document"
            aria-label="{{ 'products.modal.label' | t }}"
            tabindex="0"
            data-media-loading
          >
            <flickity-component
              data-slider-options='{"pageDots": false, "cellAlign": "{{ cell_align }}", "prevNextButtons": true, "adaptiveHeight": true, "setGallerySize": false, "dragThreshold": 10, "wrapAround": {{ wrap_around }}}'
              data-enable-slider="true"
              data-slider-columns="1"
              id="Modal-Media-Gallery-{{ section.id }}"
              class="media-modal__list h-full{% if media_list.size == 1 %} media-modal__list--has-only{% endif %}"
              role="list"
            >
              {%- liquid
                if product.selected_or_first_available_variant.featured_media != null
                  assign media = product.selected_or_first_available_variant.featured_media
                  render 'media', media: media, media_index: 0
                endif
              -%}
              {%- for media in media_list -%}
                {%- liquid
                  unless media.id == product.selected_or_first_available_variant.featured_media.id
                    render 'media', media: media, media_index: forloop.index0
                  endunless
                -%}
              {%- endfor -%}
            </flickity-component>
          </div>
        </div>
      </div>
    </div>
  </product-modal>
{%- endif -%}
<script src="{{ 'variant-picker-split-sync.js' | asset_url }}" defer></script>
<script type="application/ld+json">
  {{ product | structured_data }}
</script>
<script type="text/javascript">
function overrideCourseChange(){
  if ('scrollRestoration' in history) { history.scrollRestoration = 'manual'; }
  window.location.reload(true);
}
function scrollToTopOnReady() {
  if ('scrollRestoration' in history) { history.scrollRestoration = 'manual'; }
  setTimeout(function() { window.scrollTo(0, 0); }, 500);
}
document.addEventListener('DOMContentLoaded', scrollToTopOnReady);

document.addEventListener('variant:changed', function(evt) {
  const variant = evt.detail.variant;
  if (!variant) return;
  const priceInCents = variant.price;
  let formattedPrice;
  if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
    formattedPrice = Shopify.formatMoney(priceInCents, theme.moneyFormat || '${{amount}}');
  } else {
    formattedPrice = '$' + (priceInCents / 100).toFixed(2);
  }
  const priceElement = document.querySelector('.product-header.mobile_only .right-side');
  if (priceElement) priceElement.textContent = formattedPrice;

  // Update price+title block price
  const ptPrice = document.querySelector('.pt-block__price');
  if (ptPrice) ptPrice.textContent = formattedPrice;
});
</script>
