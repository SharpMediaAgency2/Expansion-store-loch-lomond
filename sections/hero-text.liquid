{{ 'hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image = section.settings.image
  assign image_overlay_opacity = section.settings.image_overlay_opacity
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class
  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign text_color = section.settings.text_color
  assign show_text_below = section.settings.show_text_below
  assign text_alignment = section.settings.text_alignment
  assign text_alignment_mobile = section.settings.text_alignment_mobile

  assign motion_delay = 0
  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if section.index < 2
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
-%}

<div
  class="f-hero f-hero--mobile block relative overflow-hidden {{ custom_class }}"
  id="{{ section_id }}"
  data-section-id="{{ section.id }}"
  data-section-type="hero-section"
>
  {%- if image != blank -%}
    <motion-element
      data-motion="{% if section.settings.enable_bg_zoom_effect %}zoom-out-sm{% else %}none{% endif %}"
      class="block absolute w-full h-full"
    >
      <picture class="bg-image">
        {{
          image
          | image_url: width: 3000
          | image_tag:
            loading: loading,
            fetchpriority: fetchpriority,
            widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
            sizes: '100vw',
            alt: image.alt
        }}
      </picture>
      {%- if image_overlay_opacity > 0 -%}
        <div
          class="bg-overlay"
          style="--color-overlay-alpha: {{ image_overlay_opacity }}"
        ></div>
      {%- endif -%}
    </motion-element>
  {%- endif -%}

  <div class="container">
    <div
      class="block {% if section.settings.short_hero %}f-hero__wrapper--short{% else %}f-hero__wrapper{% endif %} relative overflow-hidden{% if show_text_below %} f-hero__wrapper--mobile-stack{% endif %}"
    >
      {%- if section.blocks.size > 0 -%}
        <div class="f-hero__content-wrapper flex md:content-overlay--{{ section.settings.content_position }}{% unless section.settings.show_text_below %} md-down:content-overlay--{{ section.settings.content_position_mobile }}{% endunless %}">
          <div
            class="f-hero__content f-text-blocks text-{{ text_alignment_mobile }} md:text-{{ text_alignment }}"
            style="--text-color: {{ text_color }};"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'title' -%}
                  {%- if block.settings.title != blank -%}
                    {%- liquid
                      assign inline_css = ''

                      if block.settings.heading_color != blank and block.settings.heading_color != 'rgba(0,0,0,0)'
                        assign inline_css = inline_css | append: 'color:' | append: block.settings.heading_color | append: ';'
                      endif
                    -%}
                    <{{ block.settings.heading_tag }}
                      class="f-hero_heading {{ block.settings.heading_size }}"
                      {% if inline_css != blank %}
                        style="{{ inline_css }}"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <motion-element
                        data-motion="{{ animation_effect }}"
                        data-motion-delay="{{ motion_delay }}"
                        class="block"
                      >
                        {%- render 'highlight-text',
                          hl_text: block.settings.title,
                          hl_style: block.settings.highlight_style,
                          enable_hl_text_color: block.settings.enable_highlight_text_color
                        -%}
                      </motion-element>
                    </{{ block.settings.heading_tag }}>
                    {%- assign motion_delay = motion_delay | plus: 50 -%}
                  {%- endif -%}
                {%- when 'subtitle' -%}
                  {%- if block.settings.subtitle != blank -%}
                    <motion-element
                      data-motion="{{ animation_effect }}"
                      data-motion-delay="{{ motion_delay }}"
                      class="block f-hero_subheading text-subheading"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.subtitle | escape }}
                    </motion-element>
                    {%- assign motion_delay = motion_delay | plus: 50 -%}
                  {%- endif -%}
                {%- when 'text' -%}
                  {%- if block.settings.text != blank -%}
                    <motion-element
                      data-motion="{{ animation_effect }}"
                      data-motion-delay="{{ motion_delay }}"
                      class="block f-hero_text rte mobile-remove-br"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.text }}
                    </motion-element>
                    {%- assign motion_delay = motion_delay | plus: 50 -%}
                  {%- endif -%}
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <motion-element
                      data-motion="{{ animation_effect }}"
                      data-motion-delay="{{ motion_delay }}"
                      class="block f-text-blocks__btn"
                    >
                      <a
                        class="btn {{ block.settings.button_style }} {{ block.settings.button_size }}"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link"
                          aria-disabled="true"
                        {% endif %}
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    </motion-element>
                    {%- assign motion_delay = motion_delay | plus: 50 -%}
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
