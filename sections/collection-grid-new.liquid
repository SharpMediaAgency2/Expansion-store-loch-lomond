{% comment %}
  Section: Collection Grid
  - Pulls products from the current collection page (collection template only)
  - Hero image block (desktop: spans 2 cols, mobile: stacked above grid)
  - AJAX pagination replaces only product cards; hero stays in place
  - Pagination rendered outside the coloured container
{% endcomment %}

<link
  id="ModalComponent"
  rel="stylesheet"
  href="{{ 'modal-component.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- liquid
  assign section_id   = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class
  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign collection       = collection
  assign product_to_show  = section.settings.limit | default: 8
  assign image_ratio      = section.settings.pcard_image_ratio
  assign show_vendor      = section.settings.show_vendor
  assign columns          = section.settings.columns
  assign columns_tablet   = columns
  if columns > 3
    assign columns_tablet = columns | divided_by: 2.0 | ceil | at_least: 3
  endif

  assign enable_swipe_mobile = section.settings.enable_swipe_mobile
  assign column_mobile       = section.settings.column_mobile

  assign button_label = section.settings.button_label
  assign button_link  = section.settings.button_link | default: collection.url

  assign hero_block = nil
  for block in section.blocks
    if block.type == 'hero_image'
      assign hero_block = block
      break
    endif
  endfor

  assign has_hero = false
  if hero_block != nil and hero_block.settings.image != blank
    assign has_hero = true
  endif

  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif

  assign hero_row_products = 2
  if columns <= 2
    assign hero_row_products = 0
  elsif columns == 3
    assign hero_row_products = 1
  endif

  assign skip_count = hero_row_products
  if has_hero == false
    assign skip_count = 0
  endif

  assign current_page = current_page | default: 1
  assign total_pages  = collection.products_count | divided_by: product_to_show | ceil
-%}

{% if section.settings.disable_logo_overlay == true %}
  <style>
    #{{ section_id }} .logo-overlay { display: none !important; }
  </style>
{% endif %}

<style>
  #{{ section_id }} {
    --section-padding-top:    {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* ── Wrapper ── */
  #{{ section_id }} .cg-wrap {
    {% if section.settings.enable_background %}
      background-color: {{ section.settings.background_color }};
      border-radius: 12px;
      padding: {{ section.settings.bg_padding }}px;
    {% endif %}
  }

  /* ── Header ── */
  #{{ section_id }} .cg-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 34px;
  }
  #{{ section_id }} .cg-heading {
    margin: 0 0 4px;
  }
  #{{ section_id }} .cg-heading.h2 {
    font-size: 30px !important;
    padding-bottom:10px;
    padding-top:15px;
  }
  #{{ section_id }} .cg-subheading {
    font-family: 'Rubik';
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.31px;
    color:#4A5565;

  }
  #{{ section_id }} .cg-header__divider {
    width: 64px;
    height: 4px;
    border-radius:10px;
    background: #222F1D;
    opacity: 1;
    margin-top: 14px;
  }
  #{{ section_id }} .cg-view-all {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }
  #{{ section_id }} .cg-view-all:hover { opacity: 0.7; }

  /* ── Forced card image height (when enabled) ── */
  {% if section.settings.force_card_height %}
  /*
    Scope: BOTH the main grid AND the hero product cells.
    Selectors cover Dawn-derived themes, Foxecom (Zest) theme, and
    common product-card variants.
  */
  #{{ section_id }} .cg-products .product-card__image-wrapper,
  #{{ section_id }} .cg-hero-product-cell .product-card__image-wrapper,
  #{{ section_id }} .cg-products .product-card__image,
  #{{ section_id }} .cg-hero-product-cell .product-card__image,
  #{{ section_id }} .cg-products .card__image,
  #{{ section_id }} .cg-hero-product-cell .card__image,
  #{{ section_id }} .cg-products .product-card .media,
  #{{ section_id }} .cg-hero-product-cell .product-card .media,
  #{{ section_id }} .cg-products .product-card figure,
  #{{ section_id }} .cg-hero-product-cell .product-card figure,
  #{{ section_id }} .cg-products responsive-image,
  #{{ section_id }} .cg-hero-product-cell responsive-image,
  #{{ section_id }} .cg-products [class*="product-card"] .media,
  #{{ section_id }} .cg-hero-product-cell [class*="product-card"] .media {
    aspect-ratio: {{ section.settings.card_image_ratio }} !important;
    overflow: hidden !important;
    display: block !important;
    width: 100% !important;
    height: auto !important;
    /* Override theme CSS variable that may set a different ratio */
    --aspect-ratio: unset !important;
  }

  #{{ section_id }} .cg-products .product-card__image-wrapper img,
  #{{ section_id }} .cg-hero-product-cell .product-card__image-wrapper img,
  #{{ section_id }} .cg-products .product-card__image img,
  #{{ section_id }} .cg-hero-product-cell .product-card__image img,
  #{{ section_id }} .cg-products .card__image img,
  #{{ section_id }} .cg-hero-product-cell .card__image img,
  #{{ section_id }} .cg-products .product-card .media img,
  #{{ section_id }} .cg-hero-product-cell .product-card .media img,
  #{{ section_id }} .cg-products .product-card figure img,
  #{{ section_id }} .cg-hero-product-cell .product-card figure img,
  #{{ section_id }} .cg-products responsive-image img,
  #{{ section_id }} .cg-hero-product-cell responsive-image img,
  #{{ section_id }} .cg-products [class*="product-card"] .media img,
  #{{ section_id }} .cg-hero-product-cell [class*="product-card"] .media img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
  }
  #{{ section_id }} .cg-hero-product-cell .product-card__image-wrapper .logo-overlay img{
      object-fit:contain!important
  }

  /* Ensure the wrapper is positioned so absolute img fills it */
  #{{ section_id }} .cg-products .product-card__image-wrapper,
  #{{ section_id }} .cg-hero-product-cell .product-card__image-wrapper,
  #{{ section_id }} .cg-products responsive-image,
  #{{ section_id }} .cg-hero-product-cell responsive-image {
    position: relative !important;
  }
  {% endif %}

  /* ── Desktop hero row ── */
  #{{ section_id }} .cg-hero-row {
    align-items: start;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: {{ section.settings.gap }}px;
    margin-bottom: {{ section.settings.gap }}px;
  }
  #{{ section_id }} .cg-hero-cell {
    overflow: hidden;
    border-radius: 8px;
    height: 100%;          /* stretch to fill grid row via align-items:stretch */
  }
  #{{ section_id }} .cg-hero-cell a,
  #{{ section_id }} .cg-hero-cell > div { display: block; width: 100%; height: 100%; }
  #{{ section_id }} .cg-hero-cell picture { display: block; width: 100%; height: 100%; }
  #{{ section_id }} .cg-hero-cell img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }

  #{{ section_id }} .cg-hero-product-cell {
    overflow: hidden;
  }

  /* ── Mobile hero ── */
  #{{ section_id }} .cg-mobile-hero {
    display: none;
    margin-bottom: {{ section.settings.gap_mobile }}px;
    border-radius: 8px;
    overflow: hidden;
  }
  #{{ section_id }} .cg-mobile-hero a,
  #{{ section_id }} .cg-mobile-hero > div { display: block; width: 100%; }
  #{{ section_id }} .cg-mobile-hero picture { display: block; width: 100%; }
  #{{ section_id }} .cg-mobile-hero img { display: block; width: 100%; height: auto; }

  /* ── Product grid ── */
  #{{ section_id }} .cg-products {
    display: grid;
    grid-template-columns: repeat({{ columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
    min-height: 200px;
    position: relative;
  }

  /* Loading overlay */
  #{{ section_id }} .cg-products.is-loading::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.6);
    border-radius: 8px;
    z-index: 10;
  }
  #{{ section_id }} .cg-products.is-loading::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 32px;
    height: 32px;
    margin: -16px 0 0 -16px;
    border: 3px solid #e5e7eb;
    border-top-color: #374151;
    border-radius: 50%;
    animation: cg-spin 0.7s linear infinite;
    z-index: 11;
  }
  @keyframes cg-spin { to { transform: rotate(360deg); } }

  /* ── Pagination — OUTSIDE the container ── */
  .cg-pagination-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 40px;
    flex-wrap: wrap;
    position: relative;
  }

  /* Previous button → push to far left */
  .cg-pagination-wrap .cg-page-btn:first-child {
    margin-right: auto;
  }
  /* Next button → push to far right */
  .cg-pagination-wrap .cg-page-btn:last-child {
    margin-left: auto;
  }

  .cg-pagination-wrap .cg-page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    background: #fff;
    color: #374151;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    user-select: none;
  }
  .cg-pagination-wrap .cg-page-btn:hover:not([disabled]) {
    background: #f3f4f6;
  }
  .cg-pagination-wrap .cg-page-btn.is-active {
    background: #111827;
    color: #fff;
    border-color: #111827;
  }
  .cg-pagination-wrap .cg-page-btn[disabled] {
    opacity: 0.35;
    cursor: default;
  }
  .cg-pagination-wrap .cg-page-ellipsis {
    font-size: 14px;
    color: #9ca3af;
    padding: 0 4px;
  }

  /* Mobile: stack tightly, keep prev/next at edges */
  @media (max-width: 480px) {
    .cg-pagination-wrap {
      gap: 4px;
    }
    .cg-pagination-wrap .cg-page-btn {
      padding: 0 8px;
      font-size: 13px;
      min-width: 32px;
      height: 32px;
    }
  }

  @media (max-width: 767px) {
    #{{ section_id }} .cg-hero-row {
      display: none;
    }
    #{{ section_id }} .cg-mobile-hero { display: block; }
    #{{ section_id }} .cg-wrap {
      {% if section.settings.enable_background %}
        padding: {{ section.settings.bg_padding | divided_by: 2 }}px;
      {% endif %}
    }
    #{{ section_id }} .cg-products {
      grid-template-columns: repeat({{ column_mobile }}, 1fr);
      gap: {{ section.settings.gap_mobile }}px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    #{{ section_id }} .cg-products {
      grid-template-columns: repeat({{ columns_tablet }}, 1fr);
    }
  }
  .f-image.product-card__image.product-card__image--main {
  aspect-ratio: 3/4;
}
</style>

<section
  id="{{ section_id }}"
  data-section-type="collection-grid"
  data-section-id="{{ section.id }}"
  data-products-per-page="{{ product_to_show }}"
  data-columns="{{ columns }}"
  data-skip-count="{{ skip_count }}"
  class="collection-grid{{ custom_class }} f-section-padding color-{{ section.settings.color_schema }}{% if has_hero %} has-hero{% endif %}"
>
  <div class="container">
    <div class="cg-wrap">

      {%- comment -%} Header {%- endcomment -%}
      <div class="cg-header">
        <div class="cg-header__left">
          {%- if section.settings.heading != blank -%}
            <motion-element data-motion="{{ animation_effect }}" data-motion-delay="0" class="block">
              <{{ section.settings.heading_tag }} class="cg-heading {{ section.settings.heading_size }}">
                {%- render 'highlight-text',
                  hl_text: section.settings.heading,
                  hl_style: section.settings.highlight_style,
                  enable_hl_text_color: section.settings.enable_highlight_text_color
                -%}
              </{{ section.settings.heading_tag }}>
            </motion-element>
          {%- elsif collection.title != blank -%}
            <{{ section.settings.heading_tag }} class="cg-heading {{ section.settings.heading_size }}">
              {{ collection.title }}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <motion-element data-motion="{{ animation_effect }}" data-motion-delay="50" class="block">
              <p class="cg-subheading">{{ section.settings.subheading | escape }}</p>
            </motion-element>
          {%- endif -%}
          <div class="cg-header__divider"></div>
        </div>

        {%- if button_label != blank -%}
          <motion-element data-motion="{{ animation_effect }}" data-motion-delay="100" class="block">
            <a class="cg-view-all" href="{{ button_link }}">{{ button_label | escape }} &rarr;</a>
          </motion-element>
        {%- endif -%}
      </div>

      {%- comment -%} Desktop hero row {%- endcomment -%}
      {%- if has_hero -%}
        <div class="cg-hero-row" id="cg-hero-row-{{ section_id }}">
          <div class="cg-hero-cell" {{ hero_block.shopify_attributes }}>
            {%- if hero_block.settings.link != blank -%}
              <a href="{{ hero_block.settings.link }}">
            {%- else -%}
              <div style="height:100%;">
            {%- endif -%}
              <picture>
                {%- if hero_block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 767px)"
                    srcset="{{ hero_block.settings.image_mobile | image_url: width: 800 }}"
                    width="{{ hero_block.settings.image_mobile.width }}"
                    height="{{ hero_block.settings.image_mobile.height }}"
                  >
                {%- endif -%}
                {{
                  hero_block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 700, 900, 1200, 1400',
                    sizes: '(max-width: 767px) 100vw, 50vw',
                    width: hero_block.settings.image.width,
                    height: hero_block.settings.image.height,
                    alt: hero_block.settings.image.alt
                }}
              </picture>
            {%- if hero_block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} First N products beside hero — direct grid children ── {%- endcomment -%}
          {% if collection != blank %}
            {% for product in collection.products limit: hero_row_products %}
              <div class="cg-hero-product-cell" id="cg-hero-product-{{ section_id }}-{{ forloop.index }}">
                {% render 'product-card',
                  product: product,
                  image_ratio: image_ratio,
                  show_vendor: show_vendor,
                  section_index: section.index,
                  enable_swatches: section.settings.enable_swatch_colors,
                  index: forloop.index
                %}
              </div>
            {% endfor %}
          {% else %}
            {% for i in (1..hero_row_products) %}
              <div class="cg-hero-product-cell" id="cg-hero-product-{{ section_id }}-{{ forloop.index }}">
                {% render 'product-card-placeholder', index: forloop.index %}
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {%- comment -%} Mobile hero {%- endcomment -%}
        <div class="cg-mobile-hero" {{ hero_block.shopify_attributes }}>
          {%- if hero_block.settings.link != blank -%}
            <a href="{{ hero_block.settings.link }}">
          {%- else -%}
            <div>
          {%- endif -%}
            <picture>
              {%- if hero_block.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ hero_block.settings.image_mobile | image_url: width: 800 }}"
                  width="{{ hero_block.settings.image_mobile.width }}"
                  height="{{ hero_block.settings.image_mobile.height }}"
                >
              {%- endif -%}
              {{
                hero_block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800',
                  sizes: '100vw',
                  width: hero_block.settings.image.width,
                  height: hero_block.settings.image.height,
                  alt: hero_block.settings.image.alt
              }}
            </picture>
          {%- if hero_block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Product grid — this div is the AJAX target {%- endcomment -%}
      <div
        class="cg-products"
        id="cg-products-{{ section_id }}"
        data-current-page="1"
        data-total-pages="{{ total_pages }}"
      >
        {% if collection != blank %}
          {% assign product_index = 0 %}
          {% for product in collection.products limit: product_to_show %}
            {% if product_index < skip_count %}
              <div class="cg-col cg-desktop-skip">
                {% render 'product-card',
                  product: product,
                  image_ratio: image_ratio,
                  show_vendor: show_vendor,
                  section_index: section.index,
                  enable_swatches: section.settings.enable_swatch_colors,
                  index: forloop.index
                %}
              </div>
            {% else %}
              <div class="cg-col">
                {% render 'product-card',
                  product: product,
                  image_ratio: image_ratio,
                  show_vendor: show_vendor,
                  section_index: section.index,
                  enable_swatches: section.settings.enable_swatch_colors,
                  index: forloop.index
                %}
              </div>
            {% endif %}
            {% assign product_index = product_index | plus: 1 %}
          {% endfor %}
        {% else %}
          {% for i in (1..product_to_show) %}
            <div class="cg-col">{% render 'product-card-placeholder', index: forloop.index %}</div>
          {% endfor %}
        {% endif %}
      </div>

    </div>{%- comment -%} /.cg-wrap {%- endcomment -%}
  </div>{%- comment -%} /.container {%- endcomment -%}

  {%- comment -%} Pagination — outside the coloured container {%- endcomment -%}
  {%- if total_pages > 1 -%}
    <div class="container">
      <div class="cg-pagination-wrap" id="cg-pagination-{{ section_id }}" data-section="{{ section_id }}">
        {%- comment -%} Rendered by JS on init and on each page change {%- endcomment -%}
      </div>
    </div>
  {%- endif -%}

</section>

<style>
  /* Desktop: hide products that are already shown beside the hero */
  @media (min-width: 768px) {
    #{{ section_id }} .cg-desktop-skip { display: none; }
  }
</style>

<script>
(function () {
  var SECTION_ID     = '{{ section_id }}';
  var COLLECTION     = '{{ collection.handle }}';
  var PER_PAGE       = {{ product_to_show }};
  var SKIP           = {{ skip_count }};
  var HAS_HERO       = {{ has_hero }};
  var TOTAL_PRODUCTS = {{ collection.products_count | default: 0 }};
  var TOTAL_PAGES    = Math.ceil(TOTAL_PRODUCTS / PER_PAGE) || 1;
  var IMAGE_RATIO    = '{{ section.settings.card_image_ratio | default: "3/4" }}';
  var FORCE_HEIGHT   = {{ section.settings.force_card_height | default: false }};

  var grid       = document.getElementById('cg-products-' + SECTION_ID);
  var pagination = document.getElementById('cg-pagination-' + SECTION_ID);
  if (!grid) return;

  var currentPage = 1;

  /* ─────────────────────────────────────────────
     RENDER PAGINATION BUTTONS
  ───────────────────────────────────────────── */
  function renderPagination(page) {
    if (!pagination) return;
    pagination.innerHTML = '';

    function btn(label, pg, disabled, active) {
      var el = document.createElement('button');
      el.className = 'cg-page-btn' + (active ? ' is-active' : '');
      el.innerHTML = label;
      if (disabled) {
        el.disabled = true;
      } else {
        el.addEventListener('click', function () { goToPage(pg); });
      }
      return el;
    }

    function ellipsis() {
      var s = document.createElement('span');
      s.className = 'cg-page-ellipsis';
      s.textContent = '…';
      return s;
    }

    pagination.appendChild(btn('&larr; Previous', page - 1, page === 1));

    var pages = [];
    if (TOTAL_PAGES <= 7) {
      for (var i = 1; i <= TOTAL_PAGES; i++) pages.push(i);
    } else {
      pages = [1];
      if (page > 3) pages.push('…');
      var start = Math.max(2, page - 1);
      var end   = Math.min(TOTAL_PAGES - 1, page + 1);
      for (var j = start; j <= end; j++) pages.push(j);
      if (page < TOTAL_PAGES - 2) pages.push('…');
      pages.push(TOTAL_PAGES);
    }

    pages.forEach(function (p) {
      if (p === '…') { pagination.appendChild(ellipsis()); }
      else { pagination.appendChild(btn(p, p, false, p === page)); }
    });

    pagination.appendChild(btn('Next &rarr;', page + 1, page === TOTAL_PAGES));
  }

  /* ─────────────────────────────────────────────
     FETCH PAGE via Sections Rendering API
     Uses sections/collection-grid-products.liquid as a render helper
     to get the REAL Liquid-rendered product cards (with all theme
     styles, swatches, wishlist, badges, etc.) for any page number.
  ───────────────────────────────────────────── */
  function goToPage(page) {
    if (page < 1 || page > TOTAL_PAGES || page === currentPage) return;
    currentPage = page;
    renderPagination(page);
    grid.classList.add('is-loading');

    /* Scroll to section top */
    var sectionEl = document.getElementById(SECTION_ID);
    if (sectionEl) {
      var offset = sectionEl.getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top: offset, behavior: 'smooth' });
    }

    /*
      We use Shopify's Sections Rendering API to fetch the REAL
      Liquid-rendered product cards from a helper section.

      Helper section file: sections/cg-products.liquid
      It reads ?page, ?limit, ?skip, ?ratio, ?force from the URL and
      outputs ONLY the cards markup using a paginate tag and the theme's
      `product-card` snippet — so styles, swatches, wishlist, badges
      all come through identically to the initial server render.

      Endpoint:
        /collections/{handle}?sections=cg-products
        &page=N&limit=N&skip=N&ratio=X/Y&force=1
    */
    /*
      Only `page` and `limit` survive Shopify's URL whitelisting when
      a section is fetched via the Sections Rendering API. Custom
      params like p/skip/ratio/force are stripped. The helper section
      reads page+limit from canonical_url manually.

      If the current page is loaded with ?view=X (alternate template),
      we must preserve it — otherwise Shopify routes to a different
      template that may not include our helper section.
    */
    var currentParams = new URLSearchParams(window.location.search);
    var viewParam = currentParams.get('view');

    var paramArr = [
      'sections=cg-products',
      'page='  + page,
      'limit=' + PER_PAGE
    ];
    if (viewParam) {
      paramArr.push('view=' + encodeURIComponent(viewParam));
    }
    var params = paramArr.join('&');

    var url = '/collections/' + COLLECTION + '?' + params;

    fetch(url, {
      headers: {
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (data) {
        var html = data['cg-products'];
        if (!html) throw new Error('Helper section not found in response');

        var parser   = new DOMParser();
        var doc      = parser.parseFromString(html, 'text/html');
        var ajaxWrap = doc.querySelector('.cg-ajax-products');
        if (!ajaxWrap) throw new Error('No products returned');

        var allCards = ajaxWrap.querySelectorAll('.cg-col');

        /*
          ── Update hero product cells on EVERY page change ──
          The 2 (or N = SKIP) cards beside the hero are part of the
          paginated set. Take the first SKIP cards from the response
          and put them into the hero product cells. The remaining
          cards fill the main grid below.
        */
        if (HAS_HERO && SKIP > 0) {
          for (var h = 0; h < SKIP; h++) {
            var heroCell = document.getElementById('cg-hero-product-' + SECTION_ID + '-' + (h + 1));
            if (!heroCell) continue;
            var heroCard = allCards[h];
            if (heroCard) {
              heroCell.innerHTML = heroCard.innerHTML;
            } else {
              /* Last page may have fewer products — clear empty cells */
              heroCell.innerHTML = '';
            }
          }
        }

        /*
          ── Update main grid (cards after the hero skip) ──
          Build the grid HTML from cards[SKIP..end].
        */
        grid.innerHTML = '';
        var skipN = (HAS_HERO ? SKIP : 0);
        for (var i = skipN; i < allCards.length; i++) {
          grid.appendChild(allCards[i].cloneNode(true));
        }

        /*
          ── Mobile fallback ──
          On mobile, the hero product cells are hidden (the mobile hero
          image stacks on top, no products beside it). So the first SKIP
          cards must also appear in the grid on mobile. We re-insert
          them with .cg-desktop-skip so they show only on mobile.
        */
        if (HAS_HERO && SKIP > 0) {
          var mobileFrag = document.createDocumentFragment();
          for (var m = 0; m < skipN && m < allCards.length; m++) {
            var mCard = allCards[m].cloneNode(true);
            mCard.classList.add('cg-desktop-skip');
            mobileFrag.appendChild(mCard);
          }
          grid.insertBefore(mobileFrag, grid.firstChild);
        }

        /* Update browser URL */
        var newUrl = window.location.pathname + (page > 1 ? '?page=' + page : '');
        window.history.replaceState({}, '', newUrl);

        grid.classList.remove('is-loading');
        renderPagination(page);

        /*
          Re-init any theme JS that hooks product cards
          (swatches, wishlist buttons, quick-add, etc.)
        */
        if (window.Shopify && Shopify.PubSub && typeof Shopify.PubSub.publish === 'function') {
          Shopify.PubSub.publish('cart:section-rendered', grid);
        }
        document.dispatchEvent(new CustomEvent('collection-grid:updated', {
          detail: { section: SECTION_ID, page: page }
        }));
      })
      .catch(function (err) {
        console.error('[collection-grid] pagination error:', err);
        grid.classList.remove('is-loading');
      });
  }
(function() {
  function syncHeroHeight() {
    var section = document.getElementById(SECTION_ID);
    if (!section) return;
    if (window.innerWidth <= 767) return;

    var heroCell = section.querySelector('.cg-hero-cell');
    if (!heroCell) return;

    var card = section.querySelector('.cg-hero-product-cell .product-card');
    if (!card) return;

    heroCell.style.height = '';
    heroCell.style.height = card.offsetHeight + 'px';
  }

  function initHero() {
    syncHeroHeight();
    window.addEventListener('resize', syncHeroHeight);

    var section = document.getElementById(SECTION_ID);
    if (!section) return;
    section.querySelectorAll('.cg-hero-product-cell img').forEach(function(img) {
      if (!img.complete) img.addEventListener('load', syncHeroHeight);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
})();
  /* ── Init ── */
  renderPagination(1);
})();

</script>

