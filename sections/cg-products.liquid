{% comment %}
  Section: cg-products
  --------------------
  AJAX render helper for cg-main.liquid.

  Fetched via Shopify's Sections Rendering API to render paginated
  product cards. Returns ONLY the cards markup — no header, no hero,
  no styling shell.

  IMPORTANT: Shopify strips custom query params before they reach
  `request.query` for sections rendered via the Sections API. However,
  `canonical_url` preserves whitelisted params (page, limit, sort_by).
  We parse those out of `canonical_url` manually.

  URL params consumed (all via canonical_url parsing):
    page=N   — which page to render (1-based)
    limit=N  — products per page

  This helper is ONLY called for page 2+ requests by cg-main.liquid,
  so `skip` is always 0 — no need to pass it.
{% endcomment %}

{%- liquid
  assign url_query_string = canonical_url | split: '?' | last
  assign url_parts = url_query_string | split: '&'

  assign current_page = 1
  assign per_page     = 8

  for part in url_parts
    assign kv = part | split: '='
    if kv[0] == 'page'
      assign current_page = kv[1] | plus: 0
    elsif kv[0] == 'limit'
      assign per_page = kv[1] | plus: 0
    endif
  endfor

  if current_page < 1
    assign current_page = 1
  endif
  if per_page < 1
    assign per_page = 8
  endif

  assign total_products = collection.products_count | plus: 0
  assign total_pages    = total_products | divided_by: per_page | ceil
  assign offset_start   = current_page | minus: 1 | times: per_page
-%}

<div class="cg-ajax-products" data-current-page="{{ current_page }}" data-total-pages="{{ total_pages }}">
  {% assign rendered = 0 %}
  {% assign passed   = 0 %}
  {% for product in collection.products limit: 250 %}
    {% if passed < offset_start %}
      {% assign passed = passed | plus: 1 %}
      {% continue %}
    {% endif %}
    {% if rendered >= per_page %}
      {% break %}
    {% endif %}

    <div class="cg-col">
      {% render 'product-card',
        product: product,
        image_ratio: image_ratio,
        show_vendor: false,
        section_index: section.index,
        enable_swatches: true,
        index: forloop.index
      %}
    </div>

    {% assign rendered = rendered | plus: 1 %}
  {% endfor %}
</div>

<script type="application/json" data-cg-meta>
  {
    "current_page": {{ current_page }},
    "total_pages":  {{ total_pages }},
    "items":        {{ total_products }}
  }
</script>

{% schema %}
{
  "name": "Products (AJAX)",
  "settings": []
}
{% endschema %}
