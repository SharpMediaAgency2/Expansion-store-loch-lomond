      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Button 1"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Label",
          "default": "Explore Collection"
        },
        {
          "type": "url",
          "id": "button_1_url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "label": "Style",
          "options": [
            { "value": "solid",      "label": "Solid white" },
