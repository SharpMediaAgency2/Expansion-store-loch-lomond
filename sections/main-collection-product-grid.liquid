    },
    {
      "type": "checkbox",
      "id": "hide-logo-overlay",
      "default": false,
      "label": "Hide Overlay Logos?"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "paginate_type",
