{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }

  .fd-its2-{{ section.id }} {
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }

  /* ── Page container ── */
  .fd-its2-{{ section.id }} .fd-its2__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 60px);
    display: flex;
    align-items: center;
    gap: 40px;
  }

  /* ── Image position: text left, image right (default) ── */
  .fd-its2-{{ section.id }} .fd-its2__container--text-first {
    flex-direction: row;
  }

  /* ── Image position: image left, text right ── */
  .fd-its2-{{ section.id }} .fd-its2__container--image-first {
    flex-direction: row-reverse;
  }

  /* ── Image column ── */
  .fd-its2-{{ section.id }} .fd-its2__image-col {
    flex: 0 0 55%;
    max-width: 55%;
  }

  .fd-its2-{{ section.id }} .fd-its2__image-wrap {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
  }

  .fd-its2-{{ section.id }} .fd-its2__image-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  .fd-its2-{{ section.id }} .fd-its2__image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #d4d4d4;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Text column ── */
  .fd-its2-{{ section.id }} .fd-its2__text-col {
    flex: 0 0 45%;
    max-width: 45%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  /* ── Heading ── */
  .fd-its2-{{ section.id }} .fd-its2__heading {
    font-family: 'Noto Serif', serif;
    font-weight: 400;
    font-size: 36px;
    line-height: 40px;
    letter-spacing: 0px;
    margin: 0;
    color: currentColor;
  }

  /* ── Body text ── */
  .fd-its2-{{ section.id }} .fd-its2__description {
    font-family: 'Rubik', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: -0.44px;
    color: currentColor;
    margin: 0;
  }

  .fd-its2-{{ section.id }} .fd-its2__description p {
    margin: 0 0 16px;
  }

  .fd-its2-{{ section.id }} .fd-its2__description p:last-child {
    margin-bottom: 0;
  }

  /* ── Text link button ── */
  .fd-its2-{{ section.id }} .fd-its2__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'Rubik', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.15px;
    color: currentColor;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity 0.2s;
    margin-top: 4px;
  }

  .fd-its2-{{ section.id }} .fd-its2__link:hover {
    opacity: 0.7;
  }

  .fd-its2-{{ section.id }} .fd-its2__link svg {
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .fd-its2-{{ section.id }} .fd-its2__link:hover svg {
    transform: translateX(3px);
  }

  /* ── Mobile: always image first, then text ── */
  @media screen and (max-width: 749px) {
    .fd-its2-{{ section.id }} .fd-its2__container,
    .fd-its2-{{ section.id }} .fd-its2__container--text-first,
    .fd-its2-{{ section.id }} .fd-its2__container--image-first {
      flex-direction: column;
      gap: 24px;
      padding: 0 16px;
    }

    .fd-its2-{{ section.id }} .fd-its2__image-col {
      flex: 0 0 100%;
      max-width: 100%;
      order: 1;
    }

    .fd-its2-{{ section.id }} .fd-its2__text-col {
      flex: 0 0 100%;
      max-width: 100%;
      order: 2;
    }

    .fd-its2-{{ section.id }} .fd-its2__image-wrap {
      border-radius: 12px;
    }

    .fd-its2-{{ section.id }} .fd-its2__heading {
      font-size: 30px;
      line-height: 36px;
    }
  }
{%- endstyle -%}

{%- assign layout_class = 'fd-its2__container--text-first' -%}
{%- if section.settings.image_position == 'image_first' -%}
  {%- assign layout_class = 'fd-its2__container--image-first' -%}
{%- endif -%}

<div class="fd-its2-{{ section.id }}">
  <div class="fd-its2__container {{ layout_class }}">

    {%- comment -%} Text column {%- endcomment -%}
    <div class="fd-its2__text-col">
      {%- if section.settings.heading != blank -%}
        <h2 class="fd-its2__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="fd-its2__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_url | default: '#' }}"
          class="fd-its2__link"
          {% if section.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          {{ section.settings.button_label }}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M2.5 7H11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M7.5 3L11.5 7L7.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Image column {%- endcomment -%}
    <div class="fd-its2__image-col">
      <div class="fd-its2__image-wrap">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000',
              sizes: '(max-width: 749px) 100vw, 55vw',
              alt: section.settings.heading | escape
          }}
        {%- else -%}
          <div class="fd-its2__image-placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "F&D Image + Text Split",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        {
          "value": "text_first",
          "label": "Text left, image right"
        },
        {
          "value": "image_first",
          "label": "Image left, text right"
        }
      ],
      "default": "text_first"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for Golf's Finest"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Fescue & Dunes partners exclusively with the world's most prestigious golf clubs to create premium apparel that embodies the spirit of each course.</p><p>From the windswept links of Scotland to tropical resort paradises, each piece is carefully curated and features custom embroidery celebrating the club's heritage.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Learn Our Story"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "F&D Image + Text Split",
      "settings": {
        "heading": "Crafted for Golf's Finest",
        "button_label": "Learn Our Story"
      }
    }
  ]
}
{% endschema %}
