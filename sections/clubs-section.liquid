{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class
  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign excluded_handles = ''
  for block in section.blocks
    if block.type == 'exclude_course'
      assign mo = block.settings.course
      unless mo == blank
        if excluded_handles == ''
          assign excluded_handles = mo
        else
          assign excluded_handles = excluded_handles | append: ',' | append: mo
        endif
      endunless
    endif
  endfor

  assign newly_added_refs = ''
  for block in section.blocks
    if block.type == 'newly_added_course'
      assign mo_ref = block.settings.course_ref
      unless mo_ref == blank
        if newly_added_refs == ''
          assign newly_added_refs = mo_ref
        else
          assign newly_added_refs = newly_added_refs | append: '||' | append: mo_ref
        endif
      endunless
    endif
  endfor
-%}

<style>
