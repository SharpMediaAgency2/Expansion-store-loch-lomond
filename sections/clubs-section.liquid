  #{{ section_id }} .cd-list-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* List card heart — same class, adjusted position */
  #{{ section_id }} .cd-list-card .fc-card__heart {
    position: absolute;
    top: 20px;
    right: 0;
    border:none;
