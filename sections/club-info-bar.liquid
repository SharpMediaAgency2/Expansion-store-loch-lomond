<style>
  #{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid #E5E7EB;
  }

  #{{ section.id }} .club-info-bar__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  #{{ section.id }} .club-info-bar__text {
    flex: 1;
    font-family: 'Rubik', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 18px;
    line-height: 29.25px;
    letter-spacing: -0.44px;
    color: {{ section.settings.text_color }};
    max-width: 620px;
  }

  #{{ section.id }} .club-info-bar__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  #{{ section.id }} .club-info-bar__pill {
    display: inline-flex;
    align-items: center;
    background: #F3F4F6;
    border-radius: 9999px;
    padding: 4px 12px;
    font-family: 'Rubik', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.15px;
    color: #364153;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  #{{ section.id }} .club-info-bar__pill:hover {
    background: #E5E7EB;
    color: #111827;
  }

  @media (max-width: 767px) {
    #{{ section.id }} .club-info-bar__inner {
      flex-direction: column;
      gap: 20px;
    }

    #{{ section.id }} .club-info-bar__text {
      font-size: 16px;
      max-width: 100%;
    }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500&display=swap" rel="stylesheet">

<div id="{{ section.id }}" class="club-info-bar">
  <div class="container">
    <div class="club-info-bar__inner">

      {%- if section.settings.description != blank -%}
        <div class="club-info-bar__text">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- assign link_blocks = section.blocks | where: 'type', 'link_pill' -%}
      {%- if link_blocks.size > 0 -%}
        <div class="club-info-bar__links">
          {%- for block in link_blocks -%}
            {%- if block.settings.label != blank -%}
              <a
                class="club-info-bar__pill"
                {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label | escape }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Club Info Bar",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Text",
      "default": "<p>The Home of Golf. The Old Course at Royal St George's is the oldest golf course in the world and considered by many to be the most iconic.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1F2937"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "link_pill",
      "name": "Link Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bucket List"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Club Info Bar",
      "blocks": [
        {
          "type": "link_pill",
          "settings": {
            "label": "Bucket List"
          }
        },
        {
          "type": "link_pill",
          "settings": {
            "label": "Links"
          }
        },
        {
          "type": "link_pill",
          "settings": {
            "label": "The Royals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
