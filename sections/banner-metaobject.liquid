{{ 'hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image = metaobject.banner_image
  assign image_overlay_opacity = 30

  assign text_alignment = 'center'
  assign text_alignment_mobile = 'center'

  assign motion_delay = 0
  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = 'fade-in'
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if section.index < 2
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
-%}

{% if metaobject.banner_title.value != blank and metaobject.banner_image != blank %}
  <div
    class="f-hero f-hero--mobile block relative overflow-hidden color-inverse"
    data-section-id="banner-golf-club"
    data-section-type="hero-section"
  >
    {%- if image != blank -%}
      <motion-element
        data-motion="{% if section.settings.enable_bg_zoom_effect %}zoom-out-sm{% else %}none{% endif %}"
        class="block absolute w-full h-full"
      >
        <picture class="bg-image">
          {{
            image
            | image_url: width: 3000
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
              sizes: '100vw',
              alt: metaobject.banner_title.value
          }}
        </picture>
        {%- if image_overlay_opacity > 0 -%}
          <div
            class="bg-overlay"
            style="--color-overlay-alpha: {{ image_overlay_opacity }}"
          ></div>
        {%- endif -%}
      </motion-element>
    {%- endif -%}

    <div class="container">
      <div
        class="block f-hero__wrapper relative overflow-hidden"
      >
        <div class="f-hero__content-wrapper flex md:content-overlay--{{ text_alignment }}">
          <div
            class="f-hero__content f-text-blocks text-{{ text_alignment_mobile }} md:text-{{ text_alignment }}"
          >
            {%- if metaobject.banner_title.value != blank -%}
              <h4
                  class="f-hero_heading h2"
              >
                  <motion-element
                  data-motion="{{ animation_effect }}"
                  data-motion-delay="{{ motion_delay }}"
                  class="block"
                  >
                  {%- render 'highlight-text',
                    hl_text: metaobject.banner_title.value
                  -%}
                  </motion-element>
              </h4>
              {%- assign motion_delay = motion_delay | plus: 50 -%}
            {%- endif -%}

            {%- if metaobject.banner_content_text.value != blank -%}
              <motion-element
                data-motion="{{ animation_effect }}"
                data-motion-delay="{{ motion_delay }}"
                class="block f-hero_text rte mobile-remove-br"
              >
                <div class="f-hero__description--container">
                  <div class="f-hero__description rte">
                    {{ metaobject.banner_content_text | metafield_tag	 }}
                  </div>
                </div>
              </motion-element>
              {%- assign motion_delay = motion_delay | plus: 50 -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}