{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }

  .fd-its-{{ section.id }} {
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }

  /* ── Slide outer: hidden/shown, owns max-width + page padding ── */
  .fd-its-{{ section.id }} .fd-its__slide-outer {
    display: none;
  }

  .fd-its-{{ section.id }} .fd-its__slide-outer.is-active {
    display: block;
  }

  /* ── Page-width container ── */
  .fd-its-{{ section.id }} .fd-its__container {
    display: flex;
    align-items: center;
    gap: 0;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 60px);
  }

  /* ── Image column ── */
  .fd-its-{{ section.id }} .fd-its__image-col {
    flex: 0 0 50%;
    max-width: 50%;
  }

  .fd-its-{{ section.id }} .fd-its__image-wrap {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
  }

  .fd-its-{{ section.id }} .fd-its__image-wrap picture {
    display: block;
    width: 100%;
  }

  .fd-its-{{ section.id }} .fd-its__image-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  .fd-its-{{ section.id }} .fd-its__image-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #d4d4d4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Text column ── */
  .fd-its-{{ section.id }} .fd-its__text-col {
    flex: 1 1 0%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 0 clamp(16px, 3vw, 48px);
  }

  .fd-its-{{ section.id }} .fd-its__heading {
    font-family: 'Noto Serif', serif;
    font-weight: 400;
    font-size: 36px;
    line-height: 40px;
    letter-spacing: 0px;
    margin: 0;
    color: currentColor;
  }

  .fd-its-{{ section.id }} .fd-its__description {
    font-family: 'Rubik', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: -0.44px;
    margin: 0;
    color: currentColor;
  }

  .fd-its-{{ section.id }} .fd-its__description p {
    margin: 0;
  }

  /* ── CTA Button ── */
  .fd-its-{{ section.id }} .fd-its__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 200px;
    height: 46px;
    padding: 8px 24px;
    gap: 10px;
    border-radius: 12px;
    background: #222F1D;
    color: #ffffff;
    font-family: 'Rubik', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.15px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .fd-its-{{ section.id }} .fd-its__btn:hover {
    opacity: 0.85;
  }

  /* ── Nav arrows ── */
  .fd-its-{{ section.id }} .fd-its__nav {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #222F1D;
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
    padding: 0;
  }

  .fd-its__nav.fd-its__nav--prev {
    position: absolute;
  }

  .fd-its-{{ section.id }} .fd-its__nav:hover {
    opacity: 0.8;
  }

  /* Prev arrow sits before image col */
  .fd-its-{{ section.id }} .fd-its__nav--prev {
    order: -1;
  }

  /* Disabled state — hide arrow */
  .fd-its-{{ section.id }} .fd-its__nav:disabled {
    display: none;
  }

  /* ── Dots ── */
  .fd-its-{{ section.id }} .fd-its__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }

  .fd-its-{{ section.id }} .fd-its__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d4d4d4;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .fd-its-{{ section.id }} .fd-its__dot.is-active {
    background: #222F1D;
    transform: scale(1.15);
  }

  /* Hide nav + dots if only 1 slide */
  .fd-its-{{ section.id }}[data-single="true"] .fd-its__nav,
  .fd-its-{{ section.id }}[data-single="true"] .fd-its__dots {
    display: none;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .fd-its-{{ section.id }} .fd-its__container {
      flex-direction: column;
      gap: 24px;
      padding: 0 16px;
    }

    .fd-its-{{ section.id }} .fd-its__image-col {
      flex: 0 0 100%;
      max-width: 100%;
      order: 1;
    }

    .fd-its-{{ section.id }} .fd-its__text-col {
      flex: 0 0 100%;
      max-width: 100%;
      padding: 0;
      order: 2;
    }

    .fd-its-{{ section.id }} .fd-its__image-wrap {
      border-radius: 12px;
    }

    .fd-its-{{ section.id }} .fd-its__btn {
      width: 100%;
      min-width: unset;
    }

    .fd-its-{{ section.id }} .fd-its__nav {
      display: none;
    }

    .fd-its-{{ section.id }} .fd-its__dots {
      margin-top: 20px;
    }
  }
{%- endstyle -%}

<div
  class="fd-its-{{ section.id }}"
  id="fd-its-{{ section.id }}"
  data-single="{% if section.blocks.size == 1 %}true{% else %}false{% endif %}"
>

  {%- for block in section.blocks -%}
    <div
      class="fd-its__slide-outer{% if forloop.first %} is-active{% endif %}"
      data-slide-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}
    >
      <div class="fd-its__container">

        {%- comment -%} Prev arrow — left of image {%- endcomment -%}
        {%- if section.blocks.size > 1 -%}
          <button class="fd-its__nav fd-its__nav--prev" data-dir="prev" aria-label="Previous slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none" style="transform: scaleX(-1);" aria-hidden="true">
              <path d="M0.75 0.750001L5.75 5.75L0.75 10.75" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}

        {%- comment -%} Image {%- endcomment -%}
        <div class="fd-its__image-col">
          <div class="fd-its__image-wrap">
            {%- if block.settings.image != blank or block.settings.image_mobile != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ block.settings.image_mobile | image_url: width: 400 }} 400w,
                      {{ block.settings.image_mobile | image_url: width: 750 }} 750w
                    "
                    sizes="100vw"
                  >
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 900',
                      sizes: '(max-width: 749px) 100vw, 50vw',
                      alt: block.settings.heading | escape
                  }}
                {%- else -%}
                  {{
                    block.settings.image_mobile
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 900',
                      sizes: '100vw',
                      alt: block.settings.heading | escape
                  }}
                {%- endif -%}
              </picture>
            {%- else -%}
              <div class="fd-its__image-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} Text {%- endcomment -%}
        <div class="fd-its__text-col">
          {%- if block.settings.heading != blank -%}
            <h2 class="fd-its__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <div class="fd-its__description">{{ block.settings.description }}</div>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a
              href="{{ block.settings.button_url | default: '#' }}"
              class="fd-its__btn"
              {% if block.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} Next arrow — right of text {%- endcomment -%}
        {%- if section.blocks.size > 1 -%}
          <button class="fd-its__nav fd-its__nav--next" data-dir="next" aria-label="Next slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none" aria-hidden="true">
              <path d="M0.75 0.750001L5.75 5.75L0.75 10.75" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}

      </div>
    </div>
  {%- endfor -%}

  {%- comment -%} Dots {%- endcomment -%}
  {%- if section.blocks.size > 1 -%}
    <div class="fd-its__dots">
      {%- for block in section.blocks -%}
        <button
          class="fd-its__dot{% if forloop.first %} is-active{% endif %}"
          data-dot-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

<script>
(function () {
  var root = document.getElementById('fd-its-{{ section.id }}');
  if (!root) return;

  var outers  = Array.from(root.querySelectorAll('.fd-its__slide-outer'));
  var dots    = Array.from(root.querySelectorAll('.fd-its__dot'));
  var current = 0;

  if (outers.length <= 1) return;

  var prevBtns = Array.from(root.querySelectorAll('.fd-its__nav--prev'));
  var nextBtns = Array.from(root.querySelectorAll('.fd-its__nav--next'));

  function updateNavState() {
    var atStart = current === 0;
    var atEnd   = current === outers.length - 1;
    prevBtns.forEach(function (btn) { btn.disabled = atStart; });
    nextBtns.forEach(function (btn) { btn.disabled = atEnd; });
  }

  function goTo(index) {
    if (index < 0 || index >= outers.length) return;
    outers[current].classList.remove('is-active');
    dots[current].classList.remove('is-active');
    current = index;
    outers[current].classList.add('is-active');
    dots[current].classList.add('is-active');
    updateNavState();
  }

  root.addEventListener('click', function (e) {
    var btn = e.target.closest('.fd-its__nav');
    if (!btn || btn.disabled) return;
    if (btn.dataset.dir === 'prev') {
      goTo(current - 1);
    } else {
      goTo(current + 1);
    }
  });

  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      goTo(parseInt(dot.getAttribute('data-dot-index')));
    });
  });

  // Set initial state
  updateNavState();
})();
</script>

{% schema %}
{
  "name": "F&D Image + Text Slider",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (mobile)",
          "info": "Optional. If set, shown on screens ≤749px. Uses the image's natural ratio."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New Arrivals"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Discover our latest golf apparel and accessories, ready for premium embroidery.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore New Arrivals"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "checkbox",
          "id": "button_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "F&D Image + Text Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "New Arrivals",
            "button_label": "Explore New Arrivals"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Best Sellers",
            "button_label": "Shop Best Sellers"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "F&D Favorites",
            "button_label": "Shop F&D Favorites"
          }
        }
      ]
    }
  ]
}
{% endschema %}
